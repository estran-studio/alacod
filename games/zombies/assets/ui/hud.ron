(
    // T2.12 : police de tous les textes du HUD (la police par défaut n'a pas d'accents).
    font: Some("fonts/FiraMono-Medium.ttf"),
    widgets: [
        // Health bar - bottom left, 200x12 pixels
        (
            kind: Bar(source: "health"),
            anchor: BottomLeft,
            offset: (16.0, 16.0),
            size: Some((200.0, 12.0)),
            color: Some("#c0392b"),
            font_size: None,
        ),
        // Wave number - top center
        (
            kind: Text(source: "wave", prefix: Some("Vague ")),
            anchor: TopCenter,
            offset: (0.0, 12.0),
            size: None,
            color: Some("#ffffff"),
            font_size: Some(20.0),
        ),
        // Ammo count - bottom right
        (
            kind: Text(source: "ammo", prefix: None),
            anchor: BottomRight,
            offset: (16.0, 16.0),
            size: None,
            color: Some("#ffffff"),
            font_size: Some(18.0),
        ),
        // Weapon name - bottom right, below ammo
        (
            kind: Text(source: "weapon", prefix: None),
            anchor: BottomRight,
            offset: (16.0, 40.0),
            size: None,
            color: Some("#ffaa00"),
            font_size: Some(14.0),
        ),
        // Enemy count - top right
        (
            kind: Text(source: "enemies", prefix: Some("Ennemis ")),
            anchor: TopRight,
            offset: (16.0, 12.0),
            size: None,
            color: Some("#ffffff"),
            font_size: Some(14.0),
        ),
        // Player count - top left
        (
            kind: Text(source: "players", prefix: Some("Joueurs ")),
            anchor: TopLeft,
            offset: (16.0, 12.0),
            size: None,
            color: Some("#ffffff"),
            font_size: Some(14.0),
        ),
        // Health text - bottom left, above the bar
        (
            kind: Text(source: "health", prefix: None),
            anchor: BottomLeft,
            offset: (16.0, 30.0),
            size: None,
            color: Some("#ffffff"),
            font_size: Some(12.0),
        ),
        // Monnaie (T2.3, chantier C5 v1) - top center, sous la vague
        (
            kind: Text(source: "currency", prefix: Some("$")),
            anchor: TopCenter,
            offset: (0.0, 36.0),
            size: None,
            color: Some("#f1c40f"),
            font_size: Some(16.0),
        ),
        // T2.12 : perks possédés, une icône par perk (voir `icons` plus bas), en bas à
        // gauche au-dessus de la vie. `size.1` = côté d'une icône.
        (
            kind: Icons(source: "perks"),
            anchor: BottomLeft,
            offset: (16.0, 80.0),
            size: Some((200.0, 24.0)),
            color: None,
            font_size: None,
        ),
        // T2.12 : « À TERRE 12 s » / « Réanimation 40 % », au centre de l'écran.
        (
            kind: Text(source: "downed", prefix: None),
            anchor: Center,
            offset: (0.0, -150.0),
            size: Some((360.0, 70.0)),
            color: Some("#e74c3c"),
            font_size: Some(28.0),
            background: Some("#000000a0"),
        ),
        // T2.12 : power-ups actifs, une ligne par power-up, en haut à droite sous les ennemis.
        (
            kind: Text(source: "powerups", prefix: None),
            anchor: TopRight,
            offset: (16.0, 34.0),
            size: Some((220.0, 80.0)),
            color: Some("#2ecc71"),
            font_size: Some(16.0),
            background: Some("#000000a0"),
        ),
        // S1-8 : légende des silhouettes et couleurs (F7), fermée par défaut.
        (
            kind: Legend(source: "legend"),
            anchor: TopCenter,
            offset: (0.0, 110.0),
            size: Some((760.0, 0.0)),
            color: None,
            font_size: Some(11.0),
            background: Some("#05080df4"),
        ),
        // T2.12 : prompt d'interaction (« Acheter … — $500 »), en bas au centre.
        (
            kind: Text(source: "prompt", prefix: Some("[H] ")),
            anchor: BottomCenter,
            offset: (0.0, 110.0),
            size: Some((480.0, 24.0)),
            color: Some("#f1c40f"),
            font_size: Some(18.0),
            background: Some("#000000a0"),
        ),
    ],
    // S1-8 (lisibilité coop, même langage que gungeon, `docs/conventions.md` §83) : couleur par handle de joueur
    // (bleu, vert, jaune, violet) appliquée à leurs calques ; repères d'apparition de la carte cachés (tuiles
    // d'éditeur) ; légende (F7) ; noms des étiquettes (F6).
    player_colors: ["#4aa3ff", "#4cd964", "#ffd60a", "#b266ff"],
    hide_markers: true,
    // T2.12 : icônes des perks (`economy/perks.ron`) : carré de couleur + étiquette.
    icons: {
        "juggernog": (color: "#c0392b", label: "J"),
        "speed_cola": (color: "#27ae60", label: "S"),
        "double_tap": (color: "#e67e22", label: "D"),
        "stamin_up": (color: "#f1c40f", label: "T"),
    },
    // T2.12 : noms affichés des armes (`weapons.ron`) dans le prompt ; S1-8 : noms des étiquettes (F6) des joueurs,
    // des zombies et des ramassables.
    names: {
        "pistol": "pistolet",
        "machine_gun": "mitrailleuse",
        "shotgun": "fusil à pompe",
        "rifle": "fusil",
        "player": "J",
        "zombie_1": "Zombie",
        "zombie_2": "Zombie coriace",
        "zombie_full": "Zombie brute",
        "boss_zombie": "BOSS",
    },
    // S1-8 : légende (F7), lignes du jeu seulement (les ids de `sprites.ron` ; sans la surcharge locale, les sprites
    // publics). Les couleurs des joueurs sont celles de `player_colors`.
    legend: [
        (title: "Joueurs (couleur = numéro)", column: 0, entries: [
            (label: "Joueur 1", sprite: Some("player"), tint: Some("#4aa3ff")),
            (label: "Joueur 2", sprite: Some("player"), tint: Some("#4cd964")),
            (label: "Joueur 3", sprite: Some("player"), tint: Some("#ffd60a")),
            (label: "Joueur 4", sprite: Some("player"), tint: Some("#b266ff")),
        ]),
        (title: "Zombies", column: 1, entries: [
            (label: "Zombie : fonce sur le plus proche", sprite: Some("zombie_1")),
            (label: "Zombie coriace", sprite: Some("zombie_2")),
            (label: "Zombie brute", sprite: Some("zombie_full")),
            (label: "BOSS (salle finale)", sprite: Some("boss_zombie")),
        ]),
        (title: "Ramassables (halo qui pulse)", column: 2, entries: [
            (label: "Arme au mur ou au sol : halo orange", sprite: Some("halo"), tint: Some("#ff9933")),
            (label: "Power-up (30 s au sol) : halo vert", sprite: Some("halo"), tint: Some("#4dff8c")),
        ]),
    ],
)
