// Sections dessinées dans LDtk ; mêmes prises et placement que l'assembleur originel.
// Waves reste le mode de jeu : aucune transition d'étage, finale à la mort du boss.
// `loops: 2` : deux ailes qui se rejoignent au moins deux fois (raccourcis CoD) ; avec 9 salles
// au plus, la bibliothèque n'en permet pas deux sur la plupart des graines, d'où 10 à 12.
(
    templates: "maps/la_fonderie.ldtk",
    grammar: (
        rooms: (10, 12),
        required: {"arene": 1, "armurerie": 1, "infirmerie": 1, "boss": 1},
        start: "depart",
        filler: "atelier",
        min_boss_distance: 4,
        max_attempts: 256,
        loops: 2,
    ),
)
