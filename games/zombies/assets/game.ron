// Manifeste du jeu (T1.5, voir `docs/conventions.md` §3 et `crates/content/src/manifest.rs`).
// Reflète le contenu actuel de `games/zombies/assets/` : les personnages et la table
// d'armes vivent encore sous `ZombieShooter/Sprites/**` (dossier historique), déclarés
// fichier par fichier. D3 : les feuilles de sprite et configs d'animation n'y sont plus,
// elles sont rangées par entité sous `sprites/` et déclarées par la table `SpriteSheet`
// (`sprites/sprites.ron`). Les autres dossiers (`waves/`, `exemples/`, `ui/`) ne
// contiennent que le kind déclaré et sont scannés tels quels.
(
    name: "zombies",
    content_folders: [
        (path: "ZombieShooter/Sprites/Character/player_config.ron", kind: "Character"),
        (path: "ZombieShooter/Sprites/Zombie/zombie_config.ron", kind: "Character"),
        (path: "ZombieShooter/Sprites/Zombie/zombie_hard_config.ron", kind: "Character"),
        (path: "ZombieShooter/Sprites/Zombie/zombie_full_config.ron", kind: "Character"),
        // F5 (chantier m0-v11) : preuve « équilibrage par joueurs » (santé par expression,
        // voir `docs/conventions.md` §18).
        (path: "ZombieShooter/Sprites/Zombie/zombie_scaled_config.ron", kind: "Character"),
        (path: "ZombieShooter/Sprites/Zombie/boss_zombie_config.ron", kind: "Character"),
        (path: "ZombieShooter/Sprites/Character/weapons.ron", kind: "Weapon"),
        (path: "weapons/melee/melee_weapons.ron", kind: "MeleeWeapon"),
        (path: "waves", kind: "Wave"),
        (path: "exemples", kind: "Map"),
        // m0-v8 : cartes de la voie V6 (tâche m0-v8-carte-zombies), même kind que exemples/.
        (path: "maps", kind: "Map"),
        // Sections de La Fonderie : types de salles et assemblage avec finale garantie.
        (path: "floor_grammars", kind: "FloorGrammar"),
        (path: "rooms", kind: "Room"),
        (path: "ui", kind: "Ui"),
        // SB-1 : profils du bac à sable (`--sandbox`, `docs/conventions.md` §86) ; `arene` est le défaut.
        (path: "sandbox", kind: "Sandbox"),
        (path: "camera.ron", kind: "Camera"),
        // D3 : feuilles de sprites par id (personnages, armes, effet de mêlée).
        (path: "sprites/sprites.ron", kind: "SpriteSheet"),
        // T2.3, chantier C5 v1 : deux fichiers de kinds différents dans le même dossier
        // (comme les personnages sous ZombieShooter/Sprites/**, voir le commentaire
        // d'en-tête) : déclarés individuellement plutôt que le dossier `economy` entier.
        (path: "economy/economy.ron", kind: "Economy"),
        (path: "economy/perks.ron", kind: "Perk"),
        // T2.5, chantier C1 v0 : table des power-ups.
        (path: "items", kind: "PowerUp"),
    ],
    entry: (
        // Sections LDtk assemblées par leurs prises : cour, ateliers, ravitaillement, finale.
        start_map: "floor:la_fonderie",
        default_seed: 123456,
        map: (
            max_rooms: 10,
            max_width: 1000,
            max_height: 1000,
            aligned_openings: true,
            close_loops: true,
            wall_unused_openings: true,
        ),
        mode: Waves,
    ),
    // SB-1 (D2) : l'arène du bac à sable (`--sandbox`) : une salle vide (murs et points de départ, rien d'autre),
    // écrite par `alacod new-arena` (`docs/conventions.md` §89) ; un profil la remplace par son champ `map`.
    sandbox: (arena: "maps/arene_vide.ldtk"),
)
