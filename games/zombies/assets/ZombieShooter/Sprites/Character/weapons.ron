({
    "pistol": (
        config: (
            name: "pistol",
            default_firing_mode: "default",
            // T2.2, chantier B7 : type de munition (BTreeMap<AmmoType, u32> de
            // `combat::inventory::AmmoReserves`). Distinct de `machine_gun`/`shotgun` : pas
            // de réserve partagée dans le contenu `zombies` d'aujourd'hui (voir
            // `tests/scenarios/ammo_shared_reserve.ron` pour un scénario qui les force à
            // partager, via `weapon_overrides`).
            ammo_type: Plomb,
            firing_modes: {
                "default": (
                    firing_rate: "2.0",
                    firing_mode: Manual(),
                    spread:  "0.0005",
                    recoil: "3.0",
                    bullet_type: Standard(
                        damage: "15.0",
                        speed: "400.0",
                    ),
                    range: "700.0",
                    reload_time_seconds: "1.0",
                    mag: Mag(
                        mag_size: 6,
                        mag_limit: 8,
                    )
                )
            },
            // Scénario généré (T2.10, `alacod-gen`) : joueur équipé du pistolet seul, vise
            // et tire (par pulsations, mode Manual : `crates/scenario/src/generate.rs::fire_pulses`)
            // sur `target` de la frame 10 à 600. `min_hits` observé avec `alacod-gen --play`
            // (4 sur cette durée : cadence lente et dispersion large du tir, voir le rapport
            // de la tâche), gardé prudent (marge sous l'observé).
            test: Some((frames: 600, min_hits: 2, max_hits: Some(20))),
        ),
        sprite_config: (
            name: "pistol",
            index: 3,
            bullet_offset_right: ( x: "-5.0", y: "2.0" ),
            bullet_offset_left: ( x: "0.0", y: "-2.0" ),
            weapon_offset: ( x: "0.0", y: "-5.0" )
        ),
        audio_config: (
            modes: {
                "default": (
                    reloading: "sounds/machine-gun-reload.ogg",
                    firing: "sounds/machine-gun.ogg"
                )
            }
        )
    ),
    "machine_gun": (
        config: (
            name: "machine_gun",
            default_firing_mode: "default",
            // T2.2, chantier B7 : voir le commentaire de `pistol` ci-dessus.
            ammo_type: Balle,
            firing_modes: {
                "default": (
                    firing_rate: "10.0",
                    firing_mode: Automatic(),
                    spread: "0.15",
                    recoil: "1.5",
                    bullet_type: Standard(
                        damage: "8.0",
                        speed: "300.0",
                    ),
                    range: "900.0",
                    reload_time_seconds: "1.5",
                    mag: Mag(
                        mag_size: 30,
                        mag_limit: 8,
                    )
                ),
                "rafale": (
                    firing_rate: "10.0",
                    firing_mode: Burst(pellets_per_shot: 3, cooldown_frames: 1),
                    spread: "1",
                    recoil: "1.5",
                    bullet_type: Standard(
                        damage: "8.0",
                        speed: "400.0",
                    ),
                    range: "900.0",
                    reload_time_seconds: "0.7",
                    mag: Mag(
                        mag_size: 30,
                        mag_limit: 8,
                    )
                )
            },
            // Voir le commentaire `test:` de `pistol` ci-dessus (même gabarit).
            test: Some((frames: 600, min_hits: 10, max_hits: Some(60))),
        ),
        sprite_config: (
            name: "machine_gun",
            index: 1,
            bullet_offset_right: ( x: "12.0", y: "0.0" ),
            bullet_offset_left: ( x: "12.0", y: "-0.0" ),
            weapon_offset: ( x: "0.0", y: "-5.0" )
        ),
        audio_config: (
            modes: {
                "default": (
                    reloading: "sounds/machine-gun-reload.ogg",
                    firing: "sounds/machine-gun.ogg"
                )
            }
        )
    ),
    "shotgun": (
        config: (
            name: "shotgun",
            default_firing_mode: "default",
            // T2.2, chantier B7 : voir le commentaire de `pistol` ci-dessus. Sans effet sur
            // la réserve (armes `Magless` : pas de chargeur séparé, voir la doc de
            // `game::weapons::WeaponModeState::can_reload`), gardé pour la cohérence du
            // contenu et un futur fusil à pompe `Mag`.
            ammo_type: Cartouche,
            firing_modes: {
                "default": (
                    firing_rate: "1.0",
                    firing_mode: Shotgun(
                        pellet_count: 8,
                        spread_angle: "0.4" // Wide spread
                    ), 
                    spread: "0.0",
                    recoil: "8.0",
                    mag_size: 5000,
                    bullet_type: Standard(
                        damage: "30.0",
                        speed: "200.0",
                    ),
                    range: "400.0",
                    reload_time_seconds: "0.8",
                    mag: Magless(
                        bullet_limit: 64,
                    )
                ),
                "piercing": (
                    firing_rate: "1.0",
                    firing_mode: Shotgun(
                        pellet_count: 8,
                        spread_angle: "0.4" // Wide spread
                    ), 
                    spread: "0.0",
                    recoil: "8.0",
                    mag_size: 5000,
                    bullet_type: Piercing(
                        damage: "10.0",
                        speed: "700.0",
                        penetration: 1,
                    ),
                    range: "400.0",
                    reload_time_seconds: "3.0",
                    mag: Magless(
                        bullet_limit: 64,
                    )
                )
            },
            // Voir le commentaire `test:` de `pistol` ci-dessus (même gabarit). Cadence
            // basse (1 tir/s) : `min_hits` compte les pastilles qui touchent (8 par tir),
            // pas les tirs.
            test: Some((frames: 600, min_hits: 25, max_hits: Some(120))),
        ),
        sprite_config: (
            name: "shotgun",
            index: 0,
            bullet_offset_right: ( x: "10.0", y: "-0" ),
            bullet_offset_left: ( x: "10.0", y: "0" ),
            weapon_offset: ( x: "0.0", y: "-5." )
        ),
        audio_config: (
            modes: {
                "default": (
                    reloading: "sounds/machine-gun-reload.ogg",
                    firing: "sounds/machine-gun.ogg"
                )
            }
        )
    ),
    "rifle": (
        config: (
            name: "rifle",
            default_firing_mode: "default",
            // T2.6 : fusil semi-automatique, quatrième arme murale de `test_map.ldtk` (1 200
            // points, salle du milieu) et seule arme murale que le joueur ne possède pas au
            // départ (`player_config.ron`, `starting_weapons`). Même munition que
            // `machine_gun` (`Balle`) : première réserve partagée du contenu `zombies`
            // (T2.2, `combat::inventory::AmmoReserves`) — un joueur qui possède les deux
            // puise dans la même réserve, comme deux armes de même calibre.
            ammo_type: Balle,
            firing_modes: {
                "default": (
                    firing_rate: "4.0",
                    firing_mode: Manual(),
                    spread: "0.01",
                    recoil: "4.0",
                    bullet_type: Standard(
                        damage: "35.0",
                        speed: "600.0",
                    ),
                    range: "1000.0",
                    reload_time_seconds: "1.2",
                    mag: Mag(
                        mag_size: 10,
                        mag_limit: 6,
                    )
                )
            },
            // Voir le commentaire `test:` de `pistol` ci-dessus (même gabarit) : 8 coups
            // observés sur 600 frames (tir semi-automatique par pulsations, dispersion
            // faible), bornes prudentes en dessous et bien au-dessus.
            test: Some((frames: 600, min_hits: 4, max_hits: Some(40))),
        ),
        // Pas de sprite propre (`sprites/weapons/Weapons.png` n’a que trois armes, voir
        // docs/plan-engine.md §5 A5) : réutilise celui du fusil à pompe.
        sprite_config: (
            name: "shotgun",
            index: 0,
            bullet_offset_right: ( x: "10.0", y: "0.0" ),
            bullet_offset_left: ( x: "10.0", y: "0.0" ),
            weapon_offset: ( x: "0.0", y: "-5.0" )
        ),
        audio_config: (
            modes: {
                "default": (
                    reloading: "sounds/machine-gun-reload.ogg",
                    firing: "sounds/machine-gun.ogg"
                )
            }
        )
    ),
})
