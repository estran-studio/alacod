// M2-T4 : synergie d'essai (`synergy_pair`) : la lame et le manche ensemble donnent +2 de dégâts
// (modificateur `synergy:lame_manche`) et +4 au ramassage de l'un d'eux (effet
// `synergy:lame_manche:0`, actif dès que la paire est tenue : le ramassage qui la complète compte).
(
    name: "Lame emmanchée",
    requires: ["lame", "manche"],
    modifiers: [(stat: Damage, op: Add, value: "2")],
    effects: [
        (on: OnPickup, do: [Modifier(stat: Damage, op: Add, value: "4")]),
    ],
)
