// Manifeste du jeu (T1.5, voir `docs/conventions.md` §3 et `crates/content/src/manifest.rs`).
// Le testbed n'a besoin que du personnage joueur, des armes et d'une salle vide : pas de
// zombies ni de vagues (voir `docs/taches.md` T1.5 et le rapport de la tâche — les copies
// `ZombieShooter/Sprites/Zombie/**` et `waves/` ont été retirées de ce dossier).
(
    name: "testbed",
    content_folders: [
        (path: "ZombieShooter/Sprites/Character/player_config.ron", kind: "Character"),
        (path: "ZombieShooter/Sprites/Character/weapons.ron", kind: "Weapon"),
        (path: "weapons/melee/melee_weapons.ron", kind: "MeleeWeapon"),
        (path: "testbed", kind: "Map"),
        (path: "ui", kind: "Ui"),
        (path: "camera.ron", kind: "Camera"),
    ],
    entry: (
        start_map: "testbed/testbed_empty.ldtk",
        default_seed: 123456,
    ),
)
