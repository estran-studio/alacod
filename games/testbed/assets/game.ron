// Manifeste du jeu (T1.5, voir `docs/conventions.md` §3 et `crates/content/src/manifest.rs`).
// Le testbed n'a besoin que du personnage joueur, des armes et de salles minimales : pas de
// vagues (voir `docs/taches.md` T1.5 et le rapport de la tâche — les copies
// `ZombieShooter/Sprites/Zombie/**` et `waves/` ont été retirées de ce dossier). T2.9 ajoute
// les personnages de laboratoire (`characters/`, spawnés par l'entité LDtk `CharacterSpawn`,
// pas par les vagues) et les salles du testbed (`arena`, `corridor`, `two_rooms_door`,
// `window`) ; `testbed_empty.ldtk` est devenu `arena.ldtk` (même contenu, quatre
// `PlayerSpawn`).
(
    name: "testbed",
    content_folders: [
        (path: "ZombieShooter/Sprites/Character/player_config.ron", kind: "Character"),
        (path: "characters", kind: "Character"),
        (path: "ZombieShooter/Sprites/Character/weapons.ron", kind: "Weapon"),
        // D26 (m1-d26-doublons-generes) : copie des armes de mêlée de `games/zombies` (mêmes
        // définitions hors `test:`), déjà couvertes par `generated/zombies/weapon_*` joués dans
        // l'arène du testbed : pas de scénario généré en double. Les armes à distance partagées
        // (`machine_gun`, `pistol`, `rifle`, `shotgun`) restent générées : elles vivent dans le
        // même `weapons.ron` que les armes propres au testbed (une seule table d'armes par jeu).
        (path: "weapons/melee/melee_weapons.ron", kind: "MeleeWeapon", generate: false),
        (path: "testbed", kind: "Map"),
        (path: "ui", kind: "Ui"),
        (path: "camera.ron", kind: "Camera"),
        // D3 : feuilles de sprites par id (joueur, armes, effet de mêlée ; les personnages
        // de laboratoire n'ont pas de sprite).
        (path: "sprites/sprites.ron", kind: "SpriteSheet"),
        // T2.3, chantier C5 v1 : economy.ron minimal (pas de perks.ron, le testbed n'en a
        // pas besoin aujourd'hui).
        (path: "economy/economy.ron", kind: "Economy"),
        // T2.5, chantier C1 v0 : table des power-ups (scénarios `powerup_*`).
        (path: "items", kind: "PowerUp"),
        // T1.8 : séquences de niveaux du mode `Floors` (scénario `portal_next_floor`,
        // `alacod-sim --floors`) ; le mode du testbed reste `Sandbox`, un scénario impose
        // une séquence par son champ `floors`.
        (path: "floors", kind: "Floors"),
        // T1.6 : cavernes générées (`cave:<nom>` comme carte, docs/conventions.md §21) ; le
        // dossier contient aussi le gabarit LDtk `gabarit.ldtk`.
        (path: "caves", kind: "Cave"),
        // M2-E1 : types de salles (champ de niveau LDtk `room_kind`, docs/conventions.md §35).
        (path: "rooms", kind: "Room"),
        // T1.7 : surfaces (couche IntGrid `Surfaces` des cartes, docs/conventions.md §26).
        (path: "surfaces", kind: "Surface"),
        // T1.2 : patterns nommés des émetteurs (tourelle `ring_8`, archer `volee`).
        (path: "patterns", kind: "Pattern"),
        // T1.10 : progression (rads, niveaux, mutations ; inactive par défaut, voir
        // `progression/`) et mutations.
        (path: "progression", kind: "Progression"),
        (path: "mutations", kind: "Mutation"),
        // T1.3 : statuts (posés par l'`on_hit` des armes `status_*`, docs/conventions.md §19).
        (path: "statuses", kind: "Status"),
        // T1.9 : horloges et difficulté, actives seulement si un scénario les demande
        // (`clocks`, `difficulty`) : le mode du testbed n'en active aucune.
        (path: "clocks", kind: "Clock"),
        (path: "difficulty.ron", kind: "Difficulty"),
    ],
    entry: (
        start_map: "testbed/arena.ldtk",
        default_seed: 123456,
        mode: Sandbox,
    ),
)
