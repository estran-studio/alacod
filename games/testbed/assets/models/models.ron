// R-1 (docs/conventions.md § 111) : ce qui bouge rendu en 3D « façon sprite ». Un personnage dont
// l'`asset_name_ref` a une entrée dans `models` est dessiné par son modèle animé (`anime.glb` +
// `anime.json`, format de l'étape `banc` de la pipeline d'assets) au lieu de sa planche.
// Le pantin est synthétique (`scripts/gen-pantin.py`) ; les valeurs du rendu sont celles du testbed.
(
    // 1 m = 28 unités : le pantin (1,8 m, vu à 45°) fait ~36 unités de haut, la taille des sprites du testbed.
    units_per_meter: 28.0,
    elevation_deg: 45.0,
    // Tri en y (le plus bas à l'écran devant) : coupé dans le testbed, dont les vidéos gardent l'ordre de dessin
    // historique (décision du 7 nov) ; un jeu qui l'allume trie personnages (modèles et sprites) et balles.
    y_sort: false,
    look: (
        shade: 0.6,
        highlight: 1.1,
        light: (-0.4, 0.8, 0.45),
        outline: 0.7,
        outline_px_per_m: 64.0,
        shadow: Some((direction: (-2.0, 8.0, 3.0), opacity: 0.5)),
    ),
    models: {
        "pantin": (
            glb: "models/pantin/anime.glb",
            manifest: "models/pantin/anime.json",
            frame_m: (2.8, 2.8),
            pivot: (0.5, 0.2),
            height_m: 1.8,
            poses: (
                idle: Some("idle"),
                walk: Some("walk"),
                melee: Some((still: Some("strike"), moving: Some("strike-walk"))),
            ),
            // M-6 (§ 116) : la fenêtre de frappe de l'arme de mêlée `frappe_modele` vient de `moments.frappe` du clip.
            melee_clips: {"frappe_modele": "strike"},
            weapons: {
                "pistol": (
                    object: Some("gun"),
                    muzzle: Some("muzzle"),
                    idle: Some("gun-idle"),
                    walk: Some("gun-walk"),
                    shoot: Some((still: Some("shoot"), moving: Some("shoot-walk"))),
                    shoulder: Some((still: Some("shoulder"))),
                    aim: Some((still: Some("aim"), moving: Some("aim-walk"))),
                    reload: Some((still: Some("reload"), moving: Some("reload-walk"))),
                ),
                // T-3b (§ 123) : l'arme à gestes (`arme_a_gestes`, épaulé de 9 frames) jouée par le pantin des tests
                // d'entrée réelle (`crates/scenario/tests/gestes_entree_reelle.rs`) : mêmes clips que le pistolet.
                "arme_a_gestes": (
                    object: Some("gun"),
                    muzzle: Some("muzzle"),
                    idle: Some("gun-idle"),
                    walk: Some("gun-walk"),
                    shoot: Some((still: Some("shoot"), moving: Some("shoot-walk"))),
                    shoulder: Some((still: Some("shoulder"))),
                    aim: Some((still: Some("aim"), moving: Some("aim-walk"))),
                    reload: Some((still: Some("reload"), moving: Some("reload-walk"))),
                ),
            },
            dash: ["roll"],
        ),
        // T-3b (§ 123) : le tireur posté `tireur_pantin` (`characters/tireur_pantin.ron`) dessiné par le même pantin. Les
        // poses de l'arme de sa règle `Shoot` (`fireball_gun`) passent par-dessus celles du modèle (P-1d, § 122) : épaulé =
        // attente avant le télégraphe, en joue = télégraphe, tir, rechargement = `cooldown_frames`, coup reçu = `hit`.
        "tireur_pantin": (
            glb: "models/pantin/anime.glb",
            manifest: "models/pantin/anime.json",
            frame_m: (2.8, 2.8),
            pivot: (0.5, 0.2),
            height_m: 1.8,
            poses: (
                idle: Some("idle"),
                walk: Some("walk"),
                hit: Some((still: Some("hit"))),
            ),
            weapons: {
                "fireball_gun": (
                    object: Some("gun"),
                    muzzle: Some("muzzle"),
                    idle: Some("gun-idle"),
                    walk: Some("gun-walk"),
                    shoot: Some((still: Some("shoot"))),
                    shoulder: Some((still: Some("shoulder"))),
                    aim: Some((still: Some("aim"))),
                    reload: Some((still: Some("reload"))),
                ),
            },
        ),
        // X-6e : le chef en deux phases (`characters/chef_pantin.ron`) dessiné par le même pantin.
        // - `order` : l'ordre à son escouade (règle `Command` retenue, télégraphe de l'ordre) : le geste `strike`, une fois,
        //   étiré sur le télégraphe.
        // - `transition` : le geste du changement de phase (`Phase::transition`, immobile) : le `roll`, une fois, étiré sur la durée.
        // - `weapons` : une arme par phase (`chef_cone` en phase 1, `chef_paire` en phase 2), mêmes poses de tir que le tireur.
        // - `pattern_clips` : la décharge du pattern `decharge` joue le clip `shoot` depuis la pose de l'émetteur ; les
        //   deux tirs partent aux `moments.shoot.departs` du manifeste (15 % et 85 % du clip).
        "chef_pantin": (
            glb: "models/pantin/anime.glb",
            manifest: "models/pantin/anime.json",
            frame_m: (2.8, 2.8),
            pivot: (0.5, 0.2),
            height_m: 1.8,
            poses: (
                idle: Some("idle"),
                walk: Some("walk"),
                hit: Some((still: Some("hit"))),
                order: Some((still: Some("strike"))),
                transition: Some((still: Some("roll"))),
                melee: Some((still: Some("strike"), moving: Some("strike-walk"))),
            ),
            melee_clips: {"frappe_modele": "strike"},
            weapons: {
                "chef_cone": (
                    object: Some("gun"),
                    muzzle: Some("muzzle"),
                    idle: Some("gun-idle"),
                    walk: Some("gun-walk"),
                    shoot: Some((still: Some("shoot"))),
                    shoulder: Some((still: Some("shoulder"))),
                    aim: Some((still: Some("aim"))),
                    reload: Some((still: Some("reload"))),
                ),
                "chef_paire": (
                    object: Some("gun"),
                    idle: Some("gun-idle"),
                    walk: Some("gun-walk"),
                    shoot: Some((still: Some("shoot"))),
                    shoulder: Some((still: Some("shoulder"))),
                    aim: Some((still: Some("aim"))),
                    reload: Some((still: Some("reload"))),
                ),
            },
            pattern_clips: {"decharge": "shoot"},
        ),
    },
)
