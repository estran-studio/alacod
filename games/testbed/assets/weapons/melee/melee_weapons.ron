                perfect_frames: 6,
                perfect_damage_mult: "2.0",
            )),
        ),
        sprite_config: (
            name: "sword",
            index: 0,
            weapon_offset: (x: "0.0", y: "0.0"),
        ),
    ),
    // X-3 (testbed) : comme `parade` mais la fenêtre parfaite ne dure que la frame du départ du
    // coup (`perfect_frames: 0`) : un projectile touché à la frame même où le coup est lancé est
