        config: (
            name: "Parade",
            damage: "5.0",
            range: "50.0",
            attack_pattern: Sweep(
                arc_angle: "1.57",
            ),
            attack_duration_frames: 12,
            cooldown_frames: 40,
            knockback_force: "20.0",
            stamina_cost: "15.0",
