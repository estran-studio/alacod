// Personnage de laboratoire T1.4 (testbed, conventions §22) : tireur qui garde ses
// distances — `Shoot` (volée `volee` de `fireball_gun`) quand il peut tirer, sinon
// `KeepDistance` (recule par le champ de flux inversé sous 120, jusqu'à 200), sinon `Chase`.
// Scénario `enemy_keep_distance` (carte `testbed/arena_ia_keep.ldtk`).
(
    movement: (
        acceleration: "120.0",
        max_speed: "60.0",
        friction: "10.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "kiter",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "200.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        behaviors: Some([
            Shoot(weapon: "fireball_gun", pattern: "volee", range: "240.0", cooldown_frames: 90),
            KeepDistance(min: "120.0", max: "200.0"),
            Chase(profile: "Ground"),
        ]),
    )),
    // T1.13 (`docs/conventions.md` §28) : scénarios générés `enemy_<id>_still`/`_moving`
    // (`make gen`). Immobile : `EnemyNeverInWall` borné à f540 — à f544, en reculant
    // (`KeepDistance`), le collider du kiter chevauche un mur de `arena.ldtk` (constaté au
    // calage, rapport m1-v3-generateur-v1).
    test: Some((
        frames: 600,
        expect_still: [
            Event(kind: "hit", label_contains: Some("joueur 0 touché"), by_frame: 600),
            EnemyNeverInWall(entity: Placed(0), from: 2, to: 540),
        ],
    )),
)
