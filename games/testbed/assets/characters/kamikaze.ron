// M3-T4 (docs/conventions.md §69) : mannequin immobile (50 PV) dont un effet `Tick(40)` (une seule charge) joue
// `Explode` (rayon 40, 30 dégâts, sans `destroys`) : prouve l'exécution de l'action par un effet (bombe à mèche
// d'une frame au point du porteur, équipe `Enemies`, tir ami `Always`). Scénario `explode_effect`.
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "kamikaze",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "50.0",
    ),

    effects: [(on: Tick(40), do: [Explode(radius: "40.0", damage: "30.0", destroys: false)], charges: Some(1))],

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        movement_type: None,
        aggro_range: Some("0.0"),
        attack_range: Some("0.0"),
        attack_cooldown_frames: None,
        can_break: None,
        attack_through: None,
        ignores: None,
        path_through_breakables: None,
        flee_threshold: None,
        attack_damage: None,
        stationary: Some(true),
    )),
)
