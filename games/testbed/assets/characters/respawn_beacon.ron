// M-5 (docs/conventions.md § 113) : balise de reprise du feu follet (testbed), copie du `civilian` : personnage neutre immobile qui porte `respawn_range` (24 unités) ; un
// feu follet qui reste dans cette portée `respawn_frames` frames se relève. Posée par `Scenario::characters` (scénario `wisp_respawn_point`) ou une entité `CharacterSpawn`.
// `Team::Neutral` intercepte un tir (`combat::team::team_allows_hit`) mais ne subit jamais de dégât (`combat::damage::resolve_damage`) : la balise ne meurt pas.
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "respawn_beacon",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "40.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    team: Some(Neutral),

    respawn_range: Some("24.0"),

    ai: Some((
        movement_type: None,
        aggro_range: Some("0.0"),
        attack_range: Some("0.0"),
        attack_cooldown_frames: None,
        can_break: None,
        attack_through: None,
        ignores: None,
        path_through_breakables: None,
        flee_threshold: None,
        attack_damage: None,
        stationary: Some(true),
    )),
)
