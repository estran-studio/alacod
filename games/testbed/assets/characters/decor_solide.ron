// C-3 (docs/conventions.md §132) : décor solide du testbed, caisse de 20 × 20. `prop: true` + `solid: true` : le collider bloque les corps
// (joueur : collision dure avec glissement ; ennemi : pas refusé et cases du champ de flux bloquées). Sans `cover` : les balles le traversent
// (équipe de repli `Enemies`, comme `prop-test`) ; le témoin `prop-test` (même collider, sans `solid`) ne bloque rien. Scénarios `decor_solide_*`.
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "decor_solide",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "200.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    prop: true,
    solid: true,
)
