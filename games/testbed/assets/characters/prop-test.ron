// M-1b (docs/conventions.md §112) : personnage « prop » neutre du testbed, caisse de 20 × 20.
// `prop: true` : ni `Enemy` ni barre de vie ; ni `ai` ni `team` (équipe par défaut : cible des balles).
// Collider, santé et dégâts comme un personnage neutre immobile (`dummy`). Scénarios `prop_no_enemy`, `prop_stops_bullet`.
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "prop-test",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "200.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    prop: true,
)
