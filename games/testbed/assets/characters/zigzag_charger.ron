// Personnage de laboratoire X-6b (testbed, conventions §119) : charge en zigzag puis retour au point de
// départ. `[ReturnHome, Charge(zigzag), Melee]` sans `Chase` ni garde : il s'approche (champ de flux) jusqu'à
// 3 × `attack_range`, se tasse 20 frames (télégraphe), charge à 3 × sa vitesse en déviant de ±10 unités
// autour de l'axe (période 24 frames), mord (`attack_damage` au contact), puis recule face au joueur
// jusqu'à moins d'une case de son point d'apparition (vitesse ×2), y attend 40 frames et recharge.
// Il ne poursuit pas **pendant** le recul et l'attente ; en dehors (aucune règle ne s'applique) il retombe sur le champ de flux
// et marche vers le joueur de partout : pour qu'il guette depuis son point, `guard_charger` (`guard: true`). Témoin sans zigzag : `straight_charger`.
// Scénarios `zigzag_*`, `rodeur_*`.
(
    movement: (
        acceleration: "120.0",
        max_speed: "60.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "zigzag_charger",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "200.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("40.0"),
        attack_cooldown_frames: Some(90),
        attack_damage: Some("5.0"),
        behaviors: Some([
            ReturnHome(wait: 40, speed: Some("2.0")),
            Charge(telegraph: 20, zigzag: Some((amplitude: "10.0", period: 24))),
        ]),
    )),
)
