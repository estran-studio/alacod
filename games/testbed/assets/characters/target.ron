// Personnage de laboratoire T2.9 (testbed) : cible immobile à très haute santé qui compte les
// coups reçus (`counts_hits: true` → composant `HitCount`, lu par l'attente `EntityHits` du
// scénario `testbed_target_hits`). Même configuration que `dummy` par ailleurs. Recréé par
// l'orchestrateur : le fichier livré par T2.9 était avalé par le motif `target` du .gitignore.
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        friction: "10.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "target",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "5000.0",
    ),

    // Cible : compte les coups reçus (`HitCount`, attente `EntityHits`).
    counts_hits: true,

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        movement_type: None,
        aggro_range: Some("0.0"),
        attack_range: Some("0.0"),
        attack_cooldown_frames: None,
        can_break: None,
        attack_through: None,
        ignores: None,
        path_through_breakables: None,
        flee_threshold: None,
        attack_damage: None,
        stationary: Some(true),
    )),
)
