// Personnage de laboratoire X-6e (testbed, docs/conventions.md §127) : soldat aux ordres d'un chef. Tireur posté de l'escouade
// `garde` (`ai.squad`) : tant qu'un chef vivant de la même escouade liste `Command`, il ne tire **qu'à l'ordre** (la frame où le
// télégraphe de l'ordre finit), avec les autres soldats ; sans chef (mort, ou phase sans `Command`), il tire à son rythme
// (`cooldown_frames`). Sert aussi de renfort au chef enragé. Scénarios `chef_*`.
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "soldat_ordre",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "30.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        movement_type: None,
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        attack_cooldown_frames: None,
        can_break: None,
        attack_through: None,
        ignores: None,
        path_through_breakables: None,
        flee_threshold: None,
        attack_damage: None,
        stationary: Some(true),
        squad: Some(("garde", None)),
        behaviors: Some([
            Shoot(weapon: "fireball_gun", pattern: "tir_ordre", range: "500.0", cooldown_frames: 30),
        ]),
    )),
)
