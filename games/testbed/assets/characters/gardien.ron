// Boss de laboratoire M2-T0c (testbed, docs/conventions.md §37) : immobile, deux phases.
// Phase 0 : la volée `volee` (télégraphe, flèches visées puis dispersées) toutes les 150 frames ;
// sous 50 % de santé, phase 1 : une couronne de boules de feu (`couronne`) toutes les 90 frames.
// Les tirs passent par la frise (`timeline` + `SpawnPattern`, actions d'`effects`), pas par une
// règle `Shoot` : la table de projectiles d'un tir de règle est fixée à la config de l'ennemi,
// pas à la phase. Scénario `boss_two_phases`.
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "gardien",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "120.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        movement_type: None,
        aggro_range: Some("400.0"),
        attack_range: Some("0.0"),
        attack_cooldown_frames: None,
        can_break: None,
        attack_through: None,
        ignores: None,
        path_through_breakables: None,
        flee_threshold: None,
        attack_damage: None,
        stationary: Some(true),
    )),

    boss: Some((
        phases: [
            (
                until: Some(HealthBelow("0.5")),
                timeline: Some((
                    events: [(at: 10, do: [SpawnPattern(pattern: "volee", weapon: "fireball_gun")])],
                    repeat: Some(150),
                )),
            ),
            (
                timeline: Some((
                    events: [(at: 0, do: [SpawnPattern(pattern: "couronne", weapon: "fireball_gun")])],
                    repeat: Some(90),
                )),
            ),
        ],
    )),
)
