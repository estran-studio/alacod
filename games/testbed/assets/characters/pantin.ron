// R-1 (docs/conventions.md § 111) : le pantin, personnage neutre dessiné par un modèle 3D « façon sprite »
// (`models/models.ron`, modèle synthétique de `scripts/gen-pantin.py`). Joué par `PlayerScript::character`
// (scénario `model_pantin`). Marche à 2,2 m/s × 28 unités/m ≈ 62 unités/s : pieds sans glisser.
(
    movement: (
        acceleration: "1200.0",
        max_speed: "62.0",
        deceleration: "1200.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.1",
        sprint_deceleration_per_frame: "0.2",

        // Roulade : 1,6 m (45 unités) en 0,4 s (24 frames).
        dash_distance: "45.0",
        dash_duration_frames: 24,
        dash_cooldown_frames: 30,
        dash_iframes: 12,
        dash_buffer_frames: 8,
    ),

    asset_name_ref: "pantin",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "100.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    weapon_slots: 1,
    starting_weapons: ["pistol"],
)
