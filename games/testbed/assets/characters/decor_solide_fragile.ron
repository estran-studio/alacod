// C-3 (docs/conventions.md §132) : décor solide destructible du testbed, caisse de 20 × 20, 24 PV. `solid: true` bloque les corps tant qu'il
// vit ; `cover: Some(Destructible)` lui fait arrêter (et encaisser) les balles : il cède au troisième coup d'un `machine_gun`, et cesse alors
// de bloquer (entité désactivée, cases du champ de flux libérées). Scénarios `decor_solide_*`.
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "decor_solide_fragile",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "24.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    prop: true,
    cover: Some(Destructible),
    solid: true,
)
