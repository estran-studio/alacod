// Personnage de laboratoire T1.5 (testbed, conventions §25) : poursuivant ordinaire (comme
// `follower`, `Chase` seul, sans attaque) qui déclare deux variantes. Scénarios `variant_*`
// (carte `testbed/arena_variantes.ldtk` : `rapide` et `blinde` imposées par le champ LDtk
// `variant`, un quatrième `grunt` sans champ, tiré).
(
    movement: (
        acceleration: "120.0",
        max_speed: "60.0",
        friction: "10.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "grunt",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "60.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
        "rapide": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        behaviors: Some([Chase(profile: "Ground")]),
    )),

    // T1.5 : variantes (conventions §25) — `rapide` (×1,5 vitesse, skin `rapide`) et
    // `blinde` (élite : santé ×2, tag `champion`) ; une chance sur deux d'en avoir une.
    variants: Some((
        chance: "0.5",
        table: {
            "rapide": (
                weight: 1,
                modifiers: [(stat: EnemyMoveSpeed, op: Mul, value: "1.5")],
                tags: ["rapide"],
                skin: Some("rapide"),
            ),
            "blinde": (
                weight: 1,
                modifiers: [(stat: MaxHealth, op: Mul, value: "2.0")],
                tags: ["champion"],
                skin: None,
            ),
        },
    )),
    // T1.13 (`docs/conventions.md` §28) : scénarios générés `enemy_<id>_still`/`_moving`
    // (`make gen`). Immobile : le grunt n'attaque pas (`attack_range` 0, `Chase` seul), il
    // rattrape le joueur (distance mesurée 30 dès f300) au lieu de le toucher.
    test: Some((
        frames: 600,
        expect_still: [
            EnemyDistance(entity: Placed(0), target: Player(0), max: Some(40.0), at_frame: 600),
            EnemyNeverInWall(entity: Placed(0), from: 2, to: 600),
        ],
    )),
)
