    movement: (
        acceleration: "120.0",
        max_speed: "60.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "escouade_tireur",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "30.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        squad: Some(("tireurs", Some("arc"))),
        behaviors: Some([
            Shoot(weapon: "tourelle_gun", pattern: "salve", range: "260.0", cooldown_frames: 60),
            Formation(shape: Arc(radius: "100.0", spread: "1.2"), period: 40),
            Chase(profile: "Ground"),
        ]),
    )),
)
