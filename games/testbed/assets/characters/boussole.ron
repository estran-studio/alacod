// X-4a (docs/conventions.md §89) : personnage joueur de la planche de test à huit directions
// (`sprites/characters/boussole/`). Copie du joueur du testbed (mêmes déplacements), sprite `boussole`
// (une planche 4 colonnes × 8 lignes, cellules de 160 px réduites par `scale: 0.2`), une seule arme.
// Utilisé par le scénario `sprite_directions_eight` (`character: "boussole"`) ; aucun autre n'y touche.
(
    movement: (
        acceleration: "3000.0",
        max_speed: "150.0",
        deceleration: "3000.0",
        sprint_multiplier: "2.0",
        sprint_acceleration_per_frame: "0.1",
        sprint_deceleration_per_frame: "0.2",

        dash_distance: "64.0",
        dash_duration_frames: 8,
        dash_cooldown_frames: 24,
        dash_iframes: 6,
        dash_buffer_frames: 8,
    ),

    asset_name_ref: "boussole",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "100.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: { "body": "" }),
        "2": (layers: { "body": "" }),
    },

    weapon_slots: 1,
    starting_weapons: [],
)
