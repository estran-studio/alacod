// X-6d (testbed, conventions §126) : agrippeur neutre. `[Grab, Chase]` : il court vers le joueur (champ de flux) ; à 72 unités ou
// moins il se ramasse 14 frames (immobile), bondit à 3 × sa vitesse vers la position du joueur (24 frames au plus) et, au contact
// (`attack_range` 16), s'accroche à lui : il le suit, le ralentit (`MoveSpeed` × 0,5 par agrippeur, deux au plus sur un même joueur)
// et le mord d'un point toutes les 60 frames. Il se décroche quand le joueur secoue (4 alternances de direction, 20 frames au plus
// entre deux), frappe de mêlée, est frappé de mêlée, ou après 180 frames ; il retombe étourdi 90 frames (immobile, la fenêtre de
// frappe), puis attend 60 frames avant de rebondir. Valeurs d'essai neutres ; celles d'un jeu vivent dans son dépôt.
// Dessiné par le pantin réduit de moitié (`scale: "0.5"`, qui réduit aussi le collider : 24 × 24 déclaré, 12 × 12 en jeu ; `models/models.ron`, modèle `agrippeur` : poses `leap`, `ride`, `stunned`). Scénarios `grab_*`.
(
    movement: (
        acceleration: "600.0",
        max_speed: "70.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "agrippeur",

    collider: (
        shape: Rectangle(
            width: "24.",
            height: "24.",
        ),
        offset: ( x: "0.0", y: "-8.0", z: "0.0" )
    ),

    scale: "0.5",

    base_health: (
        max: "30.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("16.0"),
        attack_cooldown_frames: Some(60),
        attack_damage: Some("1.0"),
        behaviors: Some([
            Grab(
                reach: "72.0",
                telegraph: 14,
                leap_frames: 24,
                hold: 180,
                slow: "0.5",
                shake: 4,
                stun: 90,
                cooldown: 60,
                max_riders: 2,
                bite_every: Some(60),
            ),
            Chase(profile: "Ground"),
        ]),
    )),
)
