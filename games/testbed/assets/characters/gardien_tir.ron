// Boss de laboratoire M2-T7 (testbed, docs/conventions.md §45) : tir **par phase**. Chaque phase
// porte sa propre règle `Shoot` (arme, pattern et recharge) : phase 0, la volée `volee` avec la table de
// projectiles de `fireball_gun` (flèches) ; sous 50 % de santé, phase 1, la couronne `ring_8` avec la table de
// `tourelle_gun` (boules). Le personnage n'a aucune règle `Shoot` ni `ranged` hors des phases.
// Scénario `boss_phase_shoot`.
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "gardien_tir",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "120.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        movement_type: None,
        aggro_range: Some("400.0"),
        attack_range: Some("0.0"),
        attack_cooldown_frames: None,
        can_break: None,
        attack_through: None,
        ignores: None,
        path_through_breakables: None,
        flee_threshold: None,
        attack_damage: None,
        stationary: Some(true),
    )),

    boss: Some((
        phases: [
            (
                until: Some(HealthBelow("0.5")),
                behaviors: [Shoot(weapon: "fireball_gun", pattern: "volee", range: "400.0", cooldown_frames: 90)],
            ),
            (
                behaviors: [Shoot(weapon: "tourelle_gun", pattern: "ring_8", range: "400.0", cooldown_frames: 60)],
            ),
        ],
    )),
)
