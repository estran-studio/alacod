// X-6c (testbed, conventions §120) : tireur qui se replie derrière un couvert. Règles par priorité : `TakeCover` (rayon 120, 60 frames à l'abri,
// vitesse ×2), `Shoot` (volée `volee` de l'archer, portée 240, refroidissement de 200 frames), `Chase`. Dès que sa volée finit, il choisit le point
// abrité le plus proche derrière un couvert (`couvert`) par rapport au joueur, s'y rend, y reste 60 frames, puis reprend (`Chase`). Sans couvert à
// moins de 120 unités, `TakeCover` n'est jamais retenu : il se comporte comme `tireur_sans_repli`. Valeurs d'essai neutres. Scénarios `repli_couvert_*`.
(
    movement: (
        acceleration: "120.0",
        max_speed: "60.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "tireur_couvert",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "200.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        movement_type: None,
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        attack_cooldown_frames: None,
        can_break: None,
        attack_through: None,
        ignores: None,
        path_through_breakables: None,
        flee_threshold: None,
        attack_damage: None,
        stationary: None,
        behaviors: Some([
            TakeCover(radius: "120.0", hold: 60, speed: Some("2.0")),
            Shoot(weapon: "fireball_gun", pattern: "volee", range: "240.0", cooldown_frames: 200),
            Chase(profile: "Ground"),
        ]),
    )),
)
