// Personnage de laboratoire T1.10 (testbed) : copie du mannequin `dummy` (immobile, 200 points
// de vie, ne riposte pas) qui porte un effet v1 (`docs/conventions.md` §27) : sous 50 % de sa
// santé, chaque coup encaissé le soigne de 5 points. Spawné par `CharacterSpawn` sur
// `testbed/effets.ldtk` (copie d'`arena.ldtk`, `pilote` à la place de `dummy`, même net_id 33).
// Scénarios `effect_on_damage_taken` et son jumeau `effect_none` (le `dummy` d'`arena.ldtk`).
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "pilote",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "200.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        movement_type: None,
        aggro_range: Some("0.0"),
        attack_range: Some("0.0"),
        attack_cooldown_frames: None,
        can_break: None,
        attack_through: None,
        ignores: None,
        path_through_breakables: None,
        flee_threshold: None,
        attack_damage: None,
        stationary: Some(true),
    )),

    // T1.10 : sous la moitié de sa santé, chaque coup encaissé rend 5 points.
    effects: [
        (on: OnDamageTaken, if: [HpBelow("0.5")], do: [Heal("5")]),
    ],
)
