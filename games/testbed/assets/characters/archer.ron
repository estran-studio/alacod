// Personnage de laboratoire T1.2 (testbed) : archer qui poursuit le joueur (flow field,
// comme `follower`) puis, à moins de 240 unités, s'arrête et joue la volée `volee`
// (`patterns/volee.ron` : télégraphe, 3 flèches visées, attente, 4 flèches dispersées) avec
// la table `projectiles` de `fireball_gun` ; refroidissement de 90 frames ensuite
// (règle `Shoot`, conventions §20 et §22). Pas de corps à corps. Scénario `enemy_telegraph`.
(
    movement: (
        acceleration: "120.0",
        max_speed: "60.0",
        friction: "10.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "archer",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "200.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        movement_type: None,
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        attack_cooldown_frames: None,
        can_break: None,
        attack_through: None,
        ignores: None,
        path_through_breakables: None,
        flee_threshold: None,
        attack_damage: None,
        stationary: None,
        // T1.4 : règles par priorité (conventions §22) ; `Shoot` remplace `ai.ranged` de T1.2.
        behaviors: Some([
            Shoot(weapon: "fireball_gun", pattern: "volee", range: "240.0", cooldown_frames: 90),
            Chase(profile: "Ground"),
        ]),
    )),
    // T1.13 (`docs/conventions.md` §28) : scénarios générés `enemy_<id>_still`/`_moving`
    // (`make gen`), attentes par défaut.
    test: Some((frames: 600)),
)
