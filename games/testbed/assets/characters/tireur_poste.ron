// P-1 (testbed, docs/conventions.md §110) : tireur posté à cycle (`ai.ranged_cycle`). Immobile hors cycle (`stationary`),
// il joue la salve `salve_postee` (flèches de `fireball_gun`) sur le joueur : visée et regard qui suivent la cible,
// recharge de 60 frames puis attente tirée de 10 à 20 frames, première salve au plus tôt 20 + 40 × rang frames après
// sa première frame, un coup reçu interrompt la salve et le sonne 30 frames, recul de 12 px en 10 frames au tir, retour au
// poste à 60 px/s. Valeurs d'essai neutres. Scénarios `tireur_poste_*` ; témoin à visée figée : `tireur_poste_fige`.
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "tireur_poste",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "500.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        movement_type: None,
        aggro_range: Some("600.0"),
        attack_range: Some("0.0"),
        attack_cooldown_frames: None,
        can_break: None,
        attack_through: None,
        ignores: None,
        path_through_breakables: None,
        flee_threshold: None,
        attack_damage: None,
        stationary: Some(true),
        behaviors: Some([
            Shoot(weapon: "fireball_gun", pattern: "salve_postee", range: "600.0", cooldown_frames: 60),
        ]),
        ranged_cycle: Some((
            track_target: true,
            face_target: true,
            wait_frames: Some((10, 20)),
            first_wait: Some((20, 40)),
            stagger_frames: Some(30),
            recoil: Some((distance: "12.0", frames: 10)),
            return_speed: Some("60.0"),
        )),
    )),
)
