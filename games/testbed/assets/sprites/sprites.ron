// D3 : table des feuilles de sprites (kind `SpriteSheet` de `game.ron`, chargée par
// `content::registry::load_sprite_sheets`, lue par `game::global_asset`). Un id par entrée :
// le `asset_name_ref` d'un personnage, le `sprite_config.name` d'une arme à distance, ou
// `slash` (effet de coup de mêlée). `animation` : configuration d'animation
// (`AnimationMapConfig`) ; `layers` : calque -> feuille (`SpriteSheetConfig`). Chemins relatifs
// à `assets/`. Feuilles et images rangées par entité sous `sprites/` (characters/, weapons/,
// enemies/, effects/) ; voir `docs/conventions.md` §2.
({
    "player": (
        animation: "sprites/characters/player/player_animation.ron",
        layers: {
            "body": "sprites/characters/player/player_sheet.ron",
            "shirt": "sprites/characters/player/shirt_1_sheet.ron",
            "hair": "sprites/characters/player/hair_1_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    // X-4a (docs/conventions.md §89) : planche de test à huit directions (personnage `boussole`).
    "boussole": (
        animation: "sprites/characters/boussole/boussole_animation.ron",
        layers: { "body": "sprites/characters/boussole/boussole_sheet.ron" },
    ),
    // Armes à distance : portées par le joueur, animées par l'animation du joueur.
    "shotgun": (
        animation: "sprites/characters/player/player_animation.ron",
        layers: { "body": "sprites/weapons/shotgun_sheet.ron" },
    ),
    "pistol": (
        animation: "sprites/characters/player/player_animation.ron",
        layers: { "body": "sprites/weapons/pistol_sheet.ron" },
    ),
    "machine_gun": (
        animation: "sprites/characters/player/player_animation.ron",
        layers: { "body": "sprites/weapons/machine_gun_sheet.ron" },
    ),
    // M3-T17 (§82) : placeholders du feedback v3 (larmes, bombe, rocher, familiers, champions).
    "bullet_player": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/tear_sheet.ron" },
    ),
    "bullet_enemy": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/tear_sheet.ron" },
    ),
    "bomb": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/bomb_sheet.ron" },
    ),
    "rock": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/rock_sheet.ron" },
    ),
    "compagnon": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/companion_sheet.ron" },
    ),
    "orbital": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/orbital_sheet.ron" },
    ),
    "rempart": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/orbital_sheet.ron" },
    ),
    "elite_explosif": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/champion_sheet.ron" },
    ),
    "elite_divise": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/champion_sheet.ron" },
    ),
    "elite_riche": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/champion_sheet.ron" },
    ),
    "elite_comportement": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/champion_sheet.ron" },
    ),
    "elite_chance": (
        animation: "sprites/feedback/anim_still.ron",
        layers: { "body": "sprites/feedback/champion_sheet.ron" },
    ),
    "slash": (
        animation: "sprites/effects/slash/slash_animation.ron",
        layers: { "body": "sprites/effects/slash/slash_sheet.ron" },
    ),
    "fantassin-de-ligne": (
        animation: "sprites/fantassin-de-ligne/fantassin-de-ligne_animation.ron",
        layers: { "body": "sprites/fantassin-de-ligne/fantassin-de-ligne_sheet.ron" },
    ),
})
