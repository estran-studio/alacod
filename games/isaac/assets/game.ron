// Manifeste du jeu `isaac` (M3-T0f, docs/conventions.md §3, §17, §40 et §65 ; grille : M3-T5, §70) : le clone de
// squelette d'Isaac. Deux étages `sous_sol` (nom provisoire, Q9) assemblés par la grammaire d'étage en grille
// (`Grid`, salles de 15 x 9 cases : départ, combat, boss, trésor, secrète, diable ; 1x1, 2x1, 1x2, 2x2), en mode
// `Floors` : défaite à la mort, victoire quand le boss du dernier étage est vaincu.
// Sprites, sons, interface et caméra copiés de `gungeon` (placeholders, voir `assets.yaml`).
(
    name: "isaac",
    content_folders: [
        (path: "characters", kind: "Character"),
        (path: "weapons/weapons.ron", kind: "Weapon"),
        (path: "weapons/melee.ron", kind: "MeleeWeapon"),
        (path: "patterns", kind: "Pattern"),
        (path: "floors", kind: "Floors"),
        // Grammaire d'étage (`floor:<id>`), gabarits dans `maps/salles.ldtk`.
        (path: "floor_grammars", kind: "FloorGrammar"),
        // Consommables `key` et `blank`, soin `ration` (copie de `gungeon`).
        (path: "objets", kind: "Item"),
        (path: "loot", kind: "LootTable"),
        // M3-T10 (§75) : accomplissements de la run et déblocages qu'ils accordent (pas de hub : aucun achat).
        (path: "unlocks", kind: "Unlock"),
        (path: "achievements", kind: "Achievement"),
        // M3-T11a (§76.1) : statuts posés par l'`on_hit` des objets de larmes (poison, brûlure, gel, peur, lenteur).
        (path: "statuses", kind: "Status"),
        // M3-T11b (§76.2) : synergie d'objets du pool `tresor`.
        (path: "synergies", kind: "Synergy"),
        // M3-T9 (§74) : les cinq curses de Q7 ; aucune séquence par défaut ne les tire avant M3-T11d.
        (path: "curses", kind: "Curse"),
        // Types de salles du champ de niveau `room_kind`.
        (path: "rooms", kind: "Room"),
        (path: "economy/economy.ron", kind: "Economy"),
        (path: "ui", kind: "Ui"),
        (path: "camera.ron", kind: "Camera"),
        (path: "sprites/sprites.ron", kind: "SpriteSheet"),
        (path: "maps", kind: "Map"),
    ],
    entry: (
        start_map: "floor:sous_sol_court",
        default_seed: 123456,
        mode: Floors,
        floors: "sous_sol",
    ),
    // `docs/conventions.md` §28 : scénarios générés de isaac (`make gen GAME=isaac`) joués sur la carte
    // gabarit, en mode `Sandbox` imposé par le générateur (copie de celle de `gungeon`).
    generate_template: (map: "maps/gabarit_armes.ldtk", target: "cible"),
    // M3-T12 (docs/conventions.md §77) : les mécaniques que la partie ordinaire (séquence `sous_sol`) doit
    // rencontrer, tableau « Atteignabilité » de docs/taches.md §8.1. `alacod lint` avertit de chacune que le
    // contenu ne porte pas encore (jusqu'à M3-T8, T9, T10, T11).
    mechanics: [
        Tears,
        Effects,
        Familiars,
        Bombs,
        SecretRoom,
        Keys,
        Hearts,
        ExhaustPools,
        DevilMarket,
        Champions,
        Curses,
        Achievements,
    ],
)
