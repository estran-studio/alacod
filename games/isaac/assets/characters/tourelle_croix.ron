// Champion `salve` (chance `0,15 + étage × 0,12`) : à sa mort, une couronne de huit boules (`SpawnPattern`).
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
