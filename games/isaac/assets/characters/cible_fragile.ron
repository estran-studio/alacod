// `isaac` (M3-T11a, docs/conventions.md §76.1) : cible de laboratoire **fragile** (15 points de vie, compte les coups
// comme `cible`) : un objet de dégâts la tue en moins de larmes qu'un tir sans objet (`tears_encre`, attente
// `EntityCount(Enemy)`). Posée seulement par un `test: tears: targets`, jamais dans une salle.
(
    test_only: true, // D63 : contenu de laboratoire, ignoré par l'analyse d'atteignabilité (conventions §53)
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "cible_fragile",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "15.0",
    ),

    // Cible : compte les coups reçus (`HitCount`, attente `EntityHits`).
    counts_hits: true,

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        movement_type: None,
        aggro_range: Some("0.0"),
        attack_range: Some("0.0"),
        attack_cooldown_frames: None,
        can_break: None,
        attack_through: None,
        ignores: None,
        path_through_breakables: None,
        flee_threshold: None,
        attack_damage: None,
        stationary: Some(true),
    )),
)
