// `isaac` (M3-T11c, §76.3) : tireur au sol. Court vers le joueur (`Chase`) et, à moins de 200 unités, crache une larme visée
// (`crachat`, 15 frames de télégraphe). Il ne sent le joueur qu'à 130 unités (`aggro_range`) mais le cible de plus
// loin en ligne de vue dégagée (`sight_range` 360 : D66, §22) : un coin de mur le laisse inoffensif.
// Renfort du boss `gardien` (phase 1, `SpawnEnemies`) : pas posé dans le gabarit de combat, où quatre ennemis ou plus
// tuent l'`explorateur` à coup sûr (§76.3).
(
    movement: (
        acceleration: "120.0",
        max_speed: "36.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "cracheur",

    collider: (
        shape: Rectangle(width: "20.", height: "20."),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (max: "6.0"),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("130.0"),
        sight_range: Some("360.0"),
        attack_range: Some("0.0"),
        behaviors: Some([
            Shoot(weapon: "arsenal", pattern: "crachat", range: "200.0", cooldown_frames: 300),
            Chase(profile: "Ground"),
        ]),
    )),
    test: Some((frames: 600)),
)
