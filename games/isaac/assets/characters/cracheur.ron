// `isaac` (M3-T11c, §76.3) : tireur au sol. Garde 70 à 130 unités (`KeepDistance`) et crache trois larmes visées
// (`crachat`, 15 frames de télégraphe). Il ne sent le joueur qu'à 130 unités (`aggro_range`) mais le cible de plus
// loin en ligne de vue dégagée (`sight_range` 360 : D66, §22) : un coin de mur le laisse inoffensif.
// Champion `salve` (chance `0,15 + étage × 0,12`) : à sa mort, une couronne de huit boules (`SpawnPattern`).
(
    movement: (
        acceleration: "120.0",
        max_speed: "36.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "cracheur",

    collider: (
        shape: Rectangle(width: "20.", height: "20."),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (max: "9.0"),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("130.0"),
        sight_range: Some("360.0"),
        attack_range: Some("0.0"),
        behaviors: Some([
            Shoot(weapon: "arsenal", pattern: "crachat", range: "200.0", cooldown_frames: 150),
            KeepDistance(min: "70.0", max: "130.0"),
            Chase(profile: "Ground"),
        ]),
    )),
    variants: Some((
        chance: "0.15 + floor * 0.12",
        table: {
            "salve": (tags: ["champion"], on_death: [SpawnPattern(pattern: "couronne_unique", weapon: "arsenal")], tint: Some("#16a085")),
        },
    )),
    // Scénarios générés `champion_cracheur_salve` (variante imposée, `kill` : la couronne de mort) et `enemy_cracheur_*`.
    test: Some((
        frames: 600,
        champions: [(variant: "salve", kill: true, weapon: Some("larmes"))],
    )),
)
