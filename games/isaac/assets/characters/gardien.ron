// `isaac` (M3-T0f, docs/conventions.md §37 et §45) : boss immobile (trois phases depuis M3-T11c, voir `boss:`).
// Les tirs passent par la frise (`SpawnPattern` avec la table de projectiles de l'`arsenal`).
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "gardien",

    collider: (
        shape: Rectangle(width: "20.", height: "20."),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (max: "40.0"),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        stationary: Some(true),
    )),

    // Scénario généré `boss_gardien` (un bot joue l'étage du manifeste et bat le boss).
    test: Some((frames: 1500, still: false, moving: false, boss: Some(()))),
    // M3-T11c (§76.3) : trois phases. 0 (au-dessus de 66 %) : l'éventail, toutes les 150 frames. 1 (sous 66 %) : la
    // couronne, puis 60 frames plus tard la spirale (64 frames de jeu, elle finit avant la couronne suivante). 2, la
    // rage (sous 33 %) : un `spectre` (`Phasing`) et un `bourdon` (`Flying`) en renfort, puis un éventail
    // précédé d'un télégraphe de 10 frames et, 40 frames plus tard, une couronne. Le butin (`boss_drop`, pool `boss`)
    // est posé par `rooms/boss.ron`.
    boss: Some((
        phases: [
            (
                until: Some(HealthBelow("0.66")),
                timeline: Some((
                    events: [(at: 10, do: [SpawnPattern(pattern: "eventail", weapon: "arsenal")])],
                    repeat: Some(150),
                )),
            ),
            (
                until: Some(HealthBelow("0.33")),
                timeline: Some((
                    events: [
                        (at: 0, do: [SpawnPattern(pattern: "couronne", weapon: "arsenal")]),
                        (at: 60, do: [SpawnPattern(pattern: "spirale", weapon: "arsenal")]),
                    ],
                    repeat: Some(150),
                )),
            ),
            (
                on_enter: [SpawnEnemies(id: "spectre", count: 1), SpawnEnemies(id: "bourdon", count: 1)],
                timeline: Some((
                    events: [
                        (at: 30, do: [Telegraph(10), SpawnPattern(pattern: "eventail", weapon: "arsenal")]),
                        (at: 70, do: [SpawnPattern(pattern: "couronne", weapon: "arsenal")]),
                    ],
                    repeat: Some(150),
                )),
            ),
        ],
    )),
)
