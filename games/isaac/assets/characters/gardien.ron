// `isaac` (M3-T0f, docs/conventions.md §37 et §45) : boss immobile (trois phases depuis M3-T11c, voir `boss:`).
// Les tirs passent par la frise (`SpawnPattern` avec la table de projectiles de l'`arsenal`).
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "gardien",

    collider: (
        shape: Rectangle(width: "20.", height: "20."),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (max: "40.0"),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        stationary: Some(true),
    )),

    // Scénario généré `boss_gardien` (un bot joue l'étage du manifeste et bat le boss).
    test: Some((frames: 1500, still: false, moving: false, boss: Some(()))),
    // M3-T11c (§76.3) : trois phases. 0 (au-dessus de 60 %) : l'éventail, toutes les 150 frames. 1 (sous 60 %) : un
    // `rampant` (charge) et un `cracheur` (tireur) en renfort (`SpawnEnemies`), la couronne toutes les 150 frames. 2, la
    // rage (sous 25 %) : un `spectre` (`Phasing`) et un `bourdon` (`Flying`) en renfort, puis une spirale de deux bras
    // (`spirale`, 60 frames de jeu, elle finit avant la répétition de 150) précédée d'un télégraphe de 10 frames. Le
    // butin (`boss_drop`, pool `boss`) est posé par `rooms/boss.ron`. Premier jet plus dur (couronne et éventail, puis
    // couronne et spirale à trois bras dans les phases 1 et 2) : l'`explorateur` mourait au boss, 9 graines sur 16.
    boss: Some((
        phases: [
            (
                until: Some(HealthBelow("0.6")),
                timeline: Some((
                    events: [(at: 10, do: [SpawnPattern(pattern: "eventail", weapon: "arsenal")])],
                    repeat: Some(150),
                )),
            ),
            (
                until: Some(HealthBelow("0.25")),
                on_enter: [SpawnEnemies(id: "rampant", count: 1), SpawnEnemies(id: "cracheur", count: 1)],
                timeline: Some((
                    events: [(at: 0, do: [SpawnPattern(pattern: "couronne", weapon: "arsenal")])],
                    repeat: Some(150),
                )),
            ),
            (
                on_enter: [SpawnEnemies(id: "spectre", count: 1), SpawnEnemies(id: "bourdon", count: 1)],
                timeline: Some((
                    events: [(at: 30, do: [Telegraph(10), SpawnPattern(pattern: "spirale", weapon: "arsenal")])],
                    repeat: Some(150),
                )),
            ),
        ],
    )),
)
