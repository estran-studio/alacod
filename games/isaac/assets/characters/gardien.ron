// `isaac` (M3-T0f, docs/conventions.md §37 et §45) : boss immobile à deux phases. Phase 0 : un
// éventail (`eventail`, `Fan`) toutes les 150 frames ; sous 50 % de santé, phase 1 : une couronne
// (`couronne`, `Ring`) toutes les 150 frames, précédée d'un télégraphe de 20 frames.
// Les tirs passent par la frise (`SpawnPattern` avec la table de projectiles de l'`arsenal`).
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "gardien",

    collider: (
        shape: Rectangle(width: "20.", height: "20."),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (max: "40.0"),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        stationary: Some(true),
    )),

    // Scénario généré `boss_gardien` (un bot joue l'étage du manifeste et bat le boss).
    test: Some((frames: 1500, still: false, moving: false, boss: Some(()))),

    boss: Some((
        phases: [
            (
                until: Some(HealthBelow("0.5")),
                timeline: Some((
                    events: [(at: 10, do: [SpawnPattern(pattern: "eventail", weapon: "arsenal")])],
                    repeat: Some(150),
                )),
            ),
            (
                timeline: Some((
                    events: [(at: 30, do: [SpawnPattern(pattern: "couronne", weapon: "arsenal")])],
                    repeat: Some(150),
                )),
            ),
        ],
    )),
)
