// D3 : table des feuilles de sprites (kind `SpriteSheet` de `game.ron`, chargée par
// `content::registry::load_sprite_sheets`, lue par `game::global_asset`). Un id par entrée :
// le `asset_name_ref` d'un personnage, le `sprite_config.name` d'une arme à distance, ou
// `slash` (effet de coup de mêlée). `animation` : configuration d'animation
// (`AnimationMapConfig`) ; `layers` : calque -> feuille (`SpriteSheetConfig`). Chemins relatifs
// à `assets/`. Feuilles et images rangées par entité sous `sprites/` (characters/, weapons/,
// enemies/, effects/) ; voir `docs/conventions.md` §2.
({
    // `isaac` (M3-T0f) : placeholders, mêmes tuiles Tiny Dungeon (Kenney, CC0) que `gungeon`.
    // Lot C (docs/plan-assets.md) : héros, ennemis, boss et objets du monde de `gungeon` viennent du pack
    // Tiny Dungeon de Kenney (CC0, `sprites/gungeon/`) ; l'image est choisie par l'animation (une case).
    "player": (
        animation: "sprites/gungeon/anim_player.ron",
        layers: {
            "body": "sprites/gungeon/tiny_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    "cible": (
        animation: "sprites/gungeon/anim_cible.ron",
        layers: { "body": "sprites/gungeon/tiny_sheet.ron" },
    ),
    "suiveur": (
        animation: "sprites/gungeon/anim_bullet_kin.ron",
        layers: { "body": "sprites/gungeon/tiny_sheet.ron" },
    ),
    "mouche": (
        animation: "sprites/gungeon/anim_fuyard_kin.ron",
        layers: { "body": "sprites/gungeon/tiny_sheet.ron" },
    ),
    "gardien": (
        animation: "sprites/gungeon/anim_gatling.ron",
        layers: { "body": "sprites/gungeon/tiny_boss_sheet.ron" },
    ),
    "bullet_player": (
        animation: "sprites/gungeon/anim_bullet_player.ron",
        layers: { "body": "sprites/gungeon/bullet_player_sheet.ron" },
    ),
    "bullet_enemy": (
        animation: "sprites/gungeon/anim_bullet_enemy.ron",
        layers: { "body": "sprites/gungeon/bullet_enemy_sheet.ron" },
    ),
    "pistol": (
        animation: "sprites/characters/player/player_animation.ron",
        layers: { "body": "sprites/weapons/pistol_sheet.ron" },
    ),
    "slash": (
        animation: "sprites/effects/slash/slash_animation.ron",
        layers: { "body": "sprites/effects/slash/slash_sheet.ron" },
    ),
})
