// `isaac` (M3-T11a, docs/conventions.md §76.1) : larmes 1,5 fois plus grosses (`ShotSize` Mul 1,5 : collision et sprite) et +20 % de dégâts.
(
    name: "Grosse goutte",
    kind: Passive,
    modifiers: [(stat: ShotSize, op: Mul, value: "1.5"), (stat: Damage, op: Pct, value: "0.2")],
    tags: ["larmes"],
    rarity: Uncommon,
    test: Some((
        frames: 60,
        // M3-T13 (§78) : `tears_goutte` et son témoin `tears_goutte_sans_objet`, seuils mesurés : cible posée à 22 unités de la ligne de tir : touchée seulement par les larmes agrandies (6 coups), le témoin la rate (0).
        tears: Some((weapon: Some("larmes"), frames: Some(150), targets: [(character: "cible", dx: -98, dy: -13)], hits: [(target: 1, with_item: 5, without_item: 0)])),
    )),
)
