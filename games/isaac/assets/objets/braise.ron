// `isaac` (M3-T11a, docs/conventions.md §76.1) : chaque larme enflamme sa cible (statut `brulure`, 4 points toutes les 30 frames).
(
    name: "Braise",
    kind: Passive,
    projectile: Some((on_hit: [ApplyStatus(status: "brulure", stacks: 1)])),
    tags: ["larmes"],
    rarity: Uncommon,
    test: Some((
        frames: 60,
        // M3-T13 (§78) : `tears_braise` et son témoin `tears_braise_sans_objet`, seuils mesurés : la cible posée brûle à f150 (témoin : aucun statut).
        tears: Some((weapon: Some("larmes"), frames: Some(150), targets: [(character: "cible", dx: -48, dy: -18)], expect: [HasStatus(entity: Placed(0), status: "brulure", at_frame: 150)], control: [HasStatus(entity: Placed(0), status: "brulure", present: false, at_frame: 150)])),
    )),
)
