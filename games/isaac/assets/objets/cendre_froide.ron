    name: "Cendre froide",
    kind: Passive,
    projectile: Some((on_hit: [ApplyStatus(status: "brulure", stacks: 1), ApplyStatus(status: "lenteur", stacks: 1)])),
    tags: ["larmes"],
    rarity: Rare,
    test: Some((
        frames: 60,
        // M3-T11d2 : TODO
        tears: Some((weapon: Some("larmes"), frames: Some(150), targets: [(character: "cible", dx: -48, dy: -18)], expect: [HasStatus(entity: Placed(0), status: "brulure", at_frame: 150), HasStatus(entity: Placed(0), status: "lenteur", at_frame: 150)], control: [HasStatus(entity: Placed(0), status: "brulure", present: false, at_frame: 150), HasStatus(entity: Placed(0), status: "lenteur", present: false, at_frame: 150)])),
    )),
