// `isaac` (M3-T11b, §76.2) : un coup reçu (`OnDamageTaken`) effraie son auteur (`ApplyStatus` pose `peur` sur la source du coup).
(
    name: "Rancune vive",
    kind: Passive,
    effects: [
        (on: OnDamageTaken, do: [ApplyStatus(status: "peur", stacks: 1)]),
    ],
    tags: ["effet"],
    rarity: Uncommon,
    test: Some((
        frames: 60,
        tears: Some((weapon: Some("larmes"), frames: Some(200), targets: [(character: "cible_mordante", dx: -150, dy: -48)], expect: [HasStatus(entity: Placed(0), status: "peur", at_frame: 190)], control: [HasStatus(entity: Placed(0), status: "peur", present: false, at_frame: 190)])),
    )),
)
