    name: "Vent arrière",
    kind: Passive,
    modifiers: [(stat: ShotSpeed, op: Pct, value: "0.5")],
    tags: ["larmes"],
    rarity: Common,
    test: Some((
        frames: 60,
        // M3-T13 (§78) : `tears_vent_arriere` et son témoin `tears_vent_arriere_sans_objet`, seuils mesurés : la larme touche la cible avant f48 (1 coup) ; le témoin n'a encore touché personne.
        tears: Some((weapon: Some("larmes"), frames: Some(48), targets: [], hits: [(target: 0, with_item: 1, without_item: 0)])),
