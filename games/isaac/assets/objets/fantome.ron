// `isaac` (M3-T11a, docs/conventions.md §76.1) : les larmes traversent murs et obstacles (`Spectral`), jamais les personnages.
(
    name: "Larme fantôme",
    kind: Passive,
    projectile: Some((modifiers: [Spectral])),
    tags: ["larmes"],
    rarity: Rare,
    test: Some((
        frames: 60,
        // M3-T13 (§78) : `tears_fantome` et son témoin `tears_fantome_sans_objet`, seuils mesurés : 1 balle en vol contre 0 à f150.
        tears: Some((weapon: Some("larmes"), frames: Some(150), targets: [(character: "cible", dx: -48, dy: -18)], expect: [BulletCount(count: 1, projectile: Some("larmes"), at_frame: 150)], control: [BulletCount(count: 0, projectile: Some("larmes"), at_frame: 150)])),
    )),
)
