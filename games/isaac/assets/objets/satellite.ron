// `isaac` (M3-T11a, docs/conventions.md §76.1) : les larmes tournent autour du porteur (rayon 40, un tour en 60 frames) pendant 240 frames (`Orbit`).
(
    name: "Satellite",
    kind: Passive,
    projectile: Some((modifiers: [Orbit(radius: "40.0", frames_per_turn: 60), Lifetime(240)])),
    tags: ["larmes"],
    rarity: Rare,
    test: Some((
        frames: 60,
        // M3-T13 (§78) : `tears_satellite` et son témoin `tears_satellite_sans_objet`, seuils mesurés : cible posée à 40 unités derrière le joueur, sur l'orbite : touchée seulement par la larme en orbite (au moins 1 coup, 0 sans).
        tears: Some((weapon: Some("larmes"), frames: Some(150), targets: [(character: "cible", dx: -168, dy: -48)], hits: [(target: 1, with_item: 1, without_item: 0)])),
    )),
)
