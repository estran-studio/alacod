// `isaac` (M3-T11a, docs/conventions.md §76.1) : chaque larme ralentit sa cible de moitié (statut `lenteur`).
(
    name: "Glu",
    kind: Passive,
    projectile: Some((on_hit: [ApplyStatus(status: "lenteur", stacks: 1)])),
    tags: ["larmes"],
    rarity: Common,
    test: Some((
        frames: 60,
        // M3-T13 (§78) : `tears_glu` et son témoin `tears_glu_sans_objet`, seuils mesurés : la cible posée est ralentie à f150 (témoin : aucun statut).
        tears: Some((weapon: Some("larmes"), frames: Some(150), targets: [(character: "cible", dx: -48, dy: -18)], expect: [HasStatus(entity: Placed(0), status: "lenteur", at_frame: 150)], control: [HasStatus(entity: Placed(0), status: "lenteur", present: false, at_frame: 150)])),
    )),
)
