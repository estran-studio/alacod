// `isaac` (M3-T11d2, §76.5) : chaque larme fait saigner sa cible (statut `saignement` : 1 point toutes les 15 frames pendant 180 frames).
(
    name: "Saignée",
    kind: Passive,
    projectile: Some((on_hit: [ApplyStatus(status: "saignement", stacks: 1)])),
    tags: ["larmes"],
    rarity: Common,
    test: Some((
        frames: 60,
        // M3-T13 (§78) : `tears_saignee` et son témoin `tears_saignee_sans_objet`, seuils mesurés : la cible posée saigne à f150 (témoin : aucun statut).
        tears: Some((weapon: Some("larmes"), frames: Some(150), targets: [(character: "cible", dx: -48, dy: -18)], expect: [HasStatus(entity: Placed(0), status: "saignement", at_frame: 150)], control: [HasStatus(entity: Placed(0), status: "saignement", present: false, at_frame: 150)])),
    )),
)
