// `isaac` (M3-T11d2, §76.5) : actif chargé par deux salles nettoyées ; à l'usage (`UseActive`), +60 % de vitesse de déplacement pendant 300 frames (`MoveSpeed` en unités/s : 120 au repos, 192,00073 à f30, mesuré).
(
    name: "Élixir de vitesse",
    kind: Active(Rooms(2)),
    effects: [
        (on: OnUse, do: [TimedModifier(stat: MoveSpeed, op: Pct, value: "0.6", frames: 300)]),
    ],
    tags: ["actif"],
    rarity: Uncommon,
    test: Some((frames: 60, expect: [Stat(handle: 0, stat: MoveSpeed, value: 120.0, at_frame: 8), Stat(handle: 0, stat: MoveSpeed, value: 192.00073, at_frame: 30)])),
)
