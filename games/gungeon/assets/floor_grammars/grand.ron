// Grammaire d'étage de 15 à 20 salles (M2-T10) : la mesure de perf `bench_floor`.
(
    templates: "maps/salles.ldtk",
    grammar: (
        rooms: (15, 20),
        required: {"boss": 1, "recompense": 1, "boutique": 1},
        // m2-salles-murs-gungeon (§40) : gabarits agrandis (jusqu'à 352 px), 15 à 20 salles ; défaut 1000.
        bounds: Some((4000, 4000)),
        min_boss_distance: 4,
    ),
)
