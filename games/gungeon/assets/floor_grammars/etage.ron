// Grammaire d'étage de `gungeon` (M2-T10, docs/conventions.md §40) : de 10 à 14 salles, un départ, un
// boss en cul-de-sac à distance maximale (au moins 3 salles du départ), une récompense, une boutique, une
// arène à tenir (M2-T7), une escouade (M2-T8), un coffre et une salle secrète (M2-T14d, §52.d), le reste
// en salles de combat. Gabarits : maps/salles.ldtk.
(
    templates: "maps/salles.ldtk",
    grammar: (
        rooms: (10, 14),
        required: {"boss": 1, "recompense": 1, "boutique": 1, "arene": 1, "escouade": 1, "coffre": 1, "secret": 1},
        min_boss_distance: 3,
    ),
)
