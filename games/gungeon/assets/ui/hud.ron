        (title: "Monde", column: 3, entries: [
            (label: "Coffre à clé (cadenas)", sprite: Some("chest")),
            (label: "Présentoir : prix", sprite: Some("shelf")),
            (label: "Baril explosif", sprite: Some("barrel")),
            (label: "Table : couverture", sprite: Some("table")),
            (label: "Rocher : bombe", sprite: Some("rock")),
            (label: "Mur fissuré : bombe", sprite: Some("secret_wall")),
            (label: "Porte fermée (salle)", sprite: Some("door_v")),
            (label: "Porte ouverte", sprite: Some("door_v"), anim: Some("Open")),
            (label: "Porte à clé (cadenas)", sprite: Some("door_v"), anim: Some("Locked")),
            (label: "Portail : étage suivant", sprite: Some("portal")),
            (label: "Eau : ralentit", color: Some("#3b7dd8")),
            (label: "Sable : ralentit", color: Some("#d8c27a")),
            (label: "Fosse : tombe", color: Some("#202020")),
