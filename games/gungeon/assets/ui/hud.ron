            (label: "Bandana : fonce", sprite: Some("bandana_kin")),
            (label: "Fuyard : s'enfuit", sprite: Some("fuyard_kin")),
            (label: "Cible d'entraînement", sprite: Some("cible")),
            (label: "BOSS", sprite: Some("gatling")),
