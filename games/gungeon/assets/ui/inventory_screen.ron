// Inventaire gungeon (M2-T18, docs/conventions.md §56) : option A du test comparatif d'UI, la
// couche maison étendue. Sections de la vue : `weapons`, `active` + `charge`, `passives`,
// `consumables`, `hint`. L'option B (bevy_hui) est `inventory_screen.html`, même modèle.
(
    font: Some("fonts/FiraMono-Medium.ttf"),
    veil: "#05060ab8",
    root: Column((
        gap: 6.0,
        padding: 24.0,
        width: Some(520.0),
        background: Some("#141414f2"),
        border: Some(("#ffffff55", 2.0)),
        children: [
            Text(bind: "title", size: 30.0, color: "#f1c40f"),
            Label(text: "Armes", size: 16.0, color: "#ffffff88"),
            List(bind: "weapons", size: 20.0, empty: Some("(aucune)")),
            Label(text: "Objet actif", size: 16.0, color: "#ffffff88"),
            List(bind: "active", size: 20.0, empty: Some("(aucun)")),
            Bar(bind: "charge", size: (240.0, 10.0), color: "#f1c40f", text_size: 14.0),
            Label(text: "Passifs", size: 16.0, color: "#ffffff88"),
            List(bind: "passives", size: 20.0, empty: Some("(aucun)")),
            Label(text: "Consommables", size: 16.0, color: "#ffffff88"),
            List(bind: "consumables", size: 20.0, empty: Some("(aucun)")),
            Text(bind: "hint", size: 14.0, color: "#ffffff88"),
        ],
    )),
)
