// Menu de pause (M2-T18, docs/conventions.md §56) : option A du test comparatif d'UI, la couche
// maison étendue. Un arbre de boîtes ; `bind` nomme une section de la vue (`title`, `entries`,
// `detail`, `hint`), lue par `game::ui::screens::custom`. Rechargé à chaud (feature `native`).
// L'option B (bevy_hui) est `pause_screen.html`, même modèle.
(
    font: Some("fonts/FiraMono-Medium.ttf"),
    veil: "#05060ab8",
    root: Column((
        gap: 10.0,
        padding: 24.0,
        width: Some(380.0),
        background: Some("#141414f2"),
        border: Some(("#ffffff55", 2.0)),
        children: [
            Text(bind: "title", size: 30.0, color: "#f1c40f"),
            List(bind: "entries", size: 22.0, color: "#ffffff", focus_color: "#f1c40f", focus_background: "#ffffff22"),
            Text(bind: "detail", size: 16.0, color: "#ffffffaa"),
            Text(bind: "hint", size: 14.0, color: "#ffffff88"),
        ],
    )),
)
