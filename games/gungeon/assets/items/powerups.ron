// `gungeon` (M2-T0d, copie de `throne` T1.11 sans les munitions des armes absentes) : aucun butin
// à la mort (`drop_chance` 0 : l'étage squelette ne laisse tomber que ce que ses scénarios
// placent) ; la table reste là pour M2-T5. Munitions (une par munition, `RefillAmmoOf`, D40), rage et
// vitesse ; pas de `Carpenter` ni de `Nuke` (pas de fenêtres ni de vagues dans une caverne).
(
    drop_chance: "0.0",
    powerups: {
        // D40 : butin par munition (une par munition des armes de throne) : poids 36 (balles),
        // 12 (obus, explosifs, énergie) et 24 (lames), 96 en tout ; rage et vitesse 25 chacune.
        "munitions_balles": (
            name: "Munitions : Balles",
            weight: 36,
            pickup_range: "30.0",
            lifetime_frames: 1800,
            actions: [
                RefillAmmoOf(Custom("balles")),
            ],
        ),
        "rage": (
            name: "Rage",
            weight: 25,
            pickup_range: "30.0",
            lifetime_frames: 1800,
            actions: [
                TimedModifier(stat: Damage, op: Mul, value: "2.0", frames: 600),
            ],
        ),
        "vitesse": (
            name: "Vitesse",
            weight: 25,
            pickup_range: "30.0",
            lifetime_frames: 1800,
            actions: [
                TimedModifier(stat: MoveSpeed, op: Mul, value: "1.3", frames: 600),
            ],
        ),
    },
)
