// `gungeon` (M2-T4, docs/conventions.md §44) : actif chargé par une salle nettoyée ; à l'usage
// (`UseActive`), soigne 20 points, au plus deux fois par étage (`uses_per_floor`).
(
    name: "Pierre de soin",
    kind: Active(Rooms(1)),
    effects: [
        (on: OnUse, do: [Heal("20")]),
    ],
    uses_per_floor: Some(2),
    tags: ["soin"],
    rarity: Uncommon,
)
