// `gungeon` (M2-T0d, docs/conventions.md §3 et §35-§38) : une arme du joueur et l'arsenal des
// ennemis. `pistolet` : munitions « infinies » à la Gungeon — le moteur n'a pas de munition
// infinie (contrat à venir), la réserve est donc de 9999 chargeurs de 12 (jamais épuisée en
// pratique) et le rechargement rapide. Sprites réutilisés du testbed (placeholders, voir
// `assets.yaml`). Chaque arme porte un gabarit `test:` (scénario généré, `make gen GAME=gungeon`).
({
    "pistolet": (
        config: (
            name: "pistolet",
            default_firing_mode: "default",
            ammo_type: Custom("balles"),
            firing_modes: {
                "default": (
                    firing_rate: "3.0",
                    firing_mode: Manual(),
                    spread: "0.001",
                    recoil: "1.0",
                    bullet_type: Standard(
                        damage: "12.0",
                        speed: "380.0",
                    ),
                    range: "700.0",
                    reload_time_seconds: "0.5",
                    mag: Mag(mag_size: 12, mag_limit: 9999),
                )
            },
            test: Some((frames: 200, min_hits: 1)),
        ),
        sprite_config: (
            name: "pistol",
            index: 3,
            bullet_offset_right: ( x: "-5.0", y: "2.0" ),
            bullet_offset_left: ( x: "0.0", y: "-2.0" ),
            weapon_offset: ( x: "0.0", y: "-5.0" )
        ),
    ),
    // Arsenal des ennemis (projectiles de leurs patterns).
    "arsenal": (
        config: (
            name: "arsenal",
            default_firing_mode: "default",
            ammo_type: Custom("balles"),
            firing_modes: {
                "default": (
                    firing_rate: "4.0",
                    firing_mode: Manual(),
                    spread: "0.0",
                    recoil: "0.0",
                    bullet_type: Standard(
                        damage: "10.0",
                        speed: "300.0",
                    ),
                    range: "900.0",
                    reload_time_seconds: "1.0",
                    mag: Mag(mag_size: 30, mag_limit: 4),
                )
            },
            projectiles: {
                // Crachat visé (`cracheur`, `franc_tireur`).
                "crachat": (damage: "6.0", speed: "150.0", range: "320.0"),
                // Plombs en éventail (`arroseur`).
                "plomb": (damage: "4.0", speed: "140.0", range: "260.0"),
                // Couronne lente de la tourelle.
                "boule": (damage: "8.0", speed: "90.0", range: "400.0"),
            },
            test: Some((frames: 200, min_hits: 2)),
        ),
        sprite_config: (
            name: "pistol",
            index: 3,
            bullet_offset_right: ( x: "-5.0", y: "2.0" ),
            bullet_offset_left: ( x: "0.0", y: "-2.0" ),
            weapon_offset: ( x: "0.0", y: "-5.0" )
        ),
    ),
})
