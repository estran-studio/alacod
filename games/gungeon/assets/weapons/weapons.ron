// `gungeon` (M2-T0d, docs/conventions.md §3 et §35-§38) : une arme du joueur et l'arsenal des
// ennemis. `pistolet` : munitions « infinies » à la Gungeon — le moteur n'a pas de munition
// infinie (contrat à venir), la réserve est donc de 9999 chargeurs de 12 (jamais épuisée en
// pratique) et le rechargement rapide. `Automatic` : tenir la gâchette tire en continu (cadence
// 3 tirs/s), ce qui convient aux scénarios scriptés et à la manette. Sprites réutilisés du testbed (placeholders, voir
// `assets.yaml`). Chaque arme porte un gabarit `test:` (scénario généré, `make gen GAME=gungeon`).
({
    "pistolet": (
        config: (
            name: "pistolet",
            default_firing_mode: "default",
            ammo_type: Custom("balles"),
            firing_modes: {
                "default": (
                    firing_rate: "3.0",
                    firing_mode: Automatic(),
                    spread: "0.001",
                    recoil: "1.0",
                    bullet_type: Standard(
                        damage: "12.0",
                        speed: "380.0",
                    ),
                    range: "700.0",
                    reload_time_seconds: "0.5",
                    mag: Mag(mag_size: 12, mag_limit: 9999),
                )
            },
            test: Some((frames: 200, min_hits: 1)),
        ),
        sprite_config: (
            name: "pistol",
