// `gungeon` (M2-T14c, docs/conventions.md §52) : tourelle. Immobile (`stationary`), tire la `croix` (deux
// couronnes de quatre boules lentes, 30 frames d'écart) à moins de 300 unités. Posée dans `CombatNS` et
// dans les vagues de l'arène : un obstacle à contourner plus qu'un ennemi à poursuivre.
(
    movement: (
        acceleration: "120.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "tourelle_kin",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "90.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        stationary: Some(true),
        behaviors: Some([
            Shoot(weapon: "arsenal", pattern: "croix", range: "300.0", cooldown_frames: 150),
        ]),
    )),

    // `docs/conventions.md` §28 : scénarios générés `enemy_<id>_still`/`_moving`
    // (`make gen GAME=gungeon`), attentes par défaut.
    test: Some((frames: 600)),
)
