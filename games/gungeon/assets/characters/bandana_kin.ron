// `gungeon` (M2-T14c, docs/conventions.md §52) : chargeur. Entre 40 et 120 unités du joueur (`attack_range`
// à 3 × `attack_range`), 30 frames immobile (télégraphe) puis ruée en ligne droite à 3 × sa vitesse,
// 15 points de dégât au contact ; sinon `Chase`. Aucun tir. Posé dans `CombatCroix` et dans les vagues de
// l'arène.
(
    movement: (
        acceleration: "120.0",
        max_speed: "60.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "bandana_kin",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "70.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("40.0"),
        attack_cooldown_frames: Some(90),
        attack_damage: Some("15.0"),
        behaviors: Some([Charge(telegraph: 30), Chase(profile: "Ground")]),
    )),

    // `docs/conventions.md` §28 : scénarios générés `enemy_<id>_still`/`_moving`
    // (`make gen GAME=gungeon`), attentes par défaut.
    test: Some((frames: 600)),
)
