// `gungeon` (M2-T8, docs/conventions.md §49) : `bullet_kin` en escouade. Même corps et même
// salve que `bullet_kin`, mais au lieu de `KeepDistance` il prend sa place sur un arc de 40 autour
// du joueur (`Formation`) et ne tire qu'à son tour (fenêtres de 40 frames, alternées entre les
// membres vivants). Posé en trois exemplaires par le gabarit `EscouadeEW` (salle `escouade`).
(
    movement: (
        acceleration: "120.0",
        max_speed: "60.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "bullet_kin_squad",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "40.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        squad: Some(("bullet_kins", Some("arc"))),
        behaviors: Some([
            Shoot(weapon: "arsenal", pattern: "salve", range: "240.0", cooldown_frames: 90),
            Formation(shape: Arc(radius: "40.0", spread: "1.6"), period: 40),
            Chase(profile: "Ground"),
        ]),
    )),
)
