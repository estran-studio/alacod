// `gungeon` (M2-T0d, docs/conventions.md §37) : boss « vide » à deux phases (contrats de M2-T0c),
// immobile : phase 0, une visée (`visee`) toutes les 150 frames ; sous 50 % de santé, phase 1 :
// une couronne (`couronne`) toutes les 90 frames. Les tirs passent par la frise
// (`SpawnPattern` avec la table de projectiles de l'`arsenal`). Le contenu réel (attaques,
// phases supplémentaires, arène à tenir) viendra avec M2-T7.
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "gatling",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "150.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        stationary: Some(true),
    )),

    boss: Some((
        phases: [
            (
                until: Some(HealthBelow("0.5")),
                timeline: Some((
                    events: [(at: 10, do: [SpawnPattern(pattern: "visee", weapon: "arsenal")])],
                    repeat: Some(150),
                )),
            ),
            (
                timeline: Some((
                    events: [(at: 0, do: [SpawnPattern(pattern: "couronne", weapon: "arsenal")])],
                    repeat: Some(90),
                )),
            ),
        ],
    )),
    // `docs/conventions.md` §28 : scénarios générés `enemy_<id>_still`/`_moving` (`make gen`).
    test: Some((frames: 600)),
)
