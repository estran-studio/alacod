// `gungeon` (M2-T14c, docs/conventions.md §52) : lanceur de grenades. Se tient entre 150 et 240 unités
// (`KeepDistance`) et lance une `grenade_lente` : la grenade rebondit une fois et explose en huit éclats
// (table de `arsenal_lourd`). Posé dans `CombatCroix` et dans les vagues de l'arène.
(
    movement: (
        acceleration: "120.0",
        max_speed: "55.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "lanceur_kin",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "45.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {"body": ""}),
    },

    ai: Some((
        aggro_range: Some("500.0"),
        attack_range: Some("0.0"),
        behaviors: Some([
            Shoot(weapon: "arsenal_lourd", pattern: "grenade_lente", range: "280.0", cooldown_frames: 180),
            KeepDistance(min: "150.0", max: "240.0"),
            Chase(profile: "Ground"),
        ]),
    )),

    // `docs/conventions.md` §28 : scénarios générés `enemy_<id>_still`/`_moving`
    // (`make gen GAME=gungeon`), attentes par défaut.
    test: Some((frames: 600)),
)
