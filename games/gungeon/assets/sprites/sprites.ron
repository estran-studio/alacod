// D3 : table des feuilles de sprites (kind `SpriteSheet` de `game.ron`, chargée par
// `content::registry::load_sprite_sheets`, lue par `game::global_asset`). Un id par entrée :
// le `asset_name_ref` d'un personnage, le `sprite_config.name` d'une arme à distance, ou
// `slash` (effet de coup de mêlée). `animation` : configuration d'animation
// (`AnimationMapConfig`) ; `layers` : calque -> feuille (`SpriteSheetConfig`). Chemins relatifs
// à `assets/`. Feuilles et images rangées par entité sous `sprites/` (characters/, weapons/,
// enemies/, effects/) ; voir `docs/conventions.md` §2.
({
    // Langage visuel provisoire (fiche m2-lisibilite-gungeon, docs/conventions.md §83) : une silhouette et une
    // couleur par classe d'entité, générées par script (CC0, placeholders à remplacer par la voie V6). Le bloc
    // ci-dessous est réécrit par `python3 scripts/generer-sprites-gungeon.py`.
    // >>> généré par scripts/generer-sprites-gungeon.py (ne pas éditer à la main)
    "player": (animation: "sprites/lisible/anim/player.ron", layers: { "body": "sprites/lisible/sheet_persos.ron" }),
    "bullet_kin": (animation: "sprites/lisible/anim/bullet_kin.ron", layers: { "body": "sprites/lisible/sheet_persos.ron" }),
    "bullet_kin_squad": (animation: "sprites/lisible/anim/bullet_kin_squad.ron", layers: { "body": "sprites/lisible/sheet_persos.ron" }),
