// `throne` (T1.11, docs/conventions.md §29) : douze armes du joueur sur cinq munitions
// (`Custom("balles")`, `obus`, `explosifs`, `energie`, `lames` : au moins deux armes chacune),
// projectiles composables (T1.1 : `Bounce`, `Pierce`, `Size`, `Lifetime`, `Homing`, `Gravity`,
// `on_expire: Spawn`), plus l'arsenal des ennemis (`arsenal`, projectiles de leurs patterns,
// T1.2). Sprites réutilisés du testbed (placeholders, voir `assets.yaml`). Chaque arme porte un
// gabarit `test:` (scénario généré, `make gen GAME=throne`).
({    // Balles : revolver, coup par coup, précis.
    "revolver": (
        config: (
            name: "revolver",
            default_firing_mode: "default",
            ammo_type: Custom("balles"),
            firing_modes: {
                "default": (
                    firing_rate: "2.0",
                    firing_mode: Manual(),
                    spread: "0.0005",
                    recoil: "1.0",
                    bullet_type: Standard(
                        damage: "15.0",
                        speed: "400.0",
                    ),
                    range: "700.0",
                    reload_time_seconds: "1.0",
                    mag: Mag(mag_size: 6, mag_limit: 16),
                )
            },
            test: Some((frames: 200, min_hits: 1)),
        ),
        sprite_config: (
            name: "pistol",
            index: 3,
            bullet_offset_right: ( x: "-5.0", y: "2.0" ),
            bullet_offset_left: ( x: "0.0", y: "-2.0" ),
            weapon_offset: ( x: "0.0", y: "-5.0" )
        ),
    ),
