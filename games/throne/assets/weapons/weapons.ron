    // Arsenal des ennemis (pas une arme du joueur, aucun ennemi ne la lâche) : sa table
    // `projectiles` fournit les projectiles des patterns de tir (`patterns/`, règle `Shoot`).
    // Tirée par un joueur (scénario généré) : balle ordinaire.
    "arsenal": (
        config: (
            name: "arsenal",
            default_firing_mode: "default",
            ammo_type: Custom("balles"),
            firing_modes: {
                "default": (
                    firing_rate: "4.0",
                    firing_mode: Manual(),
                    spread: "0.0",
                    recoil: "0.0",
