// Manifeste du jeu `throne` (T1.0c + T1.11, docs/conventions.md §29) : le clone, une run de
// trois étages de caverne (mode `Floors`), sans vagues. Sprites, sons, interface et caméra
// copiés du testbed (placeholders, voir `assets.yaml`).
(
    name: "throne",
    content_folders: [
        (path: "characters", kind: "Character"),
        (path: "weapons/weapons.ron", kind: "Weapon"),
        (path: "weapons/melee.ron", kind: "MeleeWeapon"),
        (path: "patterns", kind: "Pattern"),
        // Cavernes générées (`cave:<nom>`) ; le dossier contient aussi le gabarit LDtk
        // `gabarit.ldtk` (tilesets dans `atlas/`).
        (path: "caves", kind: "Cave"),
        (path: "floors", kind: "Floors"),
        (path: "items", kind: "PowerUp"),
        (path: "economy/economy.ron", kind: "Economy"),
        (path: "ui", kind: "Ui"),
        (path: "camera.ron", kind: "Camera"),
        (path: "sprites/sprites.ron", kind: "SpriteSheet"),
    ],
    entry: (
        start_map: "cave:niveau_1",
        default_seed: 123456,
        mode: Floors,
    ),
)
