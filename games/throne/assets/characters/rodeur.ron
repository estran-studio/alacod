// `throne` (T1.11, docs/conventions.md §29) : mêlée errante — `Wander` tant qu'il ne voit personne (rayon
// de proximité `Sight(300)`), puis poursuite et griffes. D66 : il voit aussi un joueur **en ligne de vue
// dégagée** jusqu'à 900 unités (`sight_range`, §22) : sans cela il errait dans son coin, sprite dans un mur,
// à 370 unités d'un joueur qu'il avait en face de lui (cave:niveau_1, graine 4).
(
    movement: (
        acceleration: "120.0",
        max_speed: "60.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "rodeur",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "40.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {"body": "", "shadow": ""}),
    },

    ai: Some((
        attack_range: Some("30.0"),
        behaviors: Some([Melee("griffes"), Chase(profile: "Ground"), Wander]),
        sight_range: Some("900.0"),
        perception: Some((senses: [Sight("300.0")])),
    )),
    // `docs/conventions.md` §28 : scénarios générés `enemy_<id>_still`/`_moving`
    // (`make gen GAME=throne`), attentes par défaut.
    test: Some((frames: 600)),
)
