// `throne` (T1.11, docs/conventions.md §29) : tireur immobile en couronne (pattern `couronne` : `Ring`).
(
    movement: (
        acceleration: "0.0",
        max_speed: "0.0",
        sprint_multiplier: "1.0",
        sprint_acceleration_per_frame: "0.0",
        sprint_deceleration_per_frame: "0.0",

        dash_distance: "0.0",
        dash_duration_frames: 0,
        dash_cooldown_frames: 0,
    ),

    asset_name_ref: "tourelle",

    collider: (
        shape: Rectangle(
            width: "20.",
            height: "20.",
        ),
        offset: ( x: "0.0", y: "-6.0", z: "0.0" )
    ),

    scale: "1.0",

    base_health: (
        max: "150.0",
    ),

    starting_skin: "1",
    skins: {
        "1": (layers: {"body": "", "shadow": ""}),
    },

    // D66 (présentation seule) : sprite de zombie provisoire, la tourelle se lit à sa teinte
    // métallique bleutée et à sa taille (aucun asset nouveau).
    marker: Some((tint: Some((0.55, 0.75, 1.0)), scale: Some(1.25))),

    ai: Some((
        aggro_range: Some("400.0"),
        attack_range: Some("0.0"),
        stationary: Some(true),
        behaviors: Some([
            Shoot(weapon: "arsenal", pattern: "couronne", range: "260.0", cooldown_frames: 120),
        ]),
    )),
    // `docs/conventions.md` §28 : scénarios générés `enemy_<id>_still`/`_moving`
    // (`make gen GAME=throne`), attentes par défaut.
    test: Some((frames: 600)),
)
