// D3 : table des feuilles de sprites (kind `SpriteSheet` de `game.ron`, chargée par
// `content::registry::load_sprite_sheets`, lue par `game::global_asset`). Un id par entrée :
// le `asset_name_ref` d'un personnage, le `sprite_config.name` d'une arme à distance, ou
// `slash` (effet de coup de mêlée). `animation` : configuration d'animation
// (`AnimationMapConfig`) ; `layers` : calque -> feuille (`SpriteSheetConfig`). Chemins relatifs
// à `assets/`. Feuilles et images rangées par entité sous `sprites/` (characters/, weapons/,
// enemies/, effects/) ; voir `docs/conventions.md` §2.
// Surcharge locale : `sprites/sprites.local.ron` (même format, gitignoré), quand il existe, remplace
// les entrées de même id (pack post-apo TheLazyStone non redistribuable, écrit par
// `scripts/repack-postapocalypse.py` ; voir `docs/conventions.md` §2). Sans lui : sprites publics ci-dessous.
({
    "player": (
        animation: "sprites/characters/player/player_animation.ron",
        layers: {
            "body": "sprites/characters/player/player_sheet.ron",
            "shirt": "sprites/characters/player/shirt_1_sheet.ron",
            "hair": "sprites/characters/player/hair_1_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    // Armes à distance : portées par le joueur, animées par l'animation du joueur.
    "shotgun": (
        animation: "sprites/characters/player/player_animation.ron",
        layers: { "body": "sprites/weapons/shotgun_sheet.ron" },
    ),
    "pistol": (
        animation: "sprites/characters/player/player_animation.ron",
        layers: { "body": "sprites/weapons/pistol_sheet.ron" },
    ),
    "machine_gun": (
        animation: "sprites/characters/player/player_animation.ron",
        layers: { "body": "sprites/weapons/machine_gun_sheet.ron" },
    ),
    // Lisibilité coop (S2-8, `game::legibility`, `docs/conventions.md` §83 et §95) : halo pulsant des ramassables (disque doux
    // blanc, teinté par catégorie) et pointeur de visée des ennemis (chevron blanc, teinté en rouge par le moteur). Tuiles 0 et 1
    // de `games/gungeon/assets/sprites/lisible/atlas_monde.png` (CC0, générées par `scripts/generer-sprites-gungeon.py`), reprises telles quelles.
    "halo": (
        animation: "sprites/effects/halo/halo_animation.ron",
        layers: { "body": "sprites/effects/halo/halo_sheet.ron" },
    ),
    "aim": (
        animation: "sprites/effects/aim/aim_animation.ron",
        layers: { "body": "sprites/effects/aim/aim_sheet.ron" },
    ),
    "slash": (
        animation: "sprites/effects/slash/slash_animation.ron",
        layers: { "body": "sprites/effects/slash/slash_sheet.ron" },
    ),
    // Visuels provisoires CC BY 4.0 repris de zombies pour la revue humaine M1.
    "rat": (
        animation: "sprites/enemies/zombie/zombie_animation.ron",
        layers: {
            "body": "sprites/enemies/zombie/zombie_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    "chien": (
        animation: "sprites/enemies/zombie/zombie_animation.ron",
        layers: {
            "body": "sprites/enemies/zombie/zombie_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    "rodeur": (
        animation: "sprites/enemies/zombie/zombie_animation.ron",
        layers: {
            "body": "sprites/enemies/zombie/zombie_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    "pillard": (
        animation: "sprites/enemies/zombie/zombie_animation.ron",
        layers: {
            "body": "sprites/enemies/zombie/zombie_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    "cracheur": (
        animation: "sprites/enemies/zombie/zombie_animation.ron",
        layers: {
            "body": "sprites/enemies/zombie/zombie_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    "franc_tireur": (
        animation: "sprites/enemies/zombie/zombie_animation.ron",
        layers: {
            "body": "sprites/enemies/zombie/zombie_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    "arroseur": (
        animation: "sprites/enemies/zombie/zombie_animation.ron",
        layers: {
            "body": "sprites/enemies/zombie/zombie_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    "tourelle": (
        animation: "sprites/enemies/zombie/zombie_animation.ron",
        layers: {
            "body": "sprites/enemies/zombie/zombie_hard_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    "brute": (
        animation: "sprites/enemies/zombie/zombie_animation.ron",
        layers: {
            "body": "sprites/enemies/zombie/zombie_hard_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    "buffle": (
        animation: "sprites/enemies/zombie/zombie_animation.ron",
        layers: {
            "body": "sprites/enemies/zombie/zombie_hard_sheet.ron",
            "shadow": "sprites/characters/shadow/shadow_sheet.ron",
        },
    ),
    // Voie t (polissage-throne-vitrine, docs/conventions.md § 105) : images publiques, scripts/repack-throne-cc0.py, licences dans assets.yaml.
    // Roi rat : Redshrike, OpenGameArt, CC BY 4.0 (« Art by Redshrike, for OpenGameArt.org »).
    "roi_rat": (animation: "sprites/vitrine/roi_rat_animation.ron", layers: { "body": "sprites/vitrine/roi_rat_sheet.ron", "shadow": "sprites/characters/shadow/shadow_sheet.ron" }),
    // Portail de l'étage : LetargicDev, OpenGameArt, CC0.
    "portal": (animation: "sprites/vitrine/portail_animation.ron", layers: { "body": "sprites/vitrine/portail_sheet.ron" }),
    // Armes : knekko, OpenGameArt, CC0. `weapon/<id>` au sol, `held/<id>` en main (cherché avant `sprite_config.name`, ui::weapon_visuals).
    "weapon/revolver": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_revolver_sol_sheet.ron" }),
    "held/revolver": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_revolver_main_sheet.ron" }),
    "weapon/mitraillette": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_mitraillette_sol_sheet.ron" }),
    "held/mitraillette": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_mitraillette_main_sheet.ron" }),
    "weapon/fusil_a_pompe": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_fusil_a_pompe_sol_sheet.ron" }),
    "held/fusil_a_pompe": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_fusil_a_pompe_main_sheet.ron" }),
    "weapon/canon_ricochet": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_canon_ricochet_sol_sheet.ron" }),
    "held/canon_ricochet": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_canon_ricochet_main_sheet.ron" }),
    "weapon/lance_grenades": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_lance_grenades_sol_sheet.ron" }),
    "held/lance_grenades": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_lance_grenades_main_sheet.ron" }),
    "weapon/roquette": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_roquette_sol_sheet.ron" }),
    "held/roquette": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_roquette_main_sheet.ron" }),
    "weapon/mortier": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_mortier_sol_sheet.ron" }),
    "held/mortier": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_mortier_main_sheet.ron" }),
    "weapon/laser": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_laser_sol_sheet.ron" }),
    "held/laser": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_laser_main_sheet.ron" }),
    "weapon/plasma": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_plasma_sol_sheet.ron" }),
    "held/plasma": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_plasma_main_sheet.ron" }),
    "weapon/traqueur": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_traqueur_sol_sheet.ron" }),
    "held/traqueur": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_traqueur_main_sheet.ron" }),
    "weapon/lance_lames": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_lance_lames_sol_sheet.ron" }),
    "held/lance_lames": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_lance_lames_main_sheet.ron" }),
    "weapon/disque": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_disque_sol_sheet.ron" }),
    "held/disque": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_disque_main_sheet.ron" }),
    "weapon/arsenal": (animation: "sprites/vitrine/arme_animation.ron", layers: { "body": "sprites/vitrine/arme_arsenal_sol_sheet.ron" }),
    "held/arsenal": (animation: "sprites/characters/player/player_animation.ron", layers: { "body": "sprites/vitrine/arme_arsenal_main_sheet.ron" }),
})
