// Feedback (présentation seule, docs/conventions.md §7 et §31). `hit_flash.color` multiplie
// la couleur des calques : au-delà de 1.0 le sprite est surexposé ((1, 1, 1) serait invisible).
// `hit_stop_frames` : frames de rendu gelées (animations, caméra) quand un joueur local touche
// ou est touché ; la simulation continue.
(
    hit_flash: (
        frames: 4,
        color: (2.5, 2.5, 2.5),
    ),
    shake: (
        frames: 8,
        amplitude: 12.0,
    ),
    hit_stop_frames: 2,
    damage_numbers: true,
    telegraph: (color: (1.0, 0.3, 0.2, 0.8)),
    // S1-6 (polissage-feel, docs/conventions.md §94) : flash de bouche, recul visuel de l'arme (le sprite
    // seul, la balle part droit) et éclats de mort. Présentation seule. Throne : armes variées et plus
    // lourdes que celles de zombies, flash plus gros et recul plus marqué ; explosifs et fusil à pompe au maximum.
    muzzle_flash: Some((frames: 3, size: 12.0, color: (1.0, 0.8, 0.35, 0.95))),
    recoil: Some((distance: 3.0, frames: 6)),
    // Surcharges par arme (prioritaires sur `by_kind`) : les explosifs secouent aussi quand le
    // joueur local touche (secousse de surcharge).
    by_weapon: {
        "lance_grenades": (hit_stop_frames: Some(6), shake: Some((frames: 16, amplitude: 20.0)), muzzle_flash: Some((frames: 5, size: 18.0, color: (1.0, 0.7, 0.3, 1.0))), recoil: Some((distance: 6.0, frames: 12))),
        "roquette": (hit_stop_frames: Some(6), shake: Some((frames: 16, amplitude: 20.0)), muzzle_flash: Some((frames: 5, size: 18.0, color: (1.0, 0.7, 0.3, 1.0))), recoil: Some((distance: 6.0, frames: 12))),
        "fusil_a_pompe": (hit_stop_frames: Some(4), muzzle_flash: Some((frames: 4, size: 18.0, color: (1.0, 0.8, 0.35, 1.0))), recoil: Some((distance: 5.0, frames: 10))),
        "mitraillette": (muzzle_flash: Some((frames: 2, size: 9.0, color: (1.0, 0.8, 0.35, 0.9))), recoil: Some((distance: 1.5, frames: 4))),
        "laser": (muzzle_flash: Some((frames: 3, size: 12.0, color: (0.5, 0.9, 1.0, 0.95))), recoil: Some((distance: 1.0, frames: 4))),
        "plasma": (muzzle_flash: Some((frames: 4, size: 14.0, color: (0.6, 1.0, 0.5, 0.95))), recoil: Some((distance: 4.0, frames: 8))),
    },
    death: (enabled: true, count: 10, size: 3.0, color: (0.35, 0.55, 0.12, 1.0)),
    sounds: {
        // Sons de base. Tir : clé de la famille du mode de tir actif (Manual : shot_pistol,
        // Shotgun : shot_shotgun, Automatic/Burst : shot_smg), repli sur "shot". Une arme
        // remplace le tir et le rechargement de chacun de ses modes par son `audio_config`
        // (weapons.ron), au volume de la clé qu'il remplace (`volumes`).
        "shot_pistol": "sounds/shot_pistol.ogg",
        "shot_shotgun": "sounds/shot_shotgun.ogg",
        "shot_smg": "sounds/shot_smg.ogg",
        "reload": "sounds/reload.ogg",
        // Événements (lot B) : coup porté par un joueur local, dégâts reçus, ennemi tué, dash,
        // porte ouverte.
        "hit": "sounds/hit.ogg",
        "melee": "sounds/melee.ogg",
        "hurt": "sounds/hurt.ogg",
        "death": "sounds/death.ogg",
        "dash": "sounds/dash.ogg",
        "door": "sounds/door.ogg",
        // S2-11 : événements de la run. **Repli public** (Kenney impact, CC0 ; Snake's pour `explosion`), choisi sans écoute, de ce que la
        // surcharge locale `ui/feedback.local.ron` remplace par des sons Sonniss (pas de redistribution, jamais dans le dépôt). Morts :
        // seules les machines ont un repli propre ; rongeurs, bêtes, humains et brute retombent sur `death`. Armes : `audio_config` de
        // `weapons.ron` (un tir par arme, un rechargement par famille).
        "death_player": "sounds/death_player.ogg",
        "death_tourelle": "sounds/death_machine.ogg",
        "death_arroseur": "sounds/death_machine.ogg",
        "death_mannequin": "sounds/death_machine.ogg",
        "death_cible": "sounds/death_machine.ogg",
        "boss_spawn": "sounds/boss_spawn.ogg",
        "boss_phase": "sounds/boss_phase.ogg",
        "boss_death": "sounds/boss_death.ogg",
        "floor": "sounds/floor.ogg",
        "room_cleared": "sounds/room_cleared.ogg",
        "explosion": "sounds/explosion.ogg",
        "bomb": "sounds/bomb.ogg",
        "blank": "sounds/blank.ogg",
        "purchase": "sounds/purchase.ogg",
        "pickup": "sounds/pickup.ogg",
        "menu_navigate": "sounds/menu_navigate.ogg",
        "menu_confirm": "sounds/menu_confirm.ogg",
        "menu_back": "sounds/menu_back.ogg",
    },
    // Volume par clé de `sounds`, en dB (0 : inchangé ; plage -60 à +12), ex. {"hit": -3.0}.
    // -12 dB partout (2026-10-16, retour de William : tout trop fort par défaut ;
    // les fichiers des lots A/B sont normalisés à -3 dBFS crête).
    // S2-11 (départ, RMS cible de `scripts/repack-throne-sons.py`) : morts de machines -6, mort du joueur -9, boss -6, étage -8, explosion -6,
    // bombe -10, blank -9, salle -9, achat et ramassage -8, menus -11. Un tir prend le volume de la clé de sa famille (`shot_pistol` pour
    // toute arme à tir manuel) : les lanceurs sont donc normalisés 2 dB plus fort, l'énergie 2 dB plus bas.
    volumes: {"shot_pistol": -12.0, "shot_shotgun": -12.0, "shot_smg": -12.0, "reload": -12.0, "hit": -12.0, "melee": -9.0, "hurt": -12.0, "death": -6.0, "dash": -12.0, "door": -12.0, "death_player": -9.0, "death_tourelle": -6.0, "death_arroseur": -6.0, "death_mannequin": -6.0, "death_cible": -6.0, "boss_spawn": -6.0, "boss_phase": -6.0, "boss_death": -6.0, "floor": -8.0, "room_cleared": -9.0, "explosion": -6.0, "bomb": -10.0, "blank": -9.0, "purchase": -8.0, "pickup": -8.0, "menu_navigate": -11.0, "menu_confirm": -11.0, "menu_back": -11.0},
)
