    card_size: (220.0, 180.0),
    slots: [(-232.0, 0.0), (0.0, 0.0), (232.0, 0.0)],
    name_size: 17.0,
    text_size: 15.0,
    card_color: "#141414e6",
    highlight_color: "#f1c40f",
    text_color: "#ffffff",
    bar_offset: (0.0, 110.0),
    bar_size: (480.0, 6.0),
    bar_color: "#f1c40f",
    hint: "← → choisir · Entrée / A valider",
    hint_offset: (0.0, 135.0),
)
