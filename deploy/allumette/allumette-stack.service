[Unit]
Description=Allumette signaling, HTTPS and TURN stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/allumette
ExecStart=/usr/bin/docker compose --env-file /opt/allumette/.env -f /opt/allumette/compose.yaml up -d
ExecStop=/usr/bin/docker compose --env-file /opt/allumette/.env -f /opt/allumette/compose.yaml down
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
