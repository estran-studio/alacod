// Capture seulement (polissage-throne-vitrine, jamais rejoué par `make test_scenarios` : hors de tests/scenarios) :
// chaque joueur porte une seule arme de throne (« plasma, traqueur, lance_lames, disque »), la lâche à f25 puis s'éloigne.
// À regarder : f15 l'arme dans la main (`held/<id>`), f110 l'arme au sol (`weapon/<id>`).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "throne",
    map: "gabarit_armes.ldtk",
    mode: Some(Sandbox),
    frames: 120,
    players: [
        (weapon: "plasma", inputs: [
            (from: 10, to: 20, buttons: [], pan: (-64, 0)),
            (from: 25, to: 28, buttons: [DropWeapon]),
            (from: 40, to: 70, buttons: [Left]),
        ]),
        (weapon: "traqueur", inputs: [
            (from: 10, to: 20, buttons: [], pan: (64, 0)),
            (from: 25, to: 28, buttons: [DropWeapon]),
            (from: 40, to: 70, buttons: [Right]),
        ]),
        (weapon: "lance_lames", inputs: [
            (from: 10, to: 20, buttons: [], pan: (-64, 0)),
            (from: 25, to: 28, buttons: [DropWeapon]),
            (from: 40, to: 70, buttons: [Left]),
        ]),
        (weapon: "disque", inputs: [
            (from: 10, to: 20, buttons: [], pan: (64, 0)),
            (from: 25, to: 28, buttons: [DropWeapon]),
            (from: 40, to: 70, buttons: [Right]),
        ]),
    ],
    expect: [],
)
