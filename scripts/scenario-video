#!/usr/bin/env bash
# Vidéos des scénarios (tests/scenarios/*.ron) : capture déterministe frame par frame
# (play_scenario --capture) puis encodage et montage avec ffmpeg.
#
#   scenario-video render [noms...]          une vidéo par scénario (tous par défaut) ;
#                                            noms séparés par des espaces ou des virgules,
#                                            DRY_RUN=1 : liste sans compiler ni capturer
#   scenario-video montage                   grille de toutes les vidéos rendues
#   scenario-video compare <nom> <réf> [réf2] avant/après côte à côte : le scénario joué
#                                            par le code de <réf> et de <réf2> (défaut : HEAD)
#   scenario-video views <nom> [n]           la même partie vue par chacun des n joueurs
#                                            (caméra --follow), côte à côte : <nom>.vues.mp4
#   scenario-video index                     regénère la page de revue target/videos/index.html
#
# Un nom de scénario est cherché dans tests/scenarios/<nom>.ron puis dans les scénarios générés
# (tests/scenarios/generated/<jeu>/<nom>.ron, `make gen`) ; `<jeu>/<nom>` désigne un généré sans
# ambiguïté (un même nom dans deux jeux est une erreur qui liste les chemins).
# Le rendu hors écran demande un GPU (Vulkan, ou Metal sous macOS) : sans lui, le script s'arrête
# avant de compiler, avec un message. DRY_RUN=1 (render, views, compare) affiche la résolution des
# noms et s'arrête là, sans GPU ni compilation.
#
# Sorties dans target/videos/<commit>/ (compare : target/videos/compare/).
# EVERY=N : une image toutes les N frames de simulation (défaut 2 → 30 images/s).
set -euo pipefail
# Une compilation qui échoue dans `player="$(build_player …)"` doit arrêter le script : sans
# cette option, bash ignore `set -e` dans une substitution de commande et la capture se fait
# avec le binaire de la compilation précédente.
shopt -s inherit_errexit

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
EVERY="${EVERY:-2}"
FPS=$((60 / EVERY))
FONT="$(fc-match -f '%{file}' monospace)"
export APP_VERSION="${APP_VERSION:-dev}"

if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q h264_nvenc; then
    ENCODER=(-c:v h264_nvenc -preset p5 -cq 23)
else
    ENCODER=(-c:v libx264 -preset medium -crf 20)
fi

# Compile play_scenario dans le dépôt (ou worktree) $1 ; affiche le chemin du binaire.
build_player() {
    local repo="$1"
    # Bevy dynamique (outillage-build, scripts/dev-features.sh) quand la référence compilée a la
    # feature (`compare` compile aussi d'anciens commits, sans) ; le binaire a alors besoin de
    # libbevy_dylib.so (LD_LIBRARY_PATH, exporté ici pour tous les lancements de capture).
    local dev=""
    if grep -q 'dev-dylib' "$repo/crates/game/Cargo.toml" 2>/dev/null; then
        dev="$("$ROOT/scripts/dev-features.sh" features)"
    fi
    (cd "$repo" && cargo build -q --profile headless -p scenario --features render $dev --bin play_scenario >&2)
    local libs
    libs="$("$ROOT/scripts/dev-features.sh" libpath)"
    export LD_LIBRARY_PATH="$libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export DYLD_LIBRARY_PATH="$libs${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
    echo "${CARGO_TARGET_DIR:-$ROOT/target}/headless/play_scenario"
}

# capture <binaire> <scenario.ron> <dossier images>
capture() {
    rm -rf "$3"
    local log status=0
    log="$(mktemp)"
    "$1" "$2" --capture "$3" --every "$EVERY" "${@:4}" >"$log" 2>&1 || status=$?
    if [ "$status" -ne 0 ]; then
        echo "capture en échec (code $status) pour $2" >&2
        if grep -qiE 'no suitable (graphics )?adapter|vulkan|wgpu.*(adapter|instance)|RequestAdapterError' "$log"; then
            echo "cause probable : GPU (Vulkan) absent ou inutilisable ; capturer sur un poste avec GPU." >&2
        fi
        tail -n 15 "$log" >&2
        rm -f "$log"
        return "$status"
    fi
    rm -f "$log"
}

# encode <dossier images> <sortie.mp4> <étiquette>
encode() {
    local label="${3//:/\\:}"
    # Un ffmpeg sans `drawtext` (Homebrew 9.x sans freetype) encode sans l'étiquette plutôt que d'échouer.
    local vf="drawtext=fontfile=$FONT:fontsize=20:fontcolor=white:box=1:boxcolor=black@0.6:boxborderw=6:x=10:y=10:text='$label  frame %{eif\:n*$EVERY\:d}'"
    if ! ffmpeg -hide_banner -filters 2>/dev/null | grep -q ' drawtext '; then
        echo "avertissement : ffmpeg sans drawtext, vidéo sans étiquette" >&2
        vf="null"
    fi
    ffmpeg -hide_banner -loglevel error -y -framerate "$FPS" -pattern_type glob -i "$1/frame_*.png" \
        -vf "$vf" -pix_fmt yuv420p "${ENCODER[@]}" "$2"
}

# resolve_scenario <nom> : chemin du .ron d'un scénario (D60). Ordre : tests/scenarios/<nom>.ron,
# puis tests/scenarios/generated/<jeu>/<nom>.ron ; `<jeu>/<nom>` désigne un généré. Un nom présent
# dans plusieurs jeux est une erreur qui liste les chemins. Code de retour 1 si inconnu.
resolve_scenario() {
    local name="$1" dir="$ROOT/tests/scenarios" found=() f
    if [ -f "$dir/$name.ron" ]; then
        echo "$dir/$name.ron"
        return 0
    fi
    case "$name" in
        */*)
            if [ -f "$dir/generated/$name.ron" ]; then
                echo "$dir/generated/$name.ron"
                return 0
            fi
            echo "scénario inconnu : $name (ni tests/scenarios/$name.ron ni tests/scenarios/generated/$name.ron)" >&2
            return 1
            ;;
    esac
    for f in "$dir"/generated/*/"$name.ron"; do
        [ -f "$f" ] && found+=("$f")
    done
    case ${#found[@]} in
        0)
            echo "scénario inconnu : $name (tests/scenarios/$name.ron et tests/scenarios/generated/*/$name.ron absents)" >&2
            return 1
            ;;
        1) echo "${found[0]}" ;;
        *)
            echo "scénario ambigu : $name existe dans plusieurs jeux, préciser <jeu>/$name :" >&2
            printf '  %s\n' "${found[@]#"$ROOT"/}" >&2
            return 1
            ;;
    esac
}

# Nom de fichier d'un nom de scénario (`jeu/nom` → `jeu__nom`).
scenario_slug() {
    printf '%s\n' "${1//\//__}"
}

# Noms de scénarios, un par ligne. D23 : chaque argument peut en contenir plusieurs, séparés
# par des virgules ou des espaces (`make videos SCENARIO=a,b` comme `SCENARIO="a b"`). Sans
# argument : tous les scénarios de tests/scenarios/ (pas les générés). Un nom introuvable ou
# ambigu arrête le script avant toute compilation.
scenario_names() {
    if [ $# -gt 0 ]; then
        local arg name
        for arg in "$@"; do
            for name in ${arg//,/ }; do
                resolve_scenario "$name" >/dev/null || return 1
                printf '%s\n' "$name"
            done
        done
    else
        for f in "$ROOT"/tests/scenarios/*.ron; do basename "$f" .ron; done
    fi
}

# D60 : le rendu hors écran a besoin d'un GPU. Vérifié avant toute compilation (Vulkan : un pilote
# ICD déclaré ou `vulkaninfo` qui répond ; macOS : Metal, rien à vérifier).
require_gpu() {
    [ "$(uname -s)" = Darwin ] && return 0
    if command -v vulkaninfo >/dev/null 2>&1 && vulkaninfo --summary >/dev/null 2>&1; then
        return 0
    fi
    if ! command -v vulkaninfo >/dev/null 2>&1 && compgen -G "/usr/share/vulkan/icd.d/*.json" >/dev/null; then
        return 0
    fi
    if ! command -v vulkaninfo >/dev/null 2>&1 && compgen -G "/etc/vulkan/icd.d/*.json" >/dev/null; then
        return 0
    fi
    cat >&2 <<'MSG'
GPU absent : le rendu hors écran (play_scenario --capture) demande un GPU Vulkan, et aucun pilote
n'est installé ou ne répond ici (`vulkaninfo --summary` échoue ou n'existe pas, aucun ICD dans
/usr/share/vulkan/icd.d ni /etc/vulkan/icd.d). Faire la capture sur un poste avec GPU
(ou installer mesa-vulkan-drivers, rendu logiciel lent). DRY_RUN=1 vérifie seulement la résolution
des noms de scénarios, sans GPU.
MSG
    return 1
}

cmd_render() {
    local commit out player names name slug
    names="$(scenario_names "$@")"
    # DRY_RUN=1 : affiche les scénarios qui seraient rendus, sans compiler ni capturer.
    if [ -n "${DRY_RUN:-}" ]; then
        for name in $names; do
            printf 'à rendre : %s (%s)\n' "$name" "$(resolve_scenario "$name" | sed "s|^$ROOT/||")"
        done
        exit 0
    fi
    require_gpu
    commit="$(git -C "$ROOT" rev-parse --short HEAD)$(git -C "$ROOT" diff --quiet || echo "-dirty")"
    out="$ROOT/target/videos/$commit"
    mkdir -p "$out"
    player="$(build_player "$ROOT")"
    for name in $names; do
        echo "→ $name"
        slug="$(scenario_slug "$name")"
        capture "$player" "$(resolve_scenario "$name")" "$out/frames/$slug"
        encode "$out/frames/$slug" "$out/$slug.mp4" "$name  $commit"
        cp "$out/frames/$slug/events.json" "$out/$slug.events.json" 2>/dev/null || true
        rm -rf "$out/frames/$slug"
    done
    rmdir "$out/frames" 2>/dev/null || true
    echo "vidéos dans $out"
}

# Nombre de joueurs d'un scénario : entrées de `players: [ ... ]` (parenthèses de niveau 1).
player_count() {
    python3 - "$1" <<'PY'
import re, sys
s = re.sub(r"//.*", "", open(sys.argv[1]).read())
i = s.index("players:"); i = s.index("[", i); depth = 0; n = 0
for ch in s[i:]:
    if ch == "[":
        depth += 1
    elif ch == "]":
        depth -= 1
        if depth == 0:
            break
    elif ch == "(" and depth == 1:
        n += 1
print(n)
PY
}

# views <nom> [n] : la même partie capturée une fois par joueur avec la caméra sur lui
# (play_scenario --follow, T1.10), puis les n vues assemblées côte à côte (2 colonnes) —
# toutes de la même durée, contrairement au montage de scénarios différents. Les moments
# clés sont ceux de la capture du joueur 0 (identiques pour tous : même simulation).
cmd_views() {
    local name="$1" n="${2:-}" commit out player i cols scenario slug
    scenario="$(resolve_scenario "$name")"
    slug="$(scenario_slug "$name")"
    if [ -n "${DRY_RUN:-}" ]; then
        printf 'à rendre (vues) : %s (%s)\n' "$name" "${scenario#"$ROOT"/}"
        exit 0
    fi
    require_gpu
    commit="$(git -C "$ROOT" rev-parse --short HEAD)$(git -C "$ROOT" diff --quiet || echo "-dirty")"
    out="$ROOT/target/videos/$commit"
    mkdir -p "$out"
    player="$(build_player "$ROOT")"
    [ -n "$n" ] || n="$(player_count "$scenario")"
    [ "$n" -ge 1 ] || { echo "aucun joueur dans $name" >&2; exit 1; }
    cols=2; [ "$n" -lt 2 ] && cols=1
    local inputs=() filter="" layout=""
    for ((i = 0; i < n; i++)); do
        echo "→ $name, vue du joueur $i"
        rm -rf "$out/frames/$slug.p$i"
        capture "$player" "$scenario" "$out/frames/$slug.p$i" --follow "$i"
        encode "$out/frames/$slug.p$i" "$out/frames/$slug.p$i.mp4" "$name  joueur $i"
        inputs+=(-i "$out/frames/$slug.p$i.mp4")
        filter+="[$i:v]scale=960:540[v$i];"
        if [ "$i" -gt 0 ]; then layout+="|"; fi
        layout+="$(( (i % cols) * 960 ))_$(( (i / cols) * 540 ))"
    done
    local streams
    streams="$(for ((i = 0; i < n; i++)); do printf '[v%s]' "$i"; done)"
    if [ "$n" -eq 1 ]; then
        filter+="[v0]null[out]"
    else
        filter+="${streams}xstack=inputs=$n:layout=$layout:fill=black[out]"
    fi
    ffmpeg -hide_banner -loglevel error -y "${inputs[@]}" -filter_complex "$filter" -map "[out]" \
        -pix_fmt yuv420p "${ENCODER[@]}" "$out/$slug.vues.mp4"
    cp "$out/frames/$name.p0/events.json" "$out/$slug.vues.events.json" 2>/dev/null || true
    rm -rf "$out/frames/$slug".p*
    rmdir "$out/frames" 2>/dev/null || true
    echo "vues : $out/$slug.vues.mp4"
}

cmd_montage() {
    local commit out
    commit="$(git -C "$ROOT" rev-parse --short HEAD)$(git -C "$ROOT" diff --quiet || echo "-dirty")"
    out="$ROOT/target/videos/$commit"
    mapfile -t videos < <(ls "$out"/*.mp4 | grep -v '/montage.mp4$')
    local n=${#videos[@]}
    [ "$n" -gt 0 ] || { echo "aucune vidéo dans $out : lancer d'abord render" >&2; exit 1; }

    # Grille de 2 colonnes, chaque vidéo en 480x270, prolongée sur sa dernière image
    local inputs=() filter="" layout="" i cols=2
    for i in "${!videos[@]}"; do
        inputs+=(-i "${videos[$i]}")
        filter+="[$i:v]scale=480:270,tpad=stop_mode=clone:stop_duration=3600[v$i];"
        if [ "$i" -gt 0 ]; then layout+="|"; fi
        layout+="$(( (i % cols) * 480 ))_$(( (i / cols) * 270 ))"
    done
    local streams
    streams="$(for i in "${!videos[@]}"; do printf '[v%s]' "$i"; done)"
    if [ "$n" -eq 1 ]; then
        filter+="[v0]null[out]"
    else
        filter+="${streams}xstack=inputs=$n:layout=$layout:fill=black[out]"
    fi
    local longest
    longest="$(for v in "${videos[@]}"; do ffprobe -v error -show_entries format=duration -of csv=p=0 "$v"; done | sort -g | tail -1)"
    ffmpeg -hide_banner -loglevel error -y "${inputs[@]}" -filter_complex "$filter" -map "[out]" \
        -t "$longest" -pix_fmt yuv420p "${ENCODER[@]}" "$out/montage.mp4"
    echo "montage : $out/montage.mp4"
}

cmd_compare() {
    local name="$1" base="$2" head="${3:-HEAD}"
    local scenario slug
    scenario="$(resolve_scenario "$name")" || exit 1
    slug="$(scenario_slug "$name")"
    if [ -n "${DRY_RUN:-}" ]; then
        printf 'à comparer : %s (%s) entre %s et %s\n' "$name" "${scenario#"$ROOT"/}" "$base" "$head"
        exit 0
    fi
    require_gpu
    local out="$ROOT/target/videos/compare"
    mkdir -p "$out"

    # Les attentes ne servent pas à la vidéo, et un ancien commit peut ne pas connaître les
    # plus récentes : on joue le scénario sans elles
    local playable="$out/$slug.playable.ron"
    python3 - "$scenario" "$playable" <<'PY'
import re, sys
text = open(sys.argv[1]).read()
open(sys.argv[2], "w").write(re.sub(r"\n\s*expect:\s*\[.*?\n\s*\],", "", text, flags=re.S))
PY

    local side sides=() ref sha tree player
    for side in base head; do
        ref="$([ "$side" = base ] && echo "$base" || echo "$head")"
        sha="$(git -C "$ROOT" rev-parse --short "$ref")"
        if [ "$ref" = HEAD ]; then
            tree="$ROOT"
        else
            tree="$ROOT/target/videos/worktrees/$sha"
            [ -d "$tree" ] || git -C "$ROOT" worktree add -q --detach "$tree" "$sha"
        fi
        echo "→ $name joué par $ref ($sha)"
        # Même scénario (celui du dépôt courant) pour les deux côtés : seuls le code et les
        # assets changent. Le target partagé évite de recompiler les dépendances.
        # Les crates du workspace (`utils`, `game`…) ont le même hash de compilation dans les
        # deux arbres (cargo le calcule sur le chemin relatif au workspace), donc le même
        # emplacement dans le target partagé, et leur empreinte renvoie aux sources de l'arbre
        # compilé en dernier : sans `touch` des deux arbres, cargo juge à jour les
        # bibliothèques compilées pour l'autre côté.
        local t
        for t in "$ROOT" "$ROOT"/target/videos/worktrees/*; do
            if [ -d "$t/crates" ]; then
                find "$t/crates" "$t/games" -name '*.rs' -exec touch {} + 2>/dev/null || true
            fi
        done
        player="$(CARGO_TARGET_DIR="$ROOT/target" build_player "$tree")"
        capture "$player" "$playable" "$out/frames/$side"
        encode "$out/frames/$side" "$out/$side.mp4" "$ref ($sha)"
        cp "$out/frames/$side/events.json" "$out/$side.events.json" 2>/dev/null || echo "[]" > "$out/$side.events.json"
        sides+=("$out/$side.mp4")
    done

    local result="$out/${slug}_$(git -C "$ROOT" rev-parse --short "$base")_vs_$(git -C "$ROOT" rev-parse --short "$head").mp4"
    ffmpeg -hide_banner -loglevel error -y -i "${sides[0]}" -i "${sides[1]}" -filter_complex \
        "[0:v]tpad=stop_mode=clone:stop_duration=3600[a];[1:v]tpad=stop_mode=clone:stop_duration=3600[b];[a][b]hstack=inputs=2[out]" \
        -map "[out]" -t "$(for v in "${sides[@]}"; do ffprobe -v error -show_entries format=duration -of csv=p=0 "$v"; done | sort -g | tail -1)" \
        -pix_fmt yuv420p "${ENCODER[@]}" "$result"
    mv "$out/base.events.json" "${result%.mp4}.base.events.json"
    mv "$out/head.events.json" "${result%.mp4}.head.events.json"
    rm -rf "$out/frames" "${sides[@]}" "$playable"
    echo "comparaison : $result"
}

case "${1:-}" in
    render) shift; cmd_render "$@" ;;
    montage) shift; cmd_montage ;;
    views) shift; [ $# -ge 1 ] || { echo "usage : scenario-video views <nom> [n]" >&2; exit 1; }; cmd_views "$@" ;;
    compare) shift; [ $# -ge 2 ] || { echo "usage : scenario-video compare <nom> <réf> [réf2]" >&2; exit 1; }; cmd_compare "$@" ;;
    index) ;;
    *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

# Page de revue (target/videos/index.html) à jour après chaque commande
"$ROOT/scripts/scenario-review.py"
