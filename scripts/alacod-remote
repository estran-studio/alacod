#!/usr/bin/env python3
"""Client du contrôle remote d'alacod (jeu lancé avec ALACOD_REMOTE=1).

  alacod-remote state                     état complet (JSON)
  alacod-remote brief                     résumé d'une ligne par joueur + ennemis proches
  alacod-remote input Up,Fire --pan 100,0 [--handle 0]   input maintenu (vide = relâcher ; en mode
                                          éditeur, relâcher rend la main au clavier)
  alacod-remote step 30 [--no-wait]       avance de 30 frames, attend, affiche le résumé
  alacod-remote pause | resume
  alacod-remote screenshot /tmp/x.png
  alacod-remote save tests/scenarios/ma_session.ron
  alacod-remote restart [--kind K] [--seed N]   relance la partie (Restart|ToLobby|EnterRun|ToHub) [mode éditeur]
  alacod-remote modifier [--handle 0|--net-id N] STAT OP VALEUR [--until FRAMES] [--source editor]
                                          modificateur vivant (OP : Add|Pct|Mul|Set ; VALEUR : « 0.9 »)
  alacod-remote unmodify [--handle 0|--net-id N] [--source editor]   retire les modificateurs de la source
  alacod-remote reload                    relit le registre de contenu (appliqué au prochain restart)
  alacod-remote spawn <personnage> (--at X,Y | --ahead [PX]) [--team T] [--variant V] [--handle N]
  alacod-remote spawn-powerup <id> (--at X,Y | --ahead [PX])
  alacod-remote spawn-item <id> (--at X,Y | --ahead [PX])
  alacod-remote discover                  méthodes du remote (rpc.discover, OpenRPC), puis ses paramètres

Boutons : Up Down Left Right Fire SwitchWeapon SwitchWeaponMode Reload Sprint Dash
Modifier Interaction Melee. Port : ALACOD_REMOTE_PORT (15702 par défaut).
"""
import argparse, json, math, os, sys, time, urllib.request

URL = f"http://127.0.0.1:{os.environ.get('ALACOD_REMOTE_PORT', '15702')}"


def call(method, params=None):
    body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}).encode()
    req = urllib.request.Request(URL, body, {"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=10) as resp:
        answer = json.load(resp)
    if "error" in answer:
        sys.exit(f"erreur {method} : {answer['error']}")
    return answer["result"]


def brief(state):
    lines = []
    if "editor" in state:  # éditeur K5-1 : mode et garde d'abord
        run = (state.get("run") or {}).get("step")
        lines.append(
            f"editor={state['editor']} online={state['online']} check_distance={state['check_distance']} "
            f"run.step={run} jeu={state.get('game')} carte={state.get('map')} graine={state.get('seed')}"
        )
    lines += [f"frame {state['frame']}  pause={state['clock']['paused']}  vague={state['wave']}"]
    for p in state["players"]:
        w = p.get("weapon") or {}
        lines.append(
            f"joueur {p['handle']} ({p['x']},{p['y']}) pv {p['health']}/{p['max_health']} "
            f"arme {w.get('name')} {w.get('ammo')}x{w.get('reserve')}{' recharge' if w.get('reloading') else ''}"
        )
        near = sorted(state["enemies"], key=lambda e: math.dist((e["x"], e["y"]), (p["x"], p["y"])))[:5]
        for e in near:
            dx, dy = e["x"] - p["x"], e["y"] - p["y"]
            lines.append(f"  ennemi {e['id']} {e.get('config') or ''} dx={dx:.0f} dy={dy:.0f} dist={math.hypot(dx, dy):.0f} pv {e['health']} {e['state']}")
    lines.append(f"ennemis {len(state['enemies'])}, fenêtres {[w['health'] for w in state['windows']]}")
    if state.get("commands"):
        lines.append("commandes en attente: " + ", ".join(f"{c['frame']}:{c['kind']}" for c in state["commands"]))
    return "\n".join(lines)


def discover(doc):
    """Une ligne par méthode (nom, résumé), ses paramètres en dessous quand le document en donne."""
    lines = []
    for m in sorted(doc.get("methods", []), key=lambda m: m["name"]):
        summary = m.get("summary") or m.get("description") or ""
        lines.append(f"{m['name']}  {summary}".rstrip())
        for prm in m.get("params", []):
            schema = prm.get("schema") or {}
            kind = schema.get("type") or schema.get("$ref", "").rsplit("/", 1)[-1]
            req = "" if prm.get("required") else " (optionnel)"
            lines.append(f"    {prm['name']}: {kind}{req}")
    return "\n".join(lines)


FACING = {"Right": (1, 0), "UpRight": (1, 1), "Up": (0, 1), "UpLeft": (-1, 1),
          "Left": (-1, 0), "DownLeft": (-1, -1), "Down": (0, -1), "DownRight": (1, -1)}


def resolve_position(args):
    """`--at X,Y` tel quel ; `--ahead [PX]` : position du joueur `--handle` avancée de PX dans son `facing`."""
    if (args.at is None) == (args.ahead is None):
        sys.exit("donner --at X,Y ou --ahead [PX]")
    if args.at is not None:
        x, y = (float(v) for v in args.at.split(",", 1))
        return x, y
    player = next((p for p in call("alacod/state")["players"] if p["handle"] == args.handle), None)
    if player is None:
        sys.exit(f"joueur {args.handle} absent")
    dx, dy = FACING.get(player.get("facing") or "Right", (1, 0))
    norm = math.hypot(dx, dy)
    return player["x"] + args.ahead * dx / norm, player["y"] + args.ahead * dy / norm


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("state")
    sub.add_parser("brief")
    p = sub.add_parser("input")
    p.add_argument("buttons", nargs="?", default="")
    p.add_argument("--pan", default=None, help="visée dx,dy ; absente avec des boutons vides = relâcher (mode éditeur)")
    p.add_argument("--handle", type=int, default=0)
    p = sub.add_parser("step")
    p.add_argument("frames", type=int)
    p.add_argument("--no-wait", action="store_true")
    sub.add_parser("pause")
    sub.add_parser("resume")
    p = sub.add_parser("screenshot")
    p.add_argument("path")
    p = sub.add_parser("save")
    p.add_argument("path")
    sub.add_parser("discover")
    p = sub.add_parser("restart")
    p.add_argument("--kind", choices=["Restart", "ToLobby", "EnterRun", "ToHub"])
    p.add_argument("--seed", type=int)
    p = sub.add_parser("modifier")
    p.add_argument("stat")
    p.add_argument("op", choices=["Add", "Pct", "Mul", "Set"])
    p.add_argument("value")
    p.add_argument("--handle", type=int)
    p.add_argument("--net-id", type=int)
    p.add_argument("--until", type=int, help="durée en frames (permanent sinon)")
    p.add_argument("--source", default="editor")
    p = sub.add_parser("unmodify")
    p.add_argument("--handle", type=int)
    p.add_argument("--net-id", type=int)
    p.add_argument("--source", default="editor")
    sub.add_parser("reload")
    p = sub.add_parser("spawn")
    p.add_argument("character")
    p.add_argument("--at")
    p.add_argument("--ahead", type=float, nargs="?", const=60.0, help="devant le joueur (PX, 60 par défaut)")
    p.add_argument("--handle", type=int, default=0)
    p.add_argument("--team")
    p.add_argument("--variant")
    p = sub.add_parser("spawn-powerup")
    p.add_argument("id")
    p.add_argument("--at")
    p.add_argument("--ahead", type=float, nargs="?", const=60.0, help="devant le joueur (PX, 60 par défaut)")
    p.add_argument("--handle", type=int, default=0)
    p = sub.add_parser("spawn-item")
    p.add_argument("id")
    p.add_argument("--at")
    p.add_argument("--ahead", type=float, nargs="?", const=60.0, help="devant le joueur (PX, 60 par défaut)")
    p.add_argument("--handle", type=int, default=0)
    args = parser.parse_args()

    if args.cmd == "state":
        print(json.dumps(call("alacod/state"), indent=1))
    elif args.cmd == "brief":
        print(brief(call("alacod/state")))
    elif args.cmd == "input":
        buttons = [b for b in args.buttons.split(",") if b]
        params = {"handle": args.handle, "buttons": buttons}
        if args.pan is not None:
            params["pan"] = [int(v) for v in args.pan.split(",")]
        print(call("alacod/input", params))
    elif args.cmd == "step":
        target = call("alacod/step", {"frames": args.frames})["target_frame"]
        if not args.no_wait:
            deadline = time.time() + 60
            while call("alacod/state")["frame"] < target and time.time() < deadline:
                time.sleep(0.02)
            print(brief(call("alacod/state")))
    elif args.cmd in ("pause", "resume"):
        print(call(f"alacod/{args.cmd}"))
    elif args.cmd == "screenshot":
        print(call("alacod/screenshot", {"path": os.path.abspath(args.path)}))
    elif args.cmd == "restart":
        params = {k: v for k, v in (("kind", args.kind), ("seed", args.seed)) if v is not None}
        print(json.dumps(call("alacod/restart", params)))
    elif args.cmd == "modifier":
        params = {"stat": args.stat, "op": args.op, "value": args.value, "source": args.source}
        if args.handle is not None:
            params["handle"] = args.handle
        if args.net_id is not None:
            params["net_id"] = args.net_id
        if args.until is not None:
            params["until_frames"] = args.until
        print(json.dumps(call("alacod/set_modifier", params)))
    elif args.cmd == "unmodify":
        params = {"source": args.source}
        if args.handle is not None:
            params["handle"] = args.handle
        if args.net_id is not None:
            params["net_id"] = args.net_id
        print(json.dumps(call("alacod/clear_modifiers", params)))
    elif args.cmd == "reload":
        result = call("alacod/reload_content")
        print(json.dumps(result))
        if result.get("errors"):
            sys.exit(1)
    elif args.cmd in ("spawn", "spawn-powerup", "spawn-item"):
        x, y = resolve_position(args)
        params = {"x": x, "y": y}
        if args.cmd == "spawn":
            params["character"] = args.character
            if args.team is not None:
                params["team"] = args.team
            if args.variant is not None:
                params["variant"] = args.variant
            method = "alacod/spawn_character"
        else:
            params["id"] = args.id
            method = "alacod/" + args.cmd.replace("-", "_")
        print(json.dumps(call(method, params)))
    elif args.cmd == "discover":
        print(discover(call("rpc.discover")))
    elif args.cmd == "save":
        print(call("alacod/save_recording", {"path": os.path.abspath(args.path)}))


if __name__ == "__main__":
    main()
