// Budgets de performance : planchers de NON-RÉGRESSION en frames simulées par seconde, par
// scénario. Ce ne sont pas des objectifs : la moitié de la mesure au calme, arrondie à l'unité. Ils ne
// bloquent que `make bench` (ALACOD_BENCH_STRICT=1) ; `make test_scenarios` se contente d'avertir.
// Relevés le 2026-10-14 (perf-suite-scenarios) sur la mesure de la suite complète en un
// processus, machine cloud de 4 cœurs au calme, profil headless : exécuteur monothread, champs
// de flux partagés (docs/conventions.md §5). Avant : idle 54, bench_floor 38, ammo_burst 155
// (poste de dev de 2026-09-28), bench_bullets 44 ; après : idle 225, bench_floor 90,
// ammo_burst 253, bench_bullets 162. Quatre tranches en parallèle partagent la mémoire : un
// plancher à la moitié de la mesure y reste tenable.
//
// D84 + M3-T15 : recalibrage au poste de référence VPS Debian 8 cœurs (partagé), 2026-10-17/18, suite complète en un
// processus, profil headless, `make bench` strict. Cinq relevés (charge de `uptime` au départ -> à la fin) : 1) 23:06
// 2,73 -> 2,59 ; 2) 23:59 2,25 -> 1,78 ; 3) 00:44 1,78 -> 1,28 ; 4) 01:25 0,14 -> 5,16 (un autre worker lance un build en
// fin de suite) ; 5) 02:04 0,77 -> 2,82. Le processus de bench pèse lui-même ~1,1 de charge. Les relevés 1 et 2 (charge
// externe 1 à 1,6) tournent jusqu'à 2 fois plus lentement que le 4 : ils ne servent qu'à vérifier la tenue des planchers sous charge. Mesure de
// référence = la PIRE valeur des relevés 3, 4 et 5 (les moins chargés) ; plancher = la moitié de cette mesure, plafond de
// rollback = le double. Détail : docs/taches/rapports/m3-t15-bench-larmes.md. Les M4 de 2026-10-15 (docs/etat-engine.md)
// ne sont plus la référence : ces budgets sont ceux de ce poste, un poste plus rapide les passe avec de la marge.
(
    default: (min_sim_fps: 40.0),
    scenarios: {
        // M2-T10 : étage assemblé de 15 à 20 salles, deux bots (mesure du 2026-10-12 : 18 sim fps
        // sur une machine partagée, 37 ennemis et 282 entités au plus ; gungeon_floor_seed_1 : 30).
        "bench_floor": (min_sim_fps: 25.0, max_rollback_ms: 49.0),
        // m2-full-run : la run complète (hub, deux étages, victoire), VPS Debian 8 cœurs, 2026-10-16, chaque
        // scénario seul, trois mesures (charge 1,4 à 2,0 au départ, dont mon propre processus), pire retenu :
        // 2 joueurs 51,4 / 48,9 / 48,3 fps et 21,5 / 22,4 / 22,7 ms ; 4 joueurs 44,6 / 41,1 / 40,8 fps et
        // 23,3 / 25,0 / 25,4 ms. Plafond de rollback = 2 × le pire, plancher = la moitié du pire.
        "gungeon_full_run": (min_sim_fps: 24.0, max_rollback_ms: 46.0),
        "gungeon_full_run_four": (min_sim_fps: 20.0, max_rollback_ms: 51.0),
        // M2-T16 : un étage `court` joué par des bots (mesure cloud du 2026-10-14 : 38 et 37).
        "bot_explorer_floor": (min_sim_fps: 55.0),
        "bot_explorer_two": (min_sim_fps: 57.0),
        // M2-T17 : scénarios générés d'objets, de salle et de boss (mesure cloud du 2026-10-14 :
        // 35 à 42 sim fps ; les objets ne jouent que 60 frames, démarrage compris).
        "item_bottes": (min_sim_fps: 20.0),
        "item_fiole": (min_sim_fps: 20.0),
        "item_pierre_de_soin": (min_sim_fps: 20.0),
        "item_lame": (min_sim_fps: 20.0),
        "room_combat": (min_sim_fps: 25.0),
        "boss_gatling": (min_sim_fps: 25.0),
        "ammo_burst": (min_sim_fps: 56.0),
        "bullets_walls": (min_sim_fps: 52.0),
        "dash_wall": (min_sim_fps: 67.0),
        "door_open": (min_sim_fps: 45.0),
        "idle": (min_sim_fps: 59.0),
        "movement_melee": (min_sim_fps: 65.0),
        "remote_first_fight": (min_sim_fps: 67.0),
        "shoot_around": (min_sim_fps: 65.0),
        "two_players_idle": (min_sim_fps: 56.0),
        "two_players_shooting": (min_sim_fps: 66.0),
        "weapons_workout": (min_sim_fps: 56.0),
        "window_repair": (min_sim_fps: 65.0),
        // quatre joueurs (mesures du 2026-09-29 : 179 et 209)
        "four_players_idle": (min_sim_fps: 54.0),
        "four_players_shooting": (min_sim_fps: 49.0),
        // T2.9, testbed (mesures du 2026-09-29 : ally_safe 214, arena_idle 230,
        // civilian_blocks 218, corridor_idle 282, dummy_shoot 224, follower 234,
        // target_hits 220, two_rooms_door_idle 281, window 269)
        "testbed_ally_safe": (min_sim_fps: 82.0),
        "testbed_arena_idle": (min_sim_fps: 87.0),
        "testbed_civilian_blocks": (min_sim_fps: 72.0),
        "testbed_corridor_idle": (min_sim_fps: 98.0),
        "testbed_dummy_shoot": (min_sim_fps: 78.0),
        "testbed_follower": (min_sim_fps: 86.0),
        "testbed_target_hits": (min_sim_fps: 78.0),
        "testbed_two_rooms_door_idle": (min_sim_fps: 78.0),
        "testbed_window": (min_sim_fps: 88.0),
        // T2.1, chantier B4b (grille spatiale) : bench_bullets (4 joueurs, mitrailleuse
        // chargeur énorme/cadence maximale, ~155 balles vivantes) et bench_horde (4 joueurs,
        // 60+ ennemis dès la vague 1). Planchers = moitié de la mesure sur la branche
        // (2026-09-29), mais mesurée avec un job CFD externe (simpleFoam, 6-7 processus à
        // ~98% CPU chacun, sans rapport avec cette tâche) saturant 6-7 des 12 coeurs de la
        // machine : mesures anormalement basses (bench_bullets 24.7-31.3 fps, bench_horde
        // 20.3-21.3 fps) par rapport à une machine calme (bench_bullets a atteint 158 fps,
        // bench_horde 64.7 fps, avant que ce job n'apparaisse dans la même session). Ces deux
        // planchers sont donc plus prudents (bas) que la convention habituelle : à resserrer
        // une fois une mesure propre disponible (voir le rapport de la tâche T2.1).
        "bench_bullets": (min_sim_fps: 40.0, max_rollback_ms: 30.0),
        // M2-T1 : ~535 balles ENNEMIES vivantes (testbed, salle verrouillée, 3 tourelles de brume). Mesure
        // du 2026-10-11 sur la machine chargée (trois suites en parallèle) : 34 fps ; plancher
        // à confirmer au calme (`make bench`).
        "bench_bullets_room": (min_sim_fps: 28.0, max_rollback_ms: 58.0),
        // Les trois scénarios throne les plus lourds (mesures du 2026-10-14 : 28, 40 et 53 fps).
        "throne_quad": (min_sim_fps: 14.0),
        "throne_three_floors": (min_sim_fps: 20.0),
        "throne_softlock_recul": (min_sim_fps: 26.0),
        // `max_rollback_ms` : plafond du pire rollback en ligne (restauration + 12 frames
        // resimulées, `Metrics::rollback_ms_worst`), au double de la pire mesure des relevés 3 à 5 du poste
        // VPS (voir l'en-tête : bench_bullets 14,9 ms ; bench_bullets_room 28,7 ; bench_cave 9,6 ; bench_floor
        // 24,1 ; bench_horde 46,6). Le 2026-10-15 le poste M4 donnait 3,9 ; 13,0 ; 2,1 ; 8,8 ; 35,3.
        // Même régime que `min_sim_fps`.
        "bench_horde": (min_sim_fps: 20.0, max_rollback_ms: 94.0),
        // M3-T15 (docs/conventions.md §80), même poste et mêmes relevés. Pire des relevés 3 à 5 (fps ; save/load/
        // simulation par frame ; pire rollback ; snapshot max) : bench_tears 33,7 fps, 4,46 / 3,57 / 4,39 ms, 56,3 ms,
        // 218 KiB, 432 balles ; bench_tears_trio 97,4 fps, 1,69 / 1,08 / 1,02, 13,3 ms, 42 KiB ; bench_familiars 89,2 fps,
        // 1,79 / 1,07 / 0,97, 12,7 ms, 20 KiB ; bench_floor_isaac 57,2 fps, 2,63 / 1,80 / 1,43, 18,9 ms, 53 KiB.
        // bench_tears dépasse 16,7 ms × 3 (D89 : population de larmes de `Split`) ; le plafond n'est pas un objectif.
        "bench_tears": (min_sim_fps: 17.0, max_rollback_ms: 113.0),
        "bench_tears_trio": (min_sim_fps: 49.0, max_rollback_ms: 27.0),
        "bench_familiars": (min_sim_fps: 45.0, max_rollback_ms: 26.0),
        "bench_floor_isaac": (min_sim_fps: 29.0, max_rollback_ms: 38.0),
        // T1.6 : caverne destructible (quatre joueurs, six followers, ≥ 50 destructions) ; plancher
        // par défaut, mesure sous charge (200 graines en parallèle, load 20) : 62,7 le 2026-10-04.
        "bench_cave": (min_sim_fps: 53.0, max_rollback_ms: 20.0),
    },
)
