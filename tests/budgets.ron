// Budgets de performance : planchers de NON-RÉGRESSION en frames simulées par seconde et plafonds du pire rollback, par
// scénario. Ce ne sont pas des objectifs. Ils ne bloquent que `make bench` (ALACOD_BENCH_STRICT=1) ;
// `make test_scenarios` se contente d'avertir.
//
// RÈGLE (D84, dette-d84-budgets-calme, 2026-10-18) : plancher = moitié (arrondie au-dessus, à l'entier) de la PIRE des trois
// mesures `make bench` strict ; plafond de rollback = double (arrondi au-dessus) de la PIRE des trois. Poste de référence :
// VPS Debian 8 cœurs (profil headless, un processus, tests/budgets.ron relu par `make bench`). Les trois relevés (2026-10-18,
// 14:10 à 17:36 UTC) sont dans docs/taches/rapports/m3-t15-bench-larmes.md, section « D84 au calme » ; charge : la charge
// 1 min du processus de bench seul est de 2 à 3 (il occupe 1,5 à 2 cœurs), pointes à 10 à 14 ; hors bench, 26 à 43 % d'un
// cœur en médiane, pointes à 3 cœurs (hermes, chrome, node : outillage de l'orchestrateur).
// Les anciens planchers (macOS arm64 et cloud 4 cœurs, 2026-09 à 2026-10) sont remplacés.
// Les scénarios `generated/<jeu>/<nom>` sont désignés par leur id complet (une clé « item_bottes » ne correspondait à rien :
// ces scénarios retombaient sur le défaut).
(
    default: (min_sim_fps: 40.0),
    scenarios: {
        // M2-T10 / m2-salles-murs-gungeon : étage assemblé (gabarits gungeon agrandis ×1,9 à ×5,5), deux bots ; la run complète
        // (hub, deux étages, victoire) à deux et quatre joueurs.
        "bench_floor": (min_sim_fps: 18.0, max_rollback_ms: 74.0),
        "gungeon_full_run": (min_sim_fps: 21.0, max_rollback_ms: 50.0),
        "gungeon_full_run_four": (min_sim_fps: 15.0, max_rollback_ms: 60.0),
        // M2-T16 : un étage `court` joué par des bots.
        "bot_explorer_floor": (min_sim_fps: 38.0),
        "bot_explorer_two": (min_sim_fps: 32.0),
        // M2-T17 : scénarios générés d'objets, de salle et de boss (60 frames pour les objets, démarrage compris).
        "generated/gungeon/boss_gatling": (min_sim_fps: 31.0),
        "generated/gungeon/item_bottes": (min_sim_fps: 44.0),
        "generated/gungeon/item_fiole": (min_sim_fps: 46.0),
        "generated/gungeon/item_pierre_de_soin": (min_sim_fps: 39.0),
        "generated/gungeon/room_combat": (min_sim_fps: 32.0),
        "generated/isaac/room_combat": (min_sim_fps: 30.0),
        "generated/testbed/item_bottes": (min_sim_fps: 38.0),
        "generated/testbed/item_fiole": (min_sim_fps: 43.0),
        "generated/testbed/item_lame": (min_sim_fps: 42.0),
        "generated/testbed/room_combat": (min_sim_fps: 35.0),
        // Scénarios M0 et quatre joueurs.
        "ammo_burst": (min_sim_fps: 38.0),
        "bullets_walls": (min_sim_fps: 41.0),
        "dash_wall": (min_sim_fps: 40.0),
        "door_open": (min_sim_fps: 32.0),
        "idle": (min_sim_fps: 41.0),
        "movement_melee": (min_sim_fps: 36.0),
        "remote_first_fight": (min_sim_fps: 44.0),
        "shoot_around": (min_sim_fps: 39.0),
        "two_players_idle": (min_sim_fps: 37.0),
        "two_players_shooting": (min_sim_fps: 37.0),
        "weapons_workout": (min_sim_fps: 38.0),
        "window_repair": (min_sim_fps: 36.0),
        "four_players_idle": (min_sim_fps: 33.0),
        "four_players_shooting": (min_sim_fps: 33.0),
        // T2.9, testbed.
        "testbed_ally_safe": (min_sim_fps: 44.0),
        "testbed_arena_idle": (min_sim_fps: 48.0),
        "testbed_civilian_blocks": (min_sim_fps: 46.0),
        "testbed_corridor_idle": (min_sim_fps: 49.0),
        "testbed_dummy_shoot": (min_sim_fps: 43.0),
        "testbed_follower": (min_sim_fps: 45.0),
        "testbed_target_hits": (min_sim_fps: 46.0),
        "testbed_two_rooms_door_idle": (min_sim_fps: 45.0),
        "testbed_window": (min_sim_fps: 40.0),
        // T2.1 et M2-T1 : bench_bullets (4 joueurs, ~155 balles), bench_bullets_room (~535 balles ennemies) ; T1.6 : bench_cave ;
        // bench_horde (4 joueurs, 60+ ennemis dès la vague 1) ; plafonds de rollback au double du pire.
        "bench_bullets": (min_sim_fps: 26.0, max_rollback_ms: 47.0),
        "bench_bullets_room": (min_sim_fps: 20.0, max_rollback_ms: 84.0),
        "bench_horde": (min_sim_fps: 18.0, max_rollback_ms: 107.0),
        "bench_cave": (min_sim_fps: 35.0, max_rollback_ms: 31.0),
        // Throne les plus lourds.
        "throne_quad": (min_sim_fps: 23.0),
        "throne_three_floors": (min_sim_fps: 27.0),
        "throne_softlock_recul": (min_sim_fps: 29.0),
        // M3-T15 (docs/conventions.md §80) : larmes, familiers, étage isaac (plus provisoires).
        "bench_tears": (min_sim_fps: 14.0, max_rollback_ms: 145.0),
        "bench_tears_trio": (min_sim_fps: 35.0, max_rollback_ms: 41.0),
        "bench_familiars": (min_sim_fps: 36.0, max_rollback_ms: 31.0),
        "bench_floor_isaac": (min_sim_fps: 27.0, max_rollback_ms: 42.0),
    },
)
