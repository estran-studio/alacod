// M3-T5 (docs/conventions.md §70) : la salle secrète d'une grille s'ouvre à la bombe. Graine 8 (séquence
// `sous_sol_un`) : la salle secrète est la case **au sud du départ**, voisine du départ et d'un combat. Le joueur
// (une bombe, rayon 50, mèche 20 frames, tir ami coupé : `PlayerScript::bomb` et `items`, `isaac` n'en donne pas au
// départ) descend vers le mur (f5 à f25), pose la bombe (f30, effective f35), repart vers le sud (f70 à f200).
//
// À regarder : la porte est fermée (`DoorLocked` vrai à f40) ; l'explosion (f55, rayon 50) ouvre **toutes** les portes
// de la salle secrète (`DoorLocked` faux à f60) ; le joueur entre dans la salle secrète et s'arrête contre son mur sud
// (y ≈ -192). Témoin sans bombe : `grid_secret_no_bomb`.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    map_seed: 8,
    floors: Some("sous_sol_un"),
    frames: 300,
    players: [
        (
            bomb: (fuse_frames: 20, radius: "50.0", damage: "10.0", friendly_fire: Never),
            items: ["bomb"],
            inputs: [
                (from: 5, to: 25, buttons: [Down], pan: (0, 0)),
                (from: 30, to: 31, buttons: [Bomb]),
                (from: 70, to: 200, buttons: [Down], pan: (0, 0)),
            ],
        ),
    ],
    expect: [
        RoomLayout(kind: "secrete", touches: ["depart", "combat"], at_frame: 5),
        DoorLocked(kind: "secrete", locked: true, at_frame: 40),
        PlayerPosition(handle: 0, x: -8, y: -48, tolerance: 1.5, at_frame: 45),
        Event(kind: "explosion", by_frame: 60),
        DoorLocked(kind: "secrete", locked: false, at_frame: 60),
        Consumable(handle: 0, id: "bomb", count: 0, at_frame: 60),
        PlayerPosition(handle: 0, x: -5.5, y: -192, tolerance: 1.5, at_frame: 299),
    ],
)
