// M3-T5 (docs/conventions.md §70) : la salle secrète d'une grille s'ouvre à la bombe. Graine 39 (séquence `sous_sol_un`,
// M3-T11d1 : vingt gabarits ; graine 8 avant) : la salle secrète est la case **au sud du départ**, voisine du départ et d'un
// combat. Le joueur utilise **la bombe de départ de `pleureur`** (D81 : `starting_consumables`, `bomb`, aucun champ de
// scénario : mèche 75 frames, rayon 56, 4 PV, tir ami). Il descend vers le mur (f5 à f25), pose la bombe (f30, effective f35),
// s'écarte vers le nord (f40 à f70 : il sort du rayon avant l'explosion), attend, puis redescend (f120 à f260).
//
// À regarder : le compteur de bombes passe de 1 à 0 (f20, f60) ; la porte est fermée (`DoorLocked` vrai à f100) ; l'explosion
// (f110) ouvre **toutes** les portes de la salle secrète (`DoorLocked` faux à f115) sans blesser le joueur (6/6) ; il entre
// dans la salle secrète et s'arrête contre son mur sud. Témoin sans pose : `grid_secret_no_bomb`.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    map_seed: 39,
    floors: Some("sous_sol_un"),
    frames: 340,
    players: [
        (
            inputs: [
                (from: 5, to: 25, buttons: [Down], pan: (0, 0)),
                (from: 30, to: 31, buttons: [Bomb]),
                (from: 40, to: 70, buttons: [Up], pan: (0, 0)),
                (from: 120, to: 260, buttons: [Down], pan: (0, 0)),
            ],
        ),
    ],
    expect: [
        RoomLayout(kind: "secrete", touches: ["depart", "combat"], at_frame: 5),
        Consumable(handle: 0, id: "bomb", count: 1, at_frame: 20),
        DoorLocked(kind: "secrete", locked: true, at_frame: 100),
        Consumable(handle: 0, id: "bomb", count: 0, at_frame: 60),
        Event(kind: "explosion", by_frame: 120),
        DoorLocked(kind: "secrete", locked: false, at_frame: 115),
        Health(handle: 0, min: 6.0, max: 6.0, at_frame: 130),
        PlayerPosition(handle: 0, x: -4, y: -191.3, tolerance: 1.5, at_frame: 339),
        PlayerPosition(handle: 0, x: -8, y: -48, tolerance: 1.5, at_frame: 45),
    ],
)
