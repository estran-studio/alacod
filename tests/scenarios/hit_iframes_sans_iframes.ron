    powerup_drop_chance_override: "0.0",
    characters: [
        (character: "iframes_temoin", x: "520.0", y: "696.0", at_frame: 5),
    ],
    players: [
        (inputs: [
            (from: 10, to: 11, buttons: [Fire], pan: (176, 0)),
            (from: 20, to: 21, buttons: [Fire], pan: (176, 0)),
        ]),
    ],
    expect: [
        EntityHealth(net_id: 36, min: 4984.0, max: 4984.0, at_frame: 40),
    ],
)
