// D40 (throne, conventions §14) : butin par munition, `RefillAmmoOf`. Le pilote tire à la
// mitraillette (balles) puis recharge : réserve de balles entamée. `munitions_lames` ramassé à
// f70 ne touche pas aux balles ; `munitions_balles` ramassé à f120 remplit chargeur et réserve de
// balles. Carte gabarit de throne en mode `Sandbox` (le manifeste de throne est en `Floors`).
//
// À regarder : le joueur tire une demi-seconde, recharge, puis deux objets apparaissent sous lui.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "throne",
    map: "gabarit_armes.ldtk",
    mode: Some(Sandbox),
    frames: 200,
    players: [
        (inputs: [
            (from: 10, to: 40, buttons: [Fire], pan: (-64, 48)),
            (from: 50, to: 52, buttons: [Reload]),
        ]),
    ],
    powerups: [
        (id: "munitions_lames", x: "423.0", y: "695.0", at_frame: 70),
        (id: "munitions_balles", x: "423.0", y: "695.0", at_frame: 120),
    ],
    expect: [
        // CALIBRER
        AmmoReserve(handle: 0, ammo_type: Custom("balles"), amount: 0, at_frame: 65),
        AmmoReserve(handle: 0, ammo_type: Custom("balles"), amount: 0, at_frame: 100),
        AmmoReserve(handle: 0, ammo_type: Custom("balles"), amount: 0, at_frame: 130),
        AmmoReserve(handle: 0, ammo_type: Custom("lames"), amount: 0, at_frame: 65),
        AmmoReserve(handle: 0, ammo_type: Custom("lames"), amount: 0, at_frame: 100),
        Ammo(handle: 0, ammo: 0, at_frame: 45),
        Ammo(handle: 0, ammo: 0, at_frame: 130),
        PowerUpPickups(max: 0, at_frame: 130),
    ],
)
