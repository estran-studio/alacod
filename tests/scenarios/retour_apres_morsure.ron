// X-6b (testbed, conventions §119) : `biter_returner` = [ReturnHome(wait: 30, speed ×2), Melee("zombie_claws"), Chase], placé à 118 unités à
// l'est du joueur 0 immobile (424, 696). Il poursuit (`Chase`), mord au corps à corps, puis le coup de mêlée déclenche le retour : il recule face au
// joueur jusqu'à son point d'apparition (542, 696), attend 30 frames, puis repart à la poursuite.
//
// À regarder : le rôdeur approche, mord, recule à reculons, attend, recommence.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/arena.ldtk",
    frames: 400,
    characters: [(character: "biter_returner", x: "542.0", y: "696.0", at_frame: 1)],
    players: [(inputs: [])],
    expect: [
        EnemyState(entity: Placed(0), behavior: "Chase", at_frame: 20),
        // Mordu : le joueur perd des PV (griffe 7,5), puis le rôdeur recule et attend à son point d'apparition (moins d'une case).
        Health(handle: 0, max: 92.6, at_frame: 100),
        EnemyState(entity: Placed(0), behavior: "ReturnHome", at_frame: 150),
        EnemyPosition(entity: Placed(0), x_min: Some(526.0), x_max: Some(558.0), y_min: Some(680.0), y_max: Some(712.0), at_frame: 150),
        // L'attente finie, il repart à la poursuite, mord de nouveau et revient.
        EnemyState(entity: Placed(0), behavior: "Chase", at_frame: 200),
        EnemyPosition(entity: Placed(0), x_max: Some(520.0), at_frame: 200),
        Health(handle: 0, max: 85.1, at_frame: 399),
        EnemyPosition(entity: Placed(0), x_min: Some(526.0), x_max: Some(558.0), y_min: Some(680.0), y_max: Some(712.0), at_frame: 300),
    ],
)
