// M3-T2 (docs/conventions.md §67) : `Scaled(PerCopy)` : trois `empile`, un coup (f30) : l'effet s'exécute une fois,
// par le premier exemplaire, ×3 : +3 de dégâts (1 + 3 = 4), pas +9.
//
// À regarder : les dégâts passent de 1 à 4 au coup. Témoin : `effect_scale_per_copy_temoin` (un seul exemplaire : 2).

Scenario(
    game: "testbed",
    map: "testbed/props_room.ldtk",
    frames: 150,
    powerup_drop_chance_override: "0",
    characters: [(character: "target", x: "560.0", y: "-194.0", at_frame: 1)],
    players: [
        (
            inputs: [(from: 30, to: 32, buttons: [Fire], pan: (-127, 0))],
            weapon: "pistol",
            items: ["empile", "empile", "empile"],
        ),
    ],
    expect: [
        Stat(handle: 0, stat: Damage, value: 1.0, at_frame: 29),
        Stat(handle: 0, stat: Damage, value: 4.0, at_frame: 100),
    ],
)
