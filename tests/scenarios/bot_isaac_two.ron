// M3-T14 (docs/conventions.md §79), recalé par M3-T11d1 (§76.4) : deux bots `explorateur` jouent ensemble un étage d'`isaac` (séquence `sous_sol_un`,
// graine 39 : salle secrète au sud du départ, boutique, pas de salle du diable), chacun avec **la bombe de départ réelle** (D81 ; le kit d'essai de T14
// n'existe plus) et la politique de `bot.ron`.
//
// À regarder : les deux bots arrivent ensemble au mur secret ; **un seul** pose sa bombe (f19 : le joueur 0, le plus petit handle ; avant la règle des
// pairs, `GoalContext::peers`, les deux en posaient une), l'explosion (f93) ouvre le mur, le joueur 1 garde sa bombe ; ils nettoient les trois
// combats, le joueur 1 ouvre le coffre secret (f1073) et le joueur 0 celui du trésor (f1452) ; le joueur 0 achète les **trois** présentoirs de la
// boutique (f1755, f1773, f1792 : 15 sous chacun) ; le boss meurt (victoire f2224).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    map_seed: 39,
    floors: Some("sous_sol_un"),
    frames: 2500,
    explorer: Some((
        shopping: true,
        shop: HeartsThenCheapest(low_health: "0.5"),
        shells: Some(400),
        devil: Never,
        bombs: (secret: true, secret_min_neighbours: 2, rocks: true, reserve: 0),
        anti_jitter: true,
        combat_aware: true,
    )),
    players: [(bot: explorateur), (bot: explorateur)],
    expect: [
        RoomLayout(kind: "secrete", touches: ["depart", "combat"], at_frame: 5),
        Consumable(handle: 0, id: "bomb", count: 1, at_frame: 10),
        Consumable(handle: 1, id: "bomb", count: 1, at_frame: 10),
        Consumable(handle: 0, id: "bomb", count: 0, at_frame: 30),
        Consumable(handle: 1, id: "bomb", count: 1, at_frame: 30),
        DoorLocked(kind: "secrete", locked: true, at_frame: 85),
        DoorLocked(kind: "secrete", locked: false, at_frame: 100),
        Health(handle: 0, min: 6.0, max: 6.0, at_frame: 110),
        Health(handle: 1, min: 6.0, max: 6.0, at_frame: 110),
        EventAfter(kind: "chest", after_frame: 94, by_frame: 1200),
        ShelfCount(count: 3, at_frame: 10),
        Shelf(nth: 0, sold: Some(false), at_frame: 1700),
        Shelf(nth: 0, sold: Some(true), at_frame: 1800),
        Shelf(nth: 1, sold: Some(true), at_frame: 1800),
        Shelf(nth: 2, sold: Some(true), at_frame: 1800),
        Event(kind: "victory", by_frame: 2300),
        PlayerAlive(handle: 0, at_frame: 2499),
        PlayerAlive(handle: 1, at_frame: 2499),
    ],
)
