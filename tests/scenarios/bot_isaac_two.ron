// M3-T14 (docs/conventions.md §79), recalé par M3-T11d1 (§76.4) : deux bots `explorateur` jouent ensemble un étage d'`isaac` (séquence `sous_sol_un`,
// graine 39 : salle secrète au sud du départ, boutique, pas de salle du diable), chacun avec **la bombe de départ réelle** (D81 ; le kit d'essai de T14
// n'existe plus) et la politique de `bot.ron`.
//
// À regarder : les deux bots arrivent ensemble au mur secret ; **un seul** pose sa bombe (f51 : le joueur 0, le plus petit handle ; avant la règle des
// pairs, `GoalContext::peers`, les deux en posaient une), l'explosion (f125) ouvre le mur, le joueur 1 garde sa bombe ; ils nettoient les trois
// combats (f674, f1234, f1924), le joueur 0 ouvre le coffre secret (f2248) ; le joueur 0 achète les **trois** présentoirs de la
// boutique (f2919, f2941, f2963 : 15 sous chacun, `vent_arriere`, `cousin`, `pouls`), ouvre le coffre du trésor (f3591) ; le `gardien` (boss du seul étage de `sous_sol_un`) meurt (victoire f4231).
// M3-T11d2 : 100 objets et trois ennemis de plus dans les gabarits de combat : chronologie recalée (avant : coffres f1073 et f1452, achats f1755 à f1792, victoire f2224 ; gabarits ×2 : marches deux fois plus longues, tout arrive environ deux fois plus tard).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    map_seed: 39,
    floors: Some("sous_sol_un"),
    frames: 4500,
    explorer: Some((
        shopping: true,
        shop: HeartsThenCheapest(low_health: "0.5"),
        detour: (shells: Some(400)),
        devil: Never,
        bombs: (secret: true, secret_min_neighbours: 2, rocks: true, reserve: 0),
        oscillation: Hysteresis,
        combat_aware: true,
    )),
    players: [(bot: explorateur), (bot: explorateur)],
    expect: [
        RoomLayout(kind: "secrete", touches: ["depart", "combat"], at_frame: 5),
        Consumable(handle: 0, id: "bomb", count: 1, at_frame: 10),
        Consumable(handle: 1, id: "bomb", count: 1, at_frame: 10),
        Consumable(handle: 0, id: "bomb", count: 0, at_frame: 60),
        Consumable(handle: 1, id: "bomb", count: 1, at_frame: 60),
        DoorLocked(kind: "secrete", locked: true, at_frame: 110),
        DoorLocked(kind: "secrete", locked: false, at_frame: 135),
        Health(handle: 0, min: 6.0, max: 6.0, at_frame: 140),
        Health(handle: 1, min: 6.0, max: 6.0, at_frame: 140),
        EventAfter(kind: "chest", after_frame: 126, by_frame: 2400),
        ShelfCount(count: 3, at_frame: 10),
        Shelf(nth: 0, sold: Some(false), at_frame: 2800),
        Shelf(nth: 0, sold: Some(true), at_frame: 3000),
        Shelf(nth: 1, sold: Some(true), at_frame: 3000),
        Shelf(nth: 2, sold: Some(true), at_frame: 3000),
        Event(kind: "victory", by_frame: 4400),
        PlayerAlive(handle: 0, at_frame: 4499),
        PlayerAlive(handle: 1, at_frame: 4499),
    ],
)
