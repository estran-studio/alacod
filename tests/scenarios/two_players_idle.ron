// Deux joueurs locaux immobiles dans la même partie (session synctest à 2 joueurs).
//
// À regarder : la caméra suit le joueur 0. Les zombies entrent par les fenêtres et attaquent
// d'abord le joueur 0 (f290), puis le joueur 1 (f869). Le joueur 0 meurt (f1099) : la partie
// continue, le joueur 1 se fait encercler et meurt à son tour (f1438).
Scenario(
    frames: 1500,
    players: [
        (),
        (),
    ],
    expect: [
        PlayerAlive(handle: 0, at_frame: 300),
        PlayerAlive(handle: 1, at_frame: 300),
        // La partie continue après la mort d'un joueur : le joueur 0 meurt, le 1 est encore là
        PlayerDead(handle: 0, at_frame: 1200),
        PlayerAlive(handle: 1, at_frame: 1200),
    ],
)
