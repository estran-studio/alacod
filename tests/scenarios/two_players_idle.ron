// Deux joueurs locaux immobiles dans la même partie (session synctest à 2 joueurs).
//
// À regarder : la caméra suit le joueur 0. Chaque zombie va vers le joueur le plus proche par le
// chemin : ils cassent la fenêtre du bas (f381) et attaquent d'abord le joueur 1, plus près
// (f459), puis le joueur 0 (f516). À terre (T1.3, chantier B6) : le joueur 1, seul à 0 PV alors
// que le joueur 0 est encore debout, tombe à terre au lieu de mourir (f1072, voir PlayerDowned
// ci-dessous, et la doc de `combat::downed::Downed`) ; personne ne le réanime (les deux joueurs
// sont immobiles), il reste à terre. Le joueur 0 se fait encercler à son tour et meurt à f1346.
// D176 (polissage-nav-fenetres) : avant, des zombies gelaient devant le point visé de leur case
// suivante (zombie 98 de f959 à f1141) : chute à f1296, mort à f1570, attentes à f1400.
Scenario(
    // Isoler ce scénario des drops aléatoires ; powerup_drop_on_kill teste ce chemin.
    powerup_drop_chance_override: "0.0",
    game: "zombies",
    frames: 1500,
    // S5 : figer le rythme de cette mise en scène de mécanique.
    // Les assertions restent indépendantes de l'équilibrage des parties.
    wave_overrides: (
        base_enemies: 6,
        enemies_per_wave: 4,
        max_concurrent_enemies: 8,
        spawn_interval_frames: 60,
    ),
    players: [
        (),
        (),
    ],
    expect: [
        PlayerAlive(handle: 0, at_frame: 300),
        PlayerAlive(handle: 1, at_frame: 300),
        // La partie continue après qu'un joueur tombe à terre : le joueur 1 est à terre, le
        // joueur 0 est encore debout (T1.3 : un coéquipier debout empêche la mort, voir
        // health::rollback_apply_accumulated_damage).
        PlayerDowned(handle: 1, at_frame: 1300),
        PlayerAlive(handle: 0, at_frame: 1300),
    ],
)
