// M3-T5 (docs/conventions.md §70) : la salle post-boss (`diable`) accrochée au boss. Graine 8 (séquence `sous_sol_un`) :
// la chance de la grammaire (un tiers, tirée une fois par un flux local de la graine de l'emplacement) donne la salle
// du diable, collée à l'est du boss et à aucune autre salle (le boss est le bout d'un couloir vertical de quatre
// combats). Le bot `explorateur` nettoie les combats, bat le boss puis finit le dernier combat.
//
// À regarder : le boss verrouille sa salle (f628), passe en phase 1 (f740), meurt (f862) : son butin (`calice_ardent`, pool
// `boss`, M3-T8 §73) tombe au centre de la salle (f871) et le bot le ramasse avant f900 ; la salle se rouvre avec sa porte
// vers la salle du diable (deux présentoirs à un cœur, `devil_room_chance`) ; victoire vers f1430 (f1384 avant le butin).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    map_seed: 8,
    floors: Some("sous_sol_un"),
    frames: 2150,
    players: [
        (bot: explorateur),
    ],
    expect: [
        EntityCount(kind: Enemy, min: Some(13), max: Some(13), at_frame: 5),
        RoomLayout(kind: "diable", size: Some((240, 144)), touches: ["boss"], apart: ["combat", "depart", "secrete", "tresor"], at_frame: 5),
        RoomLayout(kind: "boss", touches: ["combat", "diable"], apart: ["depart", "tresor", "secrete"], at_frame: 5),
        RoomState(kind: "diable", state: Dormant, at_frame: 5),
        RoomState(kind: "boss", state: Locked, at_frame: 1030),
        BossPhase(entity: NetId(117), phase: 1, at_frame: 1150),
        RoomState(kind: "boss", state: Cleared, at_frame: 1400),
        ItemsOnFloor(id: "calice_ardent", count: 0, at_frame: 1360),
        ItemsOnFloor(id: "calice_ardent", count: 1, at_frame: 1390),
        HasItem(handle: 0, id: "calice_ardent", at_frame: 1470),
        ItemsOnFloor(id: "calice_ardent", count: 0, at_frame: 1470),
        ShelfCount(count: 2, at_frame: 1400),
        RunState(step: Ended(Victory), at_frame: 2110),
        PlayerAlive(handle: 0, at_frame: 2149),
    ],
)
