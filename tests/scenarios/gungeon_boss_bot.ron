// M2-T7 (docs/conventions.md §45) : un bot bat le boss de `gungeon`. Le bot `fonceur` (profil
// existant, sans le moindre input scripté) nettoie la salle de combat, entre dans la salle du boss (verrouillage),
// tire sur le `gatling` à trois phases (éventail, spirale, rage finale avec un `bullet_kin` en renfort), le tue :
// la salle se rouvre, l'étage est vidé, victoire.
//
// À regarder : le bot avance de salle en salle en tirant ; le boss change de phase deux fois
// (moments clés `boss_phase`), un renfort apparaît à la dernière ; écran de victoire vers f403.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "gungeon",
    frames: 600,
    players: [
        (bot: fonceur),
    ],
    expect: [
        RoomState(kind: "combat", state: Cleared, at_frame: 250),
        RoomState(kind: "boss", state: Locked, at_frame: 250),
        // Trois phases : sous 50 % de santé (f322), puis sous 10 % (f382, le renfort apparaît).
        BossPhase(entity: NetId(31), phase: 1, at_frame: 350),
        BossPhase(entity: NetId(31), phase: 2, at_frame: 390),
        EntityCount(kind: Enemy, min: 2, max: 2, at_frame: 390),
        // Le boss meurt (f403) avec son renfort : la salle se rouvre, victoire (`victory_at_end`).
        RoomState(kind: "boss", state: Cleared, at_frame: 430),
        EntityCount(kind: Enemy, max: Some(0), at_frame: 430),
        RunState(step: Ended(Victory), at_frame: 450),
        PlayerAlive(handle: 0, at_frame: 599),
    ],
)
