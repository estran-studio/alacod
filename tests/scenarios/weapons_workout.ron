// Toutes les manipulations d'armes d'un joueur (tirs vers le haut de la pièce), avec les cas
// limites : changer d'arme pendant le cooldown initial, rechargement différé du pistolet,
// changer de mode pendant un rechargement, puis cadence automatique et changement d'arme.
// Pistolet et fusil sont semi-automatiques : un clic par tir.
//
// À regarder : le joueur prend le pistolet (f46) et consomme son nouveau chargeur de 9 ;
// les contrôles f300/f330 vérifient les tirs et le rechargement différé. La tentative de
// changement f400 tombe encore pendant ce rechargement : le pistolet est toujours actif f500,
// puis le fusil à pompe apparaît en mode piercing f850. Les dernières entrées vérifient que
// le changement de mode et les tirs du fusil restent cohérents avec cette cadence.
Scenario(
    // Isoler ce scénario des drops aléatoires ; powerup_drop_on_kill teste ce chemin.
    powerup_drop_chance_override: "0.0",
    game: "zombies",
    frames: 950,
    players: [
        (inputs: [
            (from: 10, to: 13, buttons: [SwitchWeapon]),
            (from: 40, to: 43, buttons: [SwitchWeapon]),
            (from: 60, to: 63, buttons: [Fire], pan: (40, 100)),
            (from: 100, to: 103, buttons: [Fire], pan: (40, 100)),
            (from: 140, to: 143, buttons: [Fire], pan: (40, 100)),
            (from: 180, to: 183, buttons: [Fire], pan: (40, 100)),
            (from: 220, to: 223, buttons: [Fire], pan: (40, 100)),
            (from: 260, to: 263, buttons: [Fire], pan: (40, 100)),
            (from: 300, to: 303, buttons: [Fire], pan: (40, 100)),
            (from: 380, to: 382, buttons: [Reload]),
            (from: 400, to: 403, buttons: [SwitchWeapon]),
            (from: 410, to: 413, buttons: [Fire], pan: (40, 100)),
            (from: 470, to: 473, buttons: [Fire], pan: (40, 100)),
            (from: 480, to: 483, buttons: [SwitchWeaponMode]),
            (from: 560, to: 563, buttons: [SwitchWeapon]),
            (from: 580, to: 800, buttons: [Fire], pan: (40, 100)),
            (from: 805, to: 808, buttons: [SwitchWeaponMode]),
            (from: 830, to: 833, buttons: [Fire], pan: (40, 100)),
            (from: 860, to: 863, buttons: [Fire], pan: (40, 100)),
            (from: 890, to: 893, buttons: [Fire], pan: (40, 100)),
        ]),
    ],
    expect: [
        // Changement d'arme refusé pendant le cooldown initial (f10), accepté ensuite
        ActiveWeapon(handle: 0, weapon: "machine_gun", at_frame: 30),
        ActiveWeapon(handle: 0, weapon: "pistol", at_frame: 50),
        // Pistolet : cadence de clics et rechargement différé avec le chargeur de 9.
        Ammo(handle: 0, ammo: 3, at_frame: 300),
        Ammo(handle: 0, ammo: 2, at_frame: 330),
        // Recharger un chargeur encore partiellement rempli ne change pas immédiatement son état.
        Ammo(handle: 0, ammo: 2, at_frame: 395),
        // Le changement de f400 est refusé pendant le rechargement ; le pistolet reste actif.
        ActiveWeapon(handle: 0, weapon: "pistol", at_frame: 500),
        Ammo(handle: 0, ammo: 8, at_frame: 530),
        // Le fusil est finalement actif et son mode a changé avant les tirs de fin.
        ActiveWeapon(handle: 0, weapon: "shotgun", mode: "piercing", at_frame: 850),
        Ammo(handle: 0, ammo: 63, at_frame: 855),
    ],
)
