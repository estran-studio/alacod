// Déplacements spéciaux et corps à corps d'un joueur seul : sprint, dash (dans la direction du
// déplacement, sinon de la visée, sinon du regard ; cooldown de 180 frames), sprint en tirant (le
// sprint empêche de tirer), puis attaques au corps à corps répétées quand les zombies arrivent.
//
// À regarder : sprint vers la droite (f16-76), nettement plus rapide que la marche. À f96,
// Gauche + Dash : le dash part vers la gauche (56 px). Les dashs de f150 et f160 sont refusés
// (cooldown). Sprint en tirant vers le haut (f226-256) : aucun tir. Attaques au corps à corps toutes
// les 40 frames à partir de f386 (arc de slash vers le bas).
Scenario(
    // Isoler ce scénario des drops aléatoires ; powerup_drop_on_kill teste ce chemin.
    powerup_drop_chance_override: "0.0",
    game: "zombies",
    frames: 900,
    players: [
        (inputs: [
            (from: 10, to: 70, buttons: [Right, Sprint]),
            (from: 90, to: 93, buttons: [Left, Dash]),
            (from: 150, to: 153, buttons: [Left, Dash]),
            (from: 160, to: 163, buttons: [Left, Dash]),
            (from: 220, to: 250, buttons: [Sprint, Fire], pan: (0, 100)),
            (from: 380, to: 383, buttons: [Melee], pan: (0, -60)),
            (from: 420, to: 423, buttons: [Melee], pan: (0, -60)),
            (from: 460, to: 463, buttons: [Melee], pan: (0, -60)),
            (from: 500, to: 503, buttons: [Melee], pan: (0, -60)),
            (from: 540, to: 543, buttons: [Melee], pan: (0, -60)),
            (from: 580, to: 583, buttons: [Melee], pan: (0, -60)),
        ]),
    ],
    expect: [
        // Le sprint accélère : 189 px en 85 frames (la marche en fait ~90)
        PlayerPosition(handle: 0, x: 613.4, y: 696, tolerance: 1, at_frame: 95),
        // Dash de 56 px dans la direction du déplacement (gauche)
        PlayerPosition(handle: 0, x: 557.4, y: 696, tolerance: 1, at_frame: 115),
        // Dashs refusés pendant le cooldown : le joueur n'a presque pas bougé
        PlayerPosition(handle: 0, x: 556, y: 696, tolerance: 2, at_frame: 170),
    ],
)
