// M3-T2 : témoin de `effect_apply_status` : le même tir sans la `morsure` ; ni poison ni lenteur.

Scenario(
    game: "testbed",
    map: "testbed/props_room.ldtk",
    frames: 150,
    powerup_drop_chance_override: "0",
    characters: [(character: "target", x: "560.0", y: "-194.0", at_frame: 1)],
    players: [
        (
            inputs: [(from: 30, to: 32, buttons: [Fire], pan: (-127, 0))],
            weapon: "pistol",
        ),
    ],
    expect: [
        HasStatus(entity: Placed(0), status: "poison", present: false, at_frame: 60),
        Stat(handle: 0, stat: MoveSpeed, value: 150.0, at_frame: 60),
    ],
)
