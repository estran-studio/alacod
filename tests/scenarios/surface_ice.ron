// T1.7 (surfaces, docs/conventions.md §26) : glace (accélération ×0,2, vitesse maximale
// inchangée) sur `testbed/surfaces.ldtk`. Les deux joueurs reçoivent le même input : marche à
// droite de f10 à f315, puis demi-tour (gauche) jusqu'à f440. À f315, le joueur 0 est sur la
// glace du couloir A (x -104.7, glace [-128, 32)), le joueur 1 sur le sol du couloir B.
//
// À regarder : sur le sol, le joueur 1 freine et repart à gauche en ~60 frames (x maximal
// ≈ 194 vers f375, puis 118.1 à f440). Sur la glace, le joueur 0 glisse : il avance encore de
// 26 px entre f360 et f375 (sur le sol : 7,5 px) et ne s'arrête que vers f425 (x ≈ 61),
// après être sorti de la glace en f388.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/surfaces.ldtk",
    frames: 450,
    players: [
        (inputs: [
            (from: 10, to: 315, buttons: [Right], pan: (0, 0)),
            (from: 315, to: 440, buttons: [Left], pan: (0, 0)),
        ]),
        (inputs: [
            (from: 10, to: 315, buttons: [Right], pan: (0, 0)),
            (from: 315, to: 440, buttons: [Left], pan: (0, 0)),
        ]),
    ],
    expect: [
        CellState(x: -7, y: 15, surface: "glace", at_frame: 5),
        PlayerPosition(handle: 0, x: -104.7, y: 248, tolerance: 1, at_frame: 315),
        PlayerPosition(handle: 1, x: 108.1, y: 184, tolerance: 1, at_frame: 315),
        // Sur la glace : la glissade continue
        PlayerPosition(handle: 0, x: -15.6, y: 248, tolerance: 1, at_frame: 360),
        PlayerPosition(handle: 0, x: 10.3, y: 248, tolerance: 1, at_frame: 375),
        PlayerPosition(handle: 0, x: 60.9, y: 248, tolerance: 1, at_frame: 430),
        // Sur le sol : demi-tour presque fini, déjà reparti à gauche
        PlayerPosition(handle: 1, x: 186.4, y: 184, tolerance: 1, at_frame: 360),
        PlayerPosition(handle: 1, x: 193.9, y: 184, tolerance: 1, at_frame: 375),
        PlayerPosition(handle: 1, x: 141.2, y: 184, tolerance: 1, at_frame: 430),
    ],
)
