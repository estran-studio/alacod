// T1.7 (surfaces, docs/conventions.md §26) : glace (adhérence ×0,2, vitesse maximale
// inchangée) sur `testbed/surfaces.ldtk`. Les deux joueurs reçoivent le même input : marche à
// droite de f10 à f315, puis demi-tour (gauche) jusqu'à f440, joué 5 frames plus tard (délai
// d'input). À f315, le joueur 0 est sur la glace du couloir A (x -18.2, glace [-128, 32)), le
// joueur 1 sur le sol du couloir B.
//
// À regarder : sur le sol, le joueur 1 fait demi-tour en 6 frames et ne dépasse que de 2,5 px
// sa dernière position à pleine vitesse (x maximal 194.3 à f323). Sur la glace, le joueur 0 met
// 30 frames : il glisse encore de 17 px vers la droite (x maximal 11.8 à f335), puis ne retrouve
// sa pleine vitesse à gauche qu'à f351 (-10.7), quand le joueur 1 court déjà depuis 24 frames.
// Il quitte la glace pour le sable vers f398 (x -128, 2,0 px/frame).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/surfaces.ldtk",
    frames: 450,
    players: [
        (inputs: [
            (from: 10, to: 315, buttons: [Right], pan: (0, 0)),
            (from: 315, to: 440, buttons: [Left], pan: (0, 0)),
        ]),
        (inputs: [
            (from: 10, to: 315, buttons: [Right], pan: (0, 0)),
            (from: 315, to: 440, buttons: [Left], pan: (0, 0)),
        ]),
    ],
    expect: [
        CellState(x: -7, y: 15, surface: "glace", at_frame: 5),
        PlayerPosition(handle: 0, x: -18.2, y: 248, tolerance: 1, at_frame: 315),
        PlayerPosition(handle: 1, x: 179.3, y: 184, tolerance: 1, at_frame: 315),
        // Sur le sol : arrêté en 3 frames, reparti à gauche à pleine vitesse 3 frames après
        PlayerPosition(handle: 1, x: 194.3, y: 184, tolerance: 1, at_frame: 323),
        PlayerPosition(handle: 1, x: 166.8, y: 184, tolerance: 1, at_frame: 335),
        PlayerPosition(handle: 1, x: 126.8, y: 184, tolerance: 1, at_frame: 351),
        PlayerPosition(handle: 1, x: -70.6, y: 184, tolerance: 1, at_frame: 430),
        // Sur la glace : la glissade continue, puis le joueur repart lentement
        PlayerPosition(handle: 0, x: 0.8, y: 248, tolerance: 1, at_frame: 323),
        PlayerPosition(handle: 0, x: 11.8, y: 248, tolerance: 1, at_frame: 335),
        PlayerPosition(handle: 0, x: -10.7, y: 248, tolerance: 1, at_frame: 351),
        PlayerPosition(handle: 0, x: -192.2, y: 248, tolerance: 1, at_frame: 430),
    ],
)
