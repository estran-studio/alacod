// M3-T2 : témoin de `effect_target_in_range` : la cible est à 316 unités du joueur (hors des deux portées) ; les
// dégâts restent à 1 malgré le coup.

Scenario(
    game: "testbed",
    map: "testbed/props_room.ldtk",
    frames: 150,
    powerup_drop_chance_override: "0",
    characters: [(character: "target", x: "380.0", y: "-194.0", at_frame: 1)],
    players: [
        (
            inputs: [(from: 30, to: 32, buttons: [Fire], pan: (-127, 0))],
            weapon: "pistol",
            items: ["portee"],
        ),
    ],
    expect: [
        Stat(handle: 0, stat: Damage, value: 1.0, at_frame: 100),
    ],
)
