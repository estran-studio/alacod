// La Fonderie : une partie réelle jouée par le bot `acheteur` (profil existant, aucun input
// scripté). Il achète les portes, casse les fenêtres, se ravitaille et finit par entrer dans
// la salle du boss (porte de combat gratuite, verrouillée) et le tuer : victoire par objectif.
//
// À regarder : le hall à deux sorties (f~150), les premières fenêtres cassées (f~300), la cour
// de chargement ouverte en fin de vague 2, un ravitaillement/perk acheté, puis l'entrée du boss
// et la victoire vers f13 390. Les zombies apparaissent dans la section occupée (courettes
// derrière les fenêtres), jamais derrière une porte encore payante.
Scenario(
    game: "zombies",
    map: "floor:la_fonderie",
    map_seed: 4,
    frames: 20000,
    players: [
        (bot: acheteur),
    ],
    expect: [
        PlayerAlive(handle: 0, at_frame: 19000),
        WaveAtLeast(wave: 2, at_frame: 4000),
        KillsAtLeast(kills: 30, at_frame: 19000),
        DoorsOpenAtLeast(doors: 4, at_frame: 19000),
        RunState(step: Ended(Victory), at_frame: 20000),
        RunSummary(wave_reached_min: 5, kills_min: 30, at_frame: 20000),
    ],
)
