// M3-T4 (docs/conventions.md §69) : le mur secret. Carte `testbed/salles_secret.ldtk` (graine 1) : la salle de départ
// et, collée à l'est, une salle de type `secrete` (`door_lock: Secret`) dont la porte (et sa jumelle) reste fermée
// comme un mur plein : aucune Interaction ne l'ouvre. Un `follower` est placé dans la salle secrète (f5). Le joueur
// marche vers la porte (f10 à f60), pose une bombe (f70, effective f75 ; mèche 20 frames, rayon 40, tir ami coupé),
// puis repart vers l'est (f110 à f230).
//
// À regarder : tant que la porte est fermée, le joueur s'arrête devant elle (x ≈ -842) et le `follower` ne peut pas
// le rejoindre ; à l'explosion (f95) la porte s'ouvre (`DoorLocked` passe à faux), le champ de flux relie les deux
// salles : le `follower` sort et rejoint le joueur ; le joueur peut passer dans la salle secrète. Témoin :
// `secret_wall_closed`, même carte, mêmes déplacements, sans bombe : la porte reste fermée.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/salles_secret.ldtk",
    map_seed: 1,
    frames: 260,
    characters: [
        (character: "follower", x: "-720.0", y: "-584.0", at_frame: 5),
    ],
    players: [
        (
            bomb: (fuse_frames: 20, radius: "40.0", damage: "10.0", friendly_fire: Never),
            items: ["bomb"],
            inputs: [
                (from: 10, to: 60, buttons: [Right], pan: (0, 0)),
                (from: 70, to: 71, buttons: [Bomb]),
                (from: 110, to: 250, buttons: [Right], pan: (0, 0)),
            ],
        ),
    ],
    expect: [
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 50),
        PlayerPosition(handle: 0, x: -842.4, y: -584, tolerance: 1, at_frame: 90),
        EnemyDistance(entity: Placed(0), target: Player(0), min: 52.0, max: 54.0, at_frame: 90),
        DoorLocked(kind: "secrete", nth: 0, locked: false, at_frame: 100),
        PlayerPosition(handle: 0, x: -775.9, y: -574, tolerance: 1.5, at_frame: 150),
        PlayerPosition(handle: 0, x: -714, y: -574, tolerance: 1.5, at_frame: 259),
        EnemyDistance(entity: Placed(0), target: Player(0), min: 29.0, max: 32.0, at_frame: 259),
        Health(handle: 0, min: 100, max: 100, at_frame: 259),
    ],
)
