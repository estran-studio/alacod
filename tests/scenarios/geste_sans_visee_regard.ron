// P-1b (docs/conventions.md §110, testbed) : une arme à geste sans aucune visée (pan nul de l'appui au départ, souris
// absente ou manette sans stick) tire vers le regard du personnage (la droite, sans touche) au lieu de partir à vitesse nulle.
//
// À regarder : le joueur épaule sans viser, la balle part vers la droite et touche la cible.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/arena.ldtk",
    frames: 120,
    characters: [(character: "cible_zone", x: "560.0", y: "706.0", at_frame: 1)],
    players: [
        (weapon: "arme_a_gestes", inputs: [
            (from: 25, to: 26, buttons: [Fire], pan: (0, 0)),
            (from: 26, to: 120, buttons: [], pan: (0, 0)),
        ]),
    ],
    expect: [
        EntityHits(net_id: 33, min: 1, max: Some(1), at_frame: 120),
    ],
)
