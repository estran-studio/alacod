// M3-T14 (docs/conventions.md §79) : une partie ordinaire d'`isaac` (séquence par défaut `sous_sol`, deux étages en
// grille, graine 48) jouée de bout en bout par le bot `explorateur` avec la politique de `games/isaac/assets/bot.ron`,
// sans input scripté et **sans bombe** (le personnage d'`isaac` n'en porte pas avant M3-T11d : la salle secrète reste
// close, voir `bot_isaac_secret`).
//
// À regarder : le boss du premier étage est vaincu, le bot ouvre le trésor et prend le portail (« niveau 1 », f2928) ;
// au second étage le trésor est fermé à clé : le bot va à la porte, une Interaction consomme la clé remise à l'arrivée
// (f2942), il ouvre le coffre (f3058) ; le second boss meurt et la partie est gagnée (f4941). Les objets tirés
// changent avec le tirage du butin (D95/D96) : les attentes ne les nomment pas. Seule la graine 48 de 1 à 20
// gagne avec ce contenu (champions de D88, visée à quatre directions) : voir le rapport de campagne.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    map_seed: 48,
    frames: 5600,
    explorer: Some((
        shopping: true,
        shop: HeartsThenCheapest(low_health: "0.5"),
        detour: (shells: Some(400)),
        devil: Never,
        bombs: (secret: true, secret_min_neighbours: 2, rocks: true, reserve: 0),
        oscillation: Hysteresis,
        combat_aware: true,
    )),
    players: [(bot: explorateur)],
    expect: [
        DoorLocked(kind: "secrete", locked: true, at_frame: 5),
        DoorLocked(kind: "tresor", locked: false, at_frame: 5),
        Event(kind: "chest", by_frame: 2800),
        FloorIndex(index: 0, at_frame: 1900),
        FloorIndex(index: 1, at_frame: 3000),
        DoorLocked(kind: "tresor", nth: 0, locked: true, at_frame: 2932),
        Consumable(handle: 0, id: "key", count: 1, at_frame: 2932),
        DoorLocked(kind: "tresor", nth: 0, locked: false, at_frame: 3100),
        Consumable(handle: 0, id: "key", count: 0, at_frame: 3100),
        EventAfter(kind: "chest", after_frame: 2950, by_frame: 3100),
        DoorLocked(kind: "secrete", locked: true, at_frame: 4900),
        Event(kind: "victory", by_frame: 5100),
        PlayerAlive(handle: 0, at_frame: 5599),
    ],
)
