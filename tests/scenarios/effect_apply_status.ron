// M3-T2 (docs/conventions.md §67) : `ApplyStatus` sur la cible touchée (poison) et `ApplyStatusSelf` sur le porteur
// (lenteur). La `morsure`, un tir (f30) sur une `target` en (560, -194).
//
// À regarder : la cible se teinte de vert à l'impact ; le joueur ralentit (vitesse × 0,5) pendant 120 frames.
// Témoin : `effect_apply_status_temoin` (sans l'objet : ni poison ni lenteur).

Scenario(
    game: "testbed",
    map: "testbed/props_room.ldtk",
    frames: 150,
    powerup_drop_chance_override: "0",
    characters: [(character: "target", x: "560.0", y: "-194.0", at_frame: 1)],
    players: [
        (
            inputs: [(from: 30, to: 32, buttons: [Fire], pan: (-127, 0))],
            weapon: "pistol",
            items: ["morsure"],
        ),
    ],
    expect: [
        HasStatus(entity: Placed(0), status: "poison", present: false, at_frame: 29),
        HasStatus(entity: Placed(0), status: "poison", at_frame: 60),
        StatusStacks(entity: Placed(0), status: "poison", stacks: 1, at_frame: 60),
        Stat(handle: 0, stat: MoveSpeed, value: 75.0, at_frame: 60),
    ],
)
