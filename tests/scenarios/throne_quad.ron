// `throne` vague 2 de M1 (m1-integration-scenarios, docs/conventions.md §29) : quatre bots
// `prudent` jouent la run complète (trois cavernes, `floors/run.ron`), avec tout ce que le manifeste
// active (butin, progression, horloge, difficulté) et le boss `roi_rat` au niveau 3. Joué en
// synctest par la suite : preuve de déterminisme à quatre joueurs.
//
// Mesuré (graine 123456, comme `alacod-sim --game throne --bots 4 --profiles
// prudent,prudent,prudent,prudent --floors run --seeds 123456..123456 --until-floor 3`) : étages à
// f662, f1380, f3167 ; boss (NetId 706, 540 PV avec la difficulté, 28 px en jeu, gabarit grand
// de la navigation) qui vient au contact (910, 52 → 576, 324 entre f1400 et f2400), entamé dès
// f2000, mort avant le portail du niveau 3 (f2973) ; la boucle infinie recharge le niveau 3 avec
// un nouveau boss (NetId 1417, 630 PV) à f3167. Le joueur 2 ne monte jamais de niveau.
//
// À regarder : quatre bots nettoient trois cavernes de plus en plus grandes ; au troisième, le roi
// des rats (plus gros) quitte le coin le plus éloigné, tire en couronne, charge, puis tombe.
Scenario(
    game: "throne",
    floors: Some("run"),
    map_seed: 123456,
    frames: 3400,
    players: [
        (bot: prudent),
        (bot: prudent),
        (bot: prudent),
        (bot: prudent),
    ],
    expect: [
        FloorIndex(index: 1, at_frame: 670),
        FloorIndex(index: 2, at_frame: 1390),
        FloorIndex(index: 2, at_frame: 3150),
        FloorIndex(index: 3, at_frame: 3175),
        Event(kind: "floor", label_contains: Some("niveau 3"), by_frame: 9000),
        Event(kind: "levelup", by_frame: 814),
        Event(kind: "mutation", by_frame: 1414),
        Clock(id: "alerte", fired: true, at_frame: 2290),
        // Le boss : entier à son arrivée, entamé à f2400, remplacé au rechargement.
        EntityHealth(net_id: 706, min: Some(540.0), at_frame: 1400),
        EntityHealth(net_id: 706, max: Some(200.0), at_frame: 2400),
        EntityHealth(net_id: 1417, min: Some(630.0), at_frame: 3200),
        PlayerAlive(handle: 0, at_frame: 3399),
        PlayerAlive(handle: 1, at_frame: 3399),
        PlayerAlive(handle: 2, at_frame: 3399),
        PlayerAlive(handle: 3, at_frame: 3399),
    ],
)
