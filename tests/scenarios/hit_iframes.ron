// M3-T0b : deux tirs espacés de 10 frames ; le second est absorbé par les i-frames.
// À regarder : la cible encaisse le premier tir vers f10, puis le second vers f20 sans perdre
// de santé supplémentaire.
Scenario(
    game: "testbed",
    map: "testbed/arena.ldtk",
    frames: 40,
    wave_overrides: (max_wave: 999, grace_period_frames: 1000),
    powerup_drop_chance_override: "0.0",
    characters: [
        (character: "iframes_target", x: "520.0", y: "696.0", at_frame: 5),
    ],
    players: [
        (inputs: [
            (from: 10, to: 10, buttons: [Fire], pan: (-176, 0)),
            (from: 20, to: 20, buttons: [Fire], pan: (-176, 0)),
        ]),
    ],
    expect: [
        EntityHits(net_id: 35, min: 1, max: 1, at_frame: 40),
    ],
)
