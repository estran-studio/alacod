// M2-T12 (docs/conventions.md §51) : même graine, mêmes dix coffres (k1..k10), mêmes appuis que
// `unlock_base_pool` ; seul le profil change (trois déblocages). Le trèfle et l'étendard réservés
// à un déblocage entrent dans les pools et le coffre riche ajoute une entrée Rare : les tirages
// diffèrent (ici « amulette » ×2, « bastion » ×2, « lunettes » ×2). Le RNG est consommé de la
// même façon dans les deux cas. Les comptes dépendent du contenu des pools de gungeon : ajouter
// un objet les décale (les rebénir alors, avec le même jumeau).
//
// À regarder : le joueur ouvre puis ramasse un coffre toutes les 10 frames (f30–f220).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "gungeon",
    floors: Some("etage_1"),
    frames: 260,
    profile: true,
    profile_setup: Some((profiles: [(handle: 0, unlocks: ["tresor_trefle", "etendard_royal", "coffre_riche"])])),
    chests: [(key: "k1", x: "88.0", y: "-120.0", at_frame: 5), (key: "k2", x: "88.0", y: "-120.0", at_frame: 6), (key: "k3", x: "88.0", y: "-120.0", at_frame: 7), (key: "k4", x: "88.0", y: "-120.0", at_frame: 8), (key: "k5", x: "88.0", y: "-120.0", at_frame: 9), (key: "k6", x: "88.0", y: "-120.0", at_frame: 10), (key: "k7", x: "88.0", y: "-120.0", at_frame: 11), (key: "k8", x: "88.0", y: "-120.0", at_frame: 12), (key: "k9", x: "88.0", y: "-120.0", at_frame: 13), (key: "k10", x: "88.0", y: "-120.0", at_frame: 14)],
    players: [(inputs: [(from: 30, to: 31, buttons: [Interaction]),(from: 40, to: 41, buttons: [Interaction]),(from: 50, to: 51, buttons: [Interaction]),(from: 60, to: 61, buttons: [Interaction]),(from: 70, to: 71, buttons: [Interaction]),(from: 80, to: 81, buttons: [Interaction]),(from: 90, to: 91, buttons: [Interaction]),(from: 100, to: 101, buttons: [Interaction]),(from: 110, to: 111, buttons: [Interaction]),(from: 120, to: 121, buttons: [Interaction]),(from: 130, to: 131, buttons: [Interaction]),(from: 140, to: 141, buttons: [Interaction]),(from: 150, to: 151, buttons: [Interaction]),(from: 160, to: 161, buttons: [Interaction]),(from: 170, to: 171, buttons: [Interaction]),(from: 180, to: 181, buttons: [Interaction]),(from: 190, to: 191, buttons: [Interaction]),(from: 200, to: 201, buttons: [Interaction]),(from: 210, to: 211, buttons: [Interaction]),(from: 220, to: 221, buttons: [Interaction])])],
    expect: [
        RunUnlocks(has: ["tresor_trefle", "etendard_royal", "coffre_riche"], at_frame: 50),
        ItemCount(handle: 0, id: "amulette", count: 2, at_frame: 259),
        ItemCount(handle: 0, id: "bastion", count: 2, at_frame: 259),
        ItemCount(handle: 0, id: "lunettes", count: 2, at_frame: 259),
    ],
)
