// M2-T12 (§51) : deux joueurs locaux aux profils différents. Règle choisie : en local, `RunUnlocks`
// est l'union des profils locaux (en ligne : le profil de l'hôte, transmis avec la graine). Le joueur 0
// possède le trèfle, le joueur 1 l'étendard : la partie contient les deux, pas le coffre riche.
//
// À regarder : deux joueurs immobiles ; aucune différence visible.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "gungeon",
    frames: 30,
    profile: true,
    profile_setup: Some((profiles: [
        (handle: 0, unlocks: ["tresor_trefle"]),
        (handle: 1, unlocks: ["etendard_royal"]),
    ])),
    players: [(), ()],
    expect: [
        RunUnlocks(has: ["tresor_trefle", "etendard_royal"], lacks: ["coffre_riche"], at_frame: 20),
    ],
)
