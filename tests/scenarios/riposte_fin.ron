// C-5 (testbed, docs/conventions.md §133) : fin de la provocation. `riposte_court` (`provocation: 60`, garde `ReturnHome`) guette en (640, 696) ; touché
// vers f52 il marche sur le joueur 0 (424, 696) jusqu'à f112 environ (≈ 120 unités parcourues, encore hors d'aggro : 96 unités du joueur), puis perd sa
// cible : la garde, un instant levée, le ramène à son point d'apparition et il y reste.
//
// À regarder : poursuite de f52 à f112, demi-tour, retour à reculons au poste (≈ f150) et immobilité.
Scenario(
    tags: ["rapide"],
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/arene_vide.ldtk",
    frames: 240,
    characters: [(character: "riposte_court", x: "640.0", y: "696.0", at_frame: 1)],
    players: [
        (weapon: "pistol", inputs: [
            (from: 0, to: 20, buttons: [], pan: (100, 0)),
            (from: 20, to: 21, buttons: [Fire], pan: (100, 0)),
            (from: 21, to: 240, buttons: [], pan: (100, 0)),
        ]),
    ],
    expect: [
        EnemyState(entity: Placed(0), behavior: "Chase", at_frame: 90),
        EnemyPosition(entity: Placed(0), x_max: Some(600.0), at_frame: 100),
        // Provocation finie : plus de cible, retour au point d'apparition (moins d'une case)
        EnemyPosition(entity: Placed(0), x_min: Some(624.0), x_max: Some(656.0), y_min: Some(680.0), y_max: Some(712.0), at_frame: 230),
        EnemyPosition(entity: Placed(0), x_min: Some(624.0), x_max: Some(656.0), y_min: Some(680.0), y_max: Some(712.0), at_frame: 239),
        EnemyDistance(entity: Placed(0), target: Player(0), min: Some(190.0), at_frame: 239),
        PlayerAlive(handle: 0, at_frame: 239),
    ],
)
