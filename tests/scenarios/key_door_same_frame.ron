// X-6a1 (§117) : deux joueurs qui interagissent avec la même porte à la **même frame** ne consomment qu'une clé. Carte
// `testbed/portes_cle.ldtk` : deux `porteur_cle` (3 PV), un devant chaque joueur ; chaque joueur tue le sien (f20-41), l'équipe tient deux
// clés (`TeamKeys` 2) ; puis les deux marchent côte à côte jusqu'à la porte (f60-140 : butés contre elle, à portée) et appuient sur Interaction à la même frame (f150 :
// les deux événements d'interaction de la frame visent la porte). L'ouverture passe par des commandes différées : sans mémoire des portes ouvertes
// dans la frame, le second événement revoyait la porte fermée et consommait la seconde clé.
//
// À regarder : la porte s'ouvre à la frame d'interaction, il reste **une** clé à l'équipe (le HUD affiche `cle_test`, pas `cle_test ×2`).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/portes_cle.ldtk",
    frames: 300,
    characters: [
        (character: "porteur_cle", x: "672", y: "-104", at_frame: 1),
        (character: "porteur_cle", x: "672", y: "-136", at_frame: 1),
    ],
    players: [
        (
            weapon: "larme",
            inputs: [
                (from: 20, to: 41, buttons: [Fire], pan: (127, 0)),
                (from: 60, to: 140, buttons: [Right]),
                (from: 150, to: 200, buttons: [Interaction]),
            ],
        ),
        (
            weapon: "larme",
            inputs: [
                (from: 20, to: 41, buttons: [Fire], pan: (127, 0)),
                (from: 60, to: 140, buttons: [Right]),
                (from: 150, to: 200, buttons: [Interaction]),
            ],
        ),
    ],
    expect: [
        KeyPiles(count: 2, at_frame: 55),
        MapDoor(nth: 0, state: Locked, at_frame: 55),
        TeamKeys(key: "cle_test", count: 2, at_frame: 100),
        MapDoor(nth: 0, state: Locked, at_frame: 100),
        MapDoor(nth: 0, state: Open, at_frame: 250),
        MapDoor(nth: 1, state: Open, at_frame: 250),
        TeamKeys(key: "cle_test", count: 1, at_frame: 250),
        HudText(source: "team_keys", contains: "cle_test", at_frame: 250),
    ],
)
