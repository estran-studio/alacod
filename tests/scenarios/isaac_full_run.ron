// M3-T18 (critère 3 du §8.1, `isaac_full_run`) : une partie ordinaire d'`isaac` de bout en bout (séquence par défaut `sous_sol` puis
// `sous_sol_profond`, sans `floors:`, deux étages en grille, boutique, curses possibles : aucune sur cette graine), graine 122 choisie
// dans la campagne `alacod-sim` s1 rejouée sur les salles ×2 (m3-salles-murs-isaac, 1 bot, `--pickup-progress --explored-progress`) : la plus petite
// graine où le bot **nu** (politique de `games/isaac/assets/bot.ron`, sans armure ni aucun `PlayerScript::modifiers`, D93) rencontre tous les
// moments clés du critère 3 et gagne (`docs/taches/rapports/m3-salles-murs-isaac/choisir_graines.py` ; avant les salles ×2 : graine 120, 5 700 frames).
//
// À regarder : salle de combat verrouillée (f104) puis nettoyée (f395) ; la bombe de départ posée contre le mur secret (f402) explose à f476 :
// le mur s'ouvre (f477) et le souffle **casse trois rochers** voisins (f477) ; à la boutique du premier étage, trois achats en sous (f773
// `glu`, larmes collantes ; f795 `encre`, larmes ; f836 `talisman`) ; coffre secret (f1204) ; un cœur ramassé (f3475) ; le `gardien` (verrouillé f4770, phases
// f4974 et f5034) meurt, le portail s'ouvre (f5075) ; second étage f5991 avec deux champions (`explosif`, `essaim`) : l'`essaim` est tué à f7734,
// l'`explosif` à f9725 (son explosion de mort, rayon 44) ; seconde bombe contre le second mur secret (f6916, ouvert f6991) ; à la boutique du second étage le bot
// achète le familier `cousin` (f8921 : le familier suiveur apparaît à côté de lui) ; la porte du trésor fermée à clé s'ouvre (f10728, la clé est consommée) ;
// le `colosse` (verrouillé f12198, phases f12255 et f12286) meurt et la partie est gagnée (f12293).
Scenario(
    game: "isaac",
    map_seed: 122,
    frames: 12400,
    explorer: Some((
        shopping: true,
        shop: HeartsThenCheapest(low_health: "0.5"),
        detour: (shells: Some(400)),
        devil: Never,
        bombs: (secret: true, secret_min_neighbours: 2, rocks: true, reserve: 0),
        oscillation: Hysteresis,
        combat_aware: true,
    )),
    players: [(bot: explorateur)],
    expect: [
        Consumable(handle: 0, id: "bomb", count: 1, at_frame: 20),
        Event(kind: "room", label_contains: Some("salle combat verrouillée"), by_frame: 110),
        Event(kind: "room", label_contains: Some("salle combat nettoyée"), by_frame: 400),
        Event(kind: "bomb", by_frame: 410),
        Consumable(handle: 0, id: "bomb", count: 0, at_frame: 420),
        Event(kind: "door_lock", label_contains: Some("mur secret ouvert : salle secrete (niveau 0)"), by_frame: 480),
        EventAfter(kind: "feedback", label_contains: Some("rocher cassé"), after_frame: 450, by_frame: 480),
        Event(kind: "shelf", label_contains: Some("glu (douilles)"), by_frame: 780),
        Event(kind: "item_pickup", label_contains: Some("ramasse encre"), by_frame: 800),
        Event(kind: "item_pickup", label_contains: Some("ramasse talisman"), by_frame: 840),
        Event(kind: "item_pickup", label_contains: Some("ramasse coeur"), by_frame: 3480),
        Event(kind: "room", label_contains: Some("salle boss verrouillée"), by_frame: 4775),
        Event(kind: "boss_phase", label_contains: Some("phase 0 → 1"), by_frame: 4980),
        Event(kind: "boss_phase", label_contains: Some("phase 1 → 2"), by_frame: 5040),
        Event(kind: "portal", by_frame: 5080),
        FloorIndex(index: 1, at_frame: 6000),
        EnemyVariant(entity: NetId(436), variant: Some("explosif"), at_frame: 6000),
        Event(kind: "door_lock", label_contains: Some("mur secret ouvert : salle secrete (niveau 1)"), by_frame: 7000),
        Event(kind: "variant_death", label_contains: Some("essaim tuée (424)"), by_frame: 7740),
        Event(kind: "shelf", label_contains: Some("cousin (douilles)"), by_frame: 8930),
        Event(kind: "feedback", label_contains: Some("familier"), by_frame: 8930),
        FamiliarCount(handle: 0, count: 1, at_frame: 9000),
        Event(kind: "variant_death", label_contains: Some("explosif tuée (436)"), by_frame: 9730),
        Event(kind: "door_lock", label_contains: Some("porte à clé ouverte : salle tresor (niveau 1)"), by_frame: 10735),
        Consumable(handle: 0, id: "key", count: 0, at_frame: 10735),
        Event(kind: "room", label_contains: Some("salle boss_profond verrouillée"), by_frame: 12205),
        EventAfter(kind: "boss_phase", label_contains: Some("phase 1 → 2"), after_frame: 12200, by_frame: 12290),
        Event(kind: "victory", by_frame: 12300),
        PlayerAlive(handle: 0, at_frame: 12399),
    ],
)
