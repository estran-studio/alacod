                (from: 3456, to: 3457, buttons: [Fire], pan: (200, -15)),
                (from: 3474, to: 3475, buttons: [Fire], pan: (200, -15)),
                (from: 3492, to: 3493, buttons: [Fire], pan: (200, -15)),
                (from: 3510, to: 3511, buttons: [Fire], pan: (200, -15)),
                (from: 3528, to: 3529, buttons: [Fire], pan: (200, -15)),
                (from: 3546, to: 3547, buttons: [Fire], pan: (200, -15)),
                (from: 2900, to: 2915, buttons: [Down]),
                (from: 3100, to: 3115, buttons: [Up]),
                (from: 3300, to: 3315, buttons: [Down]),
            ],
        ),
    ],
    characters: [
        CharacterPlacement(character: "zombie_1", x: "50", y: "486", at_frame: 900),
        CharacterPlacement(character: "zombie_1", x: "50", y: "486", at_frame: 990),
        CharacterPlacement(character: "zombie_1", x: "50", y: "486", at_frame: 1080),
