                (from: 2880, to: 2881, buttons: [Fire], pan: (200, -15)),
                (from: 2898, to: 2899, buttons: [Fire], pan: (200, -15)),
                (from: 2916, to: 2917, buttons: [Fire], pan: (200, -15)),
                (from: 2934, to: 2935, buttons: [Fire], pan: (200, -15)),
                (from: 2952, to: 2953, buttons: [Fire], pan: (200, -15)),
                (from: 2970, to: 2971, buttons: [Fire], pan: (200, -15)),
                (from: 2988, to: 2989, buttons: [Fire], pan: (200, -15)),
                (from: 3006, to: 3007, buttons: [Fire], pan: (200, -15)),
                (from: 3024, to: 3025, buttons: [Fire], pan: (200, -15)),
                (from: 3042, to: 3043, buttons: [Fire], pan: (200, -15)),
