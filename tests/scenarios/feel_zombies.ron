        CharacterPlacement(character: "zombie_1", x: "50", y: "486", at_frame: 3300),
    ],
    expect: [
        PlayerAlive(handle: 0, at_frame: 3599),
        // Zombies posés : pas de kills de vague, les morts se lisent aux points gagnés.
        Event(kind: "points", label_contains: Some("(kill)"), by_frame: 1020),
        EventAfter(kind: "points", label_contains: Some("(kill)"), after_frame: 3400, by_frame: 3430),
        // 16 des 17 zombies tués (le dernier, posé f3300, est encore debout).
        EntityCount(kind: Enemy, max: Some(1), at_frame: 3599),
    ],
)
