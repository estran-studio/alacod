// polissage-feel (S1-6, `docs/taches/polissage-feel.md`, `docs/conventions.md` §94) : 60 s du feel de zombies,
// vidéo avant/après. Arène vide du bac à sable (`maps/arene_vide.ldtk`), vagues repoussées au-delà de la fin
// (grâce 4000) : 17 zombies posés par le scénario, sur la ligne du joueur (y 486), qui viennent de la droite.
// À regarder :
// - course, f20-f560 : droite 80 frames, arrêt, gauche (demi-tour), arrêt, bas, haut, puis deux diagonales ;
// - dash, f560-f860 : un dash dans chaque direction pendant la course (64 px en 8 frames, départs f581, f661, f736, f796) ;
// - mitraillette, f960-f1760 : tir continu vers la droite, puis en se déplaçant de haut en bas ; zombies
//   tués f1016, f1072, f1127, f1265, f1586, f1601, f1679 ; joueur touché f1553 ;
// - fusil à pompe (f1836), un coup toutes les 40 frames : tués f2004, f2092, f2180, f2267 ;
// - esquive, f2380-f2600 : au centre, tir, dash en arrière (f2530), tir : tué f2495 ;
// - pistolet (f2656), coup par coup en se déplaçant : tués f2826, f3015, f3356, f3428 ; touché f3007.
// Présentation (ne bouge pas la trace) : flash de bouche et recul de l'arme à chaque tir, éclats à chaque
// zombie tué (`ui/feedback.ron`).
Scenario(
    game: "zombies",
    map: "maps/arene_vide.ldtk",
    map_seed: 7,
    frames: 3600,
    powerup_drop_chance_override: "0.0",
    wave_overrides: (
        grace_period_frames: 4000,
    ),
    players: [
        (
            inputs: [
                // Course
                (from: 20, to: 99, buttons: [Right]),
                (from: 130, to: 209, buttons: [Left]),
                (from: 230, to: 289, buttons: [Down]),
                (from: 320, to: 379, buttons: [Up]),
                (from: 400, to: 459, buttons: [Right, Down]),
                (from: 460, to: 519, buttons: [Left, Up]),
                // Dash pendant la course
                (from: 560, to: 574, buttons: [Right]),
                (from: 575, to: 576, buttons: [Right, Dash]),
                (from: 577, to: 620, buttons: [Right]),
                (from: 640, to: 654, buttons: [Left]),
                (from: 655, to: 656, buttons: [Left, Dash]),
                (from: 657, to: 700, buttons: [Left]),
                (from: 720, to: 729, buttons: [Down]),
                (from: 730, to: 731, buttons: [Down, Dash]),
                (from: 732, to: 760, buttons: [Down]),
                (from: 780, to: 789, buttons: [Up]),
                (from: 790, to: 791, buttons: [Up, Dash]),
                (from: 792, to: 840, buttons: [Up]),
                // Mitraillette : zombies sur la ligne du joueur, un à un
                (from: 900, to: 939, buttons: [Left]),
                (from: 960, to: 1399, buttons: [Fire], pan: (200, -15)),
                // Tir en se déplaçant (haut, bas)
                (from: 1400, to: 1421, buttons: [Down, Fire], pan: (200, -15)),
                (from: 1422, to: 1499, buttons: [Fire], pan: (200, -15)),
                (from: 1500, to: 1521, buttons: [Up, Fire], pan: (200, -15)),
                (from: 1522, to: 1599, buttons: [Fire], pan: (200, -15)),
                (from: 1600, to: 1621, buttons: [Down, Fire], pan: (200, -15)),
                (from: 1622, to: 1699, buttons: [Fire], pan: (200, -15)),
                (from: 1700, to: 1721, buttons: [Up]),
                (from: 1722, to: 1760, buttons: [Reload]),
                // Fusil à pompe (mitraillette -> pistolet -> fusil à pompe)
                (from: 1800, to: 1801, buttons: [SwitchWeapon]),
                (from: 1830, to: 1831, buttons: [SwitchWeapon]),
                (from: 1900, to: 1902, buttons: [Fire], pan: (200, -15)),
                (from: 1940, to: 1942, buttons: [Fire], pan: (200, -15)),
                (from: 1980, to: 1982, buttons: [Fire], pan: (200, -15)),
                (from: 2020, to: 2022, buttons: [Fire], pan: (200, -15)),
                (from: 2060, to: 2062, buttons: [Fire], pan: (200, -15)),
                (from: 2100, to: 2102, buttons: [Fire], pan: (200, -15)),
                (from: 2140, to: 2142, buttons: [Fire], pan: (200, -15)),
                (from: 2180, to: 2182, buttons: [Fire], pan: (200, -15)),
                (from: 2220, to: 2222, buttons: [Fire], pan: (200, -15)),
                (from: 2260, to: 2262, buttons: [Fire], pan: (200, -15)),
                (from: 2300, to: 2302, buttons: [Fire], pan: (200, -15)),
                // Esquive : au centre, tir, dash en arrière, tir
                (from: 2380, to: 2419, buttons: [Right]),
                (from: 2470, to: 2472, buttons: [Fire], pan: (200, -15)),
                (from: 2500, to: 2502, buttons: [Fire], pan: (200, -15)),
                (from: 2520, to: 2529, buttons: [Left]),
                (from: 2530, to: 2531, buttons: [Left, Dash]),
                (from: 2532, to: 2545, buttons: [Left]),
                (from: 2550, to: 2552, buttons: [Fire], pan: (200, -15)),
                (from: 2580, to: 2582, buttons: [Fire], pan: (200, -15)),
                // Pistolet (fusil à pompe -> mitraillette -> pistolet), coup par coup, en se déplaçant
                (from: 2620, to: 2621, buttons: [SwitchWeapon]),
                (from: 2650, to: 2651, buttons: [SwitchWeapon]),
                (from: 2700, to: 2701, buttons: [Fire], pan: (200, -15)),
                (from: 2718, to: 2719, buttons: [Fire], pan: (200, -15)),
                (from: 2736, to: 2737, buttons: [Fire], pan: (200, -15)),
                (from: 2754, to: 2755, buttons: [Fire], pan: (200, -15)),
                (from: 2772, to: 2773, buttons: [Fire], pan: (200, -15)),
                (from: 2790, to: 2791, buttons: [Fire], pan: (200, -15)),
