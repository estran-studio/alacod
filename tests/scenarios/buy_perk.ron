// Le joueur (solde 3000) marche jusqu'à la machine à perk de la salle de départ
// (SodaLocation "juggernog", games/zombies/assets/exemples/test_map_shop.ldtk) et l'achète.
//
// À regarder : le joueur monte jusqu'au mur (f10-65) puis se déplace un peu à gauche vers la
// machine (f65-74, 22,5 px), achète Juggernog en interagissant (f93-108) : sa vie maximum
// double (100 -> 200) et sa vie actuelle remonte immédiatement de la même différence
// (200/200), son solde tombe à 500.
Scenario(
    // Isoler ce scénario des drops aléatoires ; powerup_drop_on_kill teste ce chemin.
    powerup_drop_chance_override: "0.0",
    game: "zombies",
    map: "exemples/test_map_shop.ldtk",
    frames: 160,
    players: [
        (
            inputs: [
                (from: 10, to: 65, buttons: [Up]),
                (from: 65, to: 74, buttons: [Left]),
                (from: 93, to: 108, buttons: [Interaction]),
            ],
            currency: 3000,
        ),
    ],
    expect: [
        // 3000 - 2500 (prix de Juggernog) = 500.
        Currency(handle: 0, min: 500, max: 500, at_frame: 120),
        // MaxHealth de base 100, Juggernog double (Mul "2.0").
        Stat(handle: 0, stat: MaxHealth, value: 200.0, at_frame: 120),
        // Health.current remonte de la différence à l'achat (voir
        // interaction::handle_perk_purchase_interaction) : plein (200/200), pas seulement
        // plafonné par le nouveau max comme le ferait sync_health_from_stats seul.
        Health(handle: 0, min: 200.0, max: 200.0, at_frame: 120),
    ],
)
