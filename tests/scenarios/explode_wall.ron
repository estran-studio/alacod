// T1.6 (terrain destructible, docs/conventions.md §21) : caverne `petite` du testbed (graine
// 123456). Le joueur 0 apparaît en case (23, 15) et tire une grenade de terrassement
// (`grenade_creuse` : sans rebond, `on_expire: [DestroyTerrain(radius: "40.0")]`) vers l'est,
// où la première roche est à trois cases, en (26, 15).
//
// À regarder : la grenade part vers la droite, s'arrête contre la roche et creuse un cratère :
// les cases (26, 15) et (27, 15) deviennent du sol, la bordure (47, 15) reste un mur.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "cave:petite",
    map_seed: 123456,
    frames: 600,
    players: [
        (
            weapon: "grenade_creuse",
            inputs: [
                (from: 30, to: 32, buttons: [Fire], pan: (100, 0)),
            ],
        ),
    ],
    expect: [
        CellState(x: 26, y: 15, kind: Rock, at_frame: 29),
        CellState(x: 27, y: 15, kind: Rock, at_frame: 29),
        CellState(x: 26, y: 15, kind: Floor, at_frame: 120),
        CellState(x: 27, y: 15, kind: Floor, at_frame: 120),
        CellState(x: 47, y: 15, kind: Wall, at_frame: 599),
    ],
)
