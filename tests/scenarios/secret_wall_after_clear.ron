// M3-T4 (docs/conventions.md §69) : nettoyer une salle voisine n'ouvre pas le mur secret. Carte
// `testbed/salles_secret_combat.ldtk` (graine 1) : départ, salle de combat (deux `dummy`), puis, collée à l'est
// de la salle de combat, une salle de type `secrete` ; la porte est de la salle de combat et sa jumelle forment
// le mur secret. Le joueur entre dans la salle de combat (f30-90 : elle se verrouille f85), abat les deux
// `dummy` (f100-480 : salle nettoyée f489, portes de salle rouvertes), puis marche vers la porte secrète.
//
// À regarder : après le nettoyage les portes ordinaires s'ouvrent, mais la porte secrète reste fermée
// (`DoorLocked` vrai) et le joueur s'arrête contre elle (x -714,8, y -532,6) ; aucune bombe n'a été posée.
// Sans l'exclusion des portes secrètes dans `room_lock_system` (`Locked → Cleared`), le nettoyage retirait aussi
// leur collider : le mur s'ouvrait sans explosion.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/salles_secret_combat.ldtk",
    map_seed: 1,
    frames: 720,
    players: [
        (inputs: [
            (from: 30, to: 90, buttons: [Right]),
            (from: 100, to: 480, buttons: [Fire], pan: (100, 0)),
            (from: 500, to: 700, buttons: [Right, Up]),
        ]),
    ],
    expect: [
        RoomState(kind: "combat", state: Locked, at_frame: 150),
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 150),
        RoomState(kind: "combat", state: Locked, at_frame: 480),
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 480),
        RoomState(kind: "combat", state: Cleared, at_frame: 500),
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 500),
        RoomState(kind: "combat", state: Cleared, at_frame: 719),
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 719),
        PlayerPosition(handle: 0, x: -714.8, y: -532.6, tolerance: 1, at_frame: 640),
        PlayerPosition(handle: 0, x: -714.8, y: -532.6, tolerance: 1, at_frame: 719),
        Consumable(handle: 0, id: "bomb", count: 0, at_frame: 719),
    ],
)
