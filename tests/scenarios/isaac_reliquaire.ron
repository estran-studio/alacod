// M3-T11b (docs/conventions.md §76.2) : l'effet `OnPickup` du `reliquaire` d'`isaac` (4 points de vie d'âme, `GainSoul`). Un objet donné au départ
// (`PlayerScript::items`) ne déclenche pas `OnPickup` : le scénario généré `item_reliquaire` ne prouve que la tenue ; celui-ci le pose au sol.
//
// À regarder : f10 le joueur ramasse le reliquaire (posé sous ses pieds à f1) : ses points de vie d'âme passent de 0 à 4 ; f40 le ramassage d'un autre objet (`pouls`) ne rend rien (filtre `item`, relecture).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    map_seed: 1,
    frames: 80,
    items: [
        (id: "reliquaire", x: "-24.0", y: "-8.0", at_frame: 1),
        (id: "pouls", x: "-24.0", y: "-8.0", at_frame: 30),
    ],
    players: [(inputs: [
        (from: 10, to: 11, buttons: [Interaction]),
        (from: 40, to: 41, buttons: [Interaction]),
    ])],
    expect: [
        ExtraHealth(handle: 0, n: 0.0, at_frame: 8),
        HasItem(handle: 0, id: "reliquaire", at_frame: 20),
        ExtraHealth(handle: 0, n: 4.0, at_frame: 20),
        HasItem(handle: 0, id: "pouls", at_frame: 60),
        ExtraHealth(handle: 0, n: 4.0, at_frame: 79),
        // M3-T16 (§81) : les deux cœurs d'âme s'affichent après le ramassage ; le bandeau annonce chaque objet.
        HudText(source: "hearts", contains: "3 / 3", at_frame: 8),
        HudText(source: "item_banner", empty: true, at_frame: 8),
        HudText(source: "hearts", contains: "3 / 3 · âme 2", at_frame: 20),
        HudText(source: "item_banner", contains: "Châsse d'âme", at_frame: 20),
        HudText(source: "item_banner", contains: "Pouls", at_frame: 60),
    ],
)
