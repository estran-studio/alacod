// M3-T6 (docs/conventions.md §71) : `MirrorShot`. Le joueur 0 (arme `larme`, carte `surfaces`) tire une seule larme
// vers l'est à f30 ; son `compagnon` (arme `pistol`, sans les modificateurs du porteur : Q13) tire dans la même
// direction. `target` est placée en ligne. Témoin `familiar_mirror_shot_sans_objet` : la même larme seule.
//
// À regarder : deux balles partent à la suite, la seconde du familier ; la cible reçoit deux coups.

Scenario(
    game: "testbed",
    map: "testbed/surfaces.ldtk",
    frames: 160,
    powerup_drop_chance_override: "0",
    characters: [(character: "target", x: "-400.0", y: "254.0", at_frame: 1)],
    players: [
        (
            inputs: [
            (from: 30, to: 31, buttons: [Fire], pan: (127, 0)),
            ],
            weapon: "larme",
            items: ["compagnon"],
        ),
    ],
    expect: [
        FamiliarCount(handle: 0, count: 1, at_frame: 5),
        // Le familier tire avec le porteur (f30) : sa balle (`pistol`, plus rapide que la larme) touche la
        // cible (net id 15) à f58, la larme du porteur à f83 : deux coups, pas un de plus.
        EntityHits(net_id: 15, min: 0, max: Some(0), at_frame: 57),
        EntityHits(net_id: 15, min: 1, max: Some(1), at_frame: 58),
        EntityHits(net_id: 15, min: 1, max: Some(1), at_frame: 82),
        EntityHits(net_id: 15, min: 2, max: Some(2), at_frame: 83),
        EntityHits(net_id: 15, min: 2, max: Some(2), at_frame: 159),
    ],
)
