// M3-T6 (docs/conventions.md §71) : `MirrorShot`. Le joueur 0 (arme `larme`, carte `surfaces`) tire une seule larme
// vers l'est (tir demandé à f30, balles parties à f35) ; son `compagnon` tire dans la même direction **les larmes du porteur** (même arme `larme`, Q13, §71 : avant, son propre
// `pistol`). `target` est placée en ligne. Témoin `familiar_mirror_shot_sans_objet` : la même larme seule.
//
// À regarder : deux balles partent à la suite, la seconde du familier ; la cible reçoit deux coups.

Scenario(
    game: "testbed",
    map: "testbed/surfaces.ldtk",
    frames: 160,
    powerup_drop_chance_override: "0",
    characters: [(character: "target", x: "-400.0", y: "254.0", at_frame: 1)],
    players: [
        (
            inputs: [
            (from: 30, to: 31, buttons: [Fire], pan: (127, 0)),
            ],
            weapon: "larme",
            items: ["compagnon"],
        ),
    ],
    expect: [
        FamiliarCount(handle: 0, count: 1, at_frame: 5),
        // Le familier tire avec le porteur (f35) : sa larme (même arme, donc même vitesse ; le familier est à l'est
        // du porteur, plus près de la cible) touche la cible (net id 15) à f81, la larme du porteur à f83 : deux coups,
        // pas un de plus. (Avant Q13 la balle `pistol` du familier touchait à f58.)
        EntityHits(net_id: 15, min: 0, max: Some(0), at_frame: 80),
        EntityHits(net_id: 15, min: 1, max: Some(1), at_frame: 81),
        EntityHits(net_id: 15, min: 1, max: Some(1), at_frame: 82),
        EntityHits(net_id: 15, min: 2, max: Some(2), at_frame: 83),
        EntityHits(net_id: 15, min: 2, max: Some(2), at_frame: 159),
    ],
)
