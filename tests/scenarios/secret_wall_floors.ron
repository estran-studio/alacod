// M3-T4 (docs/conventions.md §69) : le mur secret renaît fermé à l'étage suivant. Séquence `deux_secrets` : deux étages
// identiques de `testbed/salles_secret_floors.ldtk` (même carte, donc même monde et mêmes `LevelId`), un `dummy`
// dans la salle de départ qui garde le portail fermé. Étage 0 : le joueur marche à la porte secrète (f10-60),
// pose une bombe (f70, explosion f95) qui l'ouvre, revient sur le portail (f100-140) et abat le `dummy` (f140-300) ;
// le portail s'ouvre sous ses pieds et il passe à l'étage 1 (f306), où le même dummy renaît. Étage 1 : même trajet,
// seconde bombe (f370, explosion f395).
//
// À regarder : porte fermée (`DoorLocked` vrai) au départ, ouverte après la première bombe ; à l'étage 1 elle est de
// nouveau fermée (le joueur s'arrête contre elle, x -842,4, f365-390) puis la seconde bombe l'ouvre et il passe dans
// la salle secrète (x -714 à f519). Sans la remise à zéro de `DoorLocks` à la transition d'étage, la porte
// naissait fermée mais « déjà ouverte » dans l'état : aucune bombe ne l'ouvrait plus.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    floors: Some("deux_secrets"),
    map_seed: 1,
    frames: 520,
    players: [
        (
            bomb: (fuse_frames: 20, radius: "40.0", damage: "10.0", friendly_fire: Never),
            items: ["bomb", "bomb"],
            inputs: [
                (from: 10, to: 60, buttons: [Right], pan: (0, 0)),
                (from: 70, to: 71, buttons: [Bomb]),
                (from: 100, to: 140, buttons: [Left], pan: (0, 0)),
                (from: 140, to: 300, buttons: [Fire], pan: (0, 100)),
                (from: 310, to: 360, buttons: [Right], pan: (0, 0)),
                (from: 370, to: 371, buttons: [Bomb]),
                (from: 410, to: 500, buttons: [Right], pan: (0, 0)),
            ],
        ),
    ],
    expect: [
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 50),
        PlayerPosition(handle: 0, x: -842.4, y: -584, tolerance: 1, at_frame: 50),
        DoorLocked(kind: "secrete", nth: 0, locked: false, at_frame: 100),
        FloorIndex(index: 0, at_frame: 290),
        DoorLocked(kind: "secrete", nth: 0, locked: false, at_frame: 290),
        FloorIndex(index: 1, at_frame: 320),
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 320),
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 390),
        PlayerPosition(handle: 0, x: -842.4, y: -584, tolerance: 1, at_frame: 390),
        DoorLocked(kind: "secrete", nth: 0, locked: false, at_frame: 420),
        PlayerPosition(handle: 0, x: -714, y: -574, tolerance: 1.5, at_frame: 519),
    ],
)
