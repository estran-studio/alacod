// M3-T6 (§71) : perdre l'objet détruit le familier. Le joueur 0 tient l'actif `compagnon_actif` (un `compagnon`)
// et un `orbital` passif. Un second actif, `eclat`, est posé à ses pieds à f40 ; il le ramasse par Interaction à
// f50 : l'actif remplacé tombe au sol et son familier disparaît (`despawn_rollback`), l'orbital reste.
//
// À regarder : deux familiers, puis un seul à partir du ramassage (f50).
Scenario(
    game: "testbed",
    map: "testbed/surfaces.ldtk",
    frames: 120,
    powerup_drop_chance_override: "0",
    items: [(id: "eclat", x: "-568.0", y: "248.0", at_frame: 40)],
    players: [
        (
            inputs: [(from: 50, to: 51, buttons: [Interaction])],
            weapon: "larme",
            items: ["orbital", "compagnon_actif"],
        ),
    ],
    expect: [
        ItemCount(handle: 0, id: "compagnon_actif", count: 1, at_frame: 5),
        // `orbital` (passif, rang 0) puis `compagnon_actif` (actif, rang 1) : deux familiers.
        FamiliarCount(handle: 0, count: 2, at_frame: 5),
        FamiliarCount(handle: 0, count: 2, at_frame: 45),
        // f50 : `eclat` remplace l'actif ; son familier est détruit, l'orbital reste (rang 0).
        ItemCount(handle: 0, id: "compagnon_actif", count: 0, at_frame: 60),
        HasItem(handle: 0, id: "eclat", at_frame: 60),
        FamiliarCount(handle: 0, count: 1, at_frame: 60),
        FamiliarDistance(handle: 0, rank: 0, min: Some(35.5), max: Some(36.5), at_frame: 100),
        FamiliarCount(handle: 0, count: 1, at_frame: 119),
    ],
)
