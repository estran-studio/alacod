// M3-T4 (docs/conventions.md §69) : témoin de `secret_wall_open_then_fight`. Même carte, même parcours, même
// combat dans la salle voisine, mais aucune bombe : la porte secrète reste fermée (`DoorLocked` vrai) pendant et
// après le combat, et le joueur s'arrête contre elle au lieu de la traverser.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/salles_secret_combat_vide.ldtk",
    map_seed: 1,
    frames: 700,
    characters: [(character: "dummy", x: "-730.0", y: "-590.0", at_frame: 250)],
    players: [
        (
            bomb: (fuse_frames: 20, radius: "40.0", damage: "0.0", friendly_fire: Never),
            items: [],
            inputs: [
                (from: 30, to: 90, buttons: [Right]),
                (from: 90, to: 120, buttons: [Right, Up]),
                (from: 160, to: 200, buttons: [Left, Down]),
                (from: 300, to: 480, buttons: [Fire], pan: (100, 20)),
                (from: 500, to: 680, buttons: [Right, Up]),
            ],
        ),
    ],
    expect: [
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 200),
        RoomState(kind: "combat", state: Locked, at_frame: 400),
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 400),
        RoomState(kind: "combat", state: Cleared, at_frame: 520),
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 699),
        PlayerPosition(handle: 0, x: -714.8, y: -532.6, tolerance: 1.5, at_frame: 699),
    ],
)
