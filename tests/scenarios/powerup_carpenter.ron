// T2.5 (power-ups, chantier C1 v0) : Carpenter répare toutes les fenêtres de la carte à
// santé maximale. Réutilise `testbed/window.ldtk` (comme `testbed_window.ron` : le
// `breacher` casse la fenêtre, seul passage vers le joueur) plutôt que `testbed/arena.ldtk`
// — seul power-up de ce chantier à dévier de l'arène : il faut une fenêtre cassée à
// réparer, absente de l'arène (T2.9 n'y en a pas posé).
//
// À regarder : le joueur ne bouge pas ; le breacher traverse sa poche, casse la fenêtre
// (~f420, comme `testbed_window`) et avance vers le joueur ; un power-up Carpenter apparaît
// sur le joueur à f450 et répare la fenêtre aussitôt (santé 3/3 dès f451).
Scenario(
    game: "testbed",
    map: "testbed/window.ldtk",
    frames: 520,
    players: [
        (),
    ],
    powerups: [
        (id: "carpenter", x: 686.0, y: -444.0, at_frame: 450),
    ],
    expect: [
        WindowsBrokenAtLeast(windows: 1, at_frame: 420),
        WindowHealth(window: 3, health: 3, at_frame: 480),
    ],
)
