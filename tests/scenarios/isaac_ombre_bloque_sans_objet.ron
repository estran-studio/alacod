    frames: 500,
    characters: [(character: "tourelle_croix", x: "80.0", y: "-8.0", at_frame: 1)],
    players: [(inputs: [])],
    expect: [
        Health(handle: 0, min: 5.0, max: 5.0, at_frame: 100),
        Health(handle: 0, min: 5.0, max: 5.0, at_frame: 230),
        Health(handle: 0, min: 5.0, max: 5.0, at_frame: 300),
    ],
)
