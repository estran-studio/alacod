// M3-T9 (docs/conventions.md §74) : la curse « Blind » (`HideItemNames`) ne cache ni la santé ni la
// minicarte ni les salles : c'est le témoin de `curse_hides_minimap` et `curse_hides_health`. `isaac`,
// séquence `sous_sol_maudit`, graine 5 : « blind ». Le nom des objets et armes à ramasser ou acheter
// devient « ??? » dans le prompt du HUD (hors du `HudSnapshot` que lisent les attentes : prouvé par le
// test unitaire `blind_curse_hides_the_name_of_pickups_and_keeps_the_rest`). Taille de l'étage : la
// grammaire de `sous_sol` (8 à 12 salles), non agrandie.
//
// À regarder : minicarte et vie visibles, « Malédiction : blind ».
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    floors: Some("sous_sol_maudit"),
    map_seed: 5,
    frames: 60,
    players: [(inputs: [])],
    expect: [
        Curse(floor: 0, id: Some("blind"), at_frame: 30),
        HudText(source: "curses", contains: "blind", at_frame: 30),
        HudText(source: "health", contains: "6/6", at_frame: 30),
        HudText(source: "minimap", contains: "depart · visitée · actuelle", at_frame: 30),
        RoomCount(min: 8, max: Some(12), at_frame: 30),
    ],
)
