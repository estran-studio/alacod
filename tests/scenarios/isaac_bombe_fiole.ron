// M3-T11d2 (docs/conventions.md §76.5) : `bombe_fiole` d'`isaac`, actif rechargé par le temps (900 frames) : explosion de rayon 60 et 8 dégâts centrée sur le porteur. Deux cibles (5 000 PV) posées à f5 : l'une à 38 unités (dans le rayon), l'autre à 98 (hors rayon). Le joueur appuie sur `UseActive` à f30. L'explosion blesserait aussi le porteur (tir ami, 8 dégâts pour 6 PV) : le `GainShield(1)` de l'objet absorbe ce souffle.
//
// À regarder : f40 la cible proche a perdu 8 PV (4 992), la lointaine reste à 5 000 jusqu'à la fin ; le moment clé `explosion` ; le joueur est toujours à 6 PV (bouclier consommé). La charge de l'actif (`Frames`, rechargée par le temps dès la frame de l'usage) n'est pas lue par ce scénario.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    map_seed: 1,
    frames: 120,
    characters: [
        (character: "cible", x: "14.0", y: "-8.0", at_frame: 5),
        (character: "cible", x: "-24.0", y: "90.0", at_frame: 5),
    ],
    players: [(
        items: ["bombe_fiole"],
        inputs: [
            (from: 30, to: 31, buttons: [UseActive]),
        ],
    )],
    expect: [
        HasItem(handle: 0, id: "bombe_fiole", at_frame: 1),
        EntityHealth(net_id: 180, min: 5000.0, max: 5000.0, at_frame: 29),
        EntityHealth(net_id: 181, min: 5000.0, max: 5000.0, at_frame: 29),
        Health(handle: 0, min: 6.0, max: 6.0, at_frame: 29),
        EntityHealth(net_id: 180, min: 4992.0, max: 4992.0, at_frame: 40),
        EntityHealth(net_id: 181, min: 5000.0, max: 5000.0, at_frame: 119),
        Health(handle: 0, min: 6.0, max: 6.0, at_frame: 40),
        Health(handle: 0, min: 6.0, max: 6.0, at_frame: 119),
        Event(kind: "explosion", by_frame: 40),
        PlayerAlive(handle: 0, at_frame: 119),
    ],
)
