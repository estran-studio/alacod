// X-6c (testbed, conventions §120) : deux couverts à égale distance, choix déterministe. `tireur_couvert` à (600, 696), le joueur 0 immobile à (424, 696) ; deux caisses
// à ±30 de l'axe joueur-tireur (positions y 666 et 726, centres de collider décalés de −6), l'une au nord, l'autre au sud : leurs points abrités les plus
// proches, (601, 666) et (601, 726), sont à la même distance du tireur (30 unités, comparée au seizième d'unité près : le tireur dérive de quelques bits). Le plus petit `GgrsNetId` du couvert l'emporte : ici la caisse posée en premier (sud)
// est celle de l'abri, la caisse « sud » est posée en premier dans la liste des personnages. Contre-épreuve de `repli_couvert_egalite` : l'ordre de la liste inversé envoie le tireur de l'autre côté.
//
// À regarder : le tireur se replie derrière la caisse sud, jamais l'autre.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/arena.ldtk",
    frames: 110,
    characters: [
        (character: "couvert", x: "580.0", y: "726.0", at_frame: 1),
        (character: "couvert", x: "580.0", y: "666.0", at_frame: 1),
        (character: "tireur_couvert", x: "600.0", y: "696.0", at_frame: 1),
    ],
    players: [(inputs: [])],
    expect: [
        EnemyState(entity: Placed(2), behavior: "Shoot", at_frame: 20),
        EnemyState(entity: Placed(2), behavior: "TakeCover", at_frame: 70),
        EnemyPosition(entity: Placed(2), x_min: Some(596.0), x_max: Some(606.0), y_min: Some(720.0), y_max: Some(732.0), at_frame: 90),
        CoverSight(entity: Placed(2), handle: 0, blocked: true, at_frame: 90),
    ],
)
