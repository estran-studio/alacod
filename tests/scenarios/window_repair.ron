// Le joueur se poste devant la fenêtre du bas (fenêtre 21) et la répare (Interaction maintenue)
// pendant que les zombies la frappent de l'extérieur. Vérifie qu'une fenêtre cassée puis réparée
// bloque de nouveau les zombies : ils doivent la recasser pour entrer.
//
// À regarder : les zombies frappent la fenêtre (1 PV à f387), elle cède (f447), le joueur la répare
// aussitôt (1 PV à f470, il pousse vers le bas pour rester devant) et les zombies doivent la frapper
// encore (cède avant f540). D10 : la carte n'a plus la salle de départ en double, les ids et la
// position de la fenêtre ont changé (fenêtre 21) ; le joueur s'arrête à x 454 (Right f10-25).
// Le joueur essaie alors de sortir par la fenêtre cassée (f560-620) : il reste bloqué.
Scenario(
    // Isoler ce scénario des drops aléatoires ; powerup_drop_on_kill teste ce chemin.
    powerup_drop_chance_override: "0.0",
    game: "zombies",
    frames: 1100,
    // S5 : figer le rythme de cette mise en scène de mécanique.
    // Les assertions restent indépendantes de l'équilibrage des parties.
    wave_overrides: (
        base_enemies: 6,
        enemies_per_wave: 4,
        max_concurrent_enemies: 8,
        spawn_interval_frames: 60,
    ),
    players: [
        (inputs: [
            (from: 10, to: 25, buttons: [Right]),
            (from: 10, to: 120, buttons: [Down]),
            (from: 340, to: 550, buttons: [Interaction, Down]),
            // La fenêtre est recassée : le joueur tente de sortir par elle
            (from: 560, to: 620, buttons: [Down]),
        ]),
    ],
    expect: [
        // Réparée pendant la vague (tirage des flux RNG, T1.6) : bloquante à nouveau
        WindowHealth(window: 21, health: 1, at_frame: 470),
        // Les zombies ont dû la recasser
        WindowHealth(window: 21, health: 0, at_frame: 540),
        // Une fenêtre cassée laisse passer les zombies, pas le joueur : il reste dans la pièce
        PlayerPosition(handle: 0, x: 454, y: 608, tolerance: 5, at_frame: 625),
    ],
)
