// M3-T4 (docs/conventions.md §69) : le mur secret ouvert reste ouvert quand la salle voisine se verrouille puis se
// nettoie. Carte `testbed/salles_secret_combat_vide.ldtk` : départ, salle de combat **sans ennemi**, salle secrète
// collée à l'est (voir `secret_wall_after_clear`). Le joueur rejoint la porte secrète (f30-120), pose une bombe
// (f130, explosion f155 : le mur s'ouvre), s'enfonce dans la salle de combat (f160-200), puis un `dummy` y est placé
// (f250) : la salle se verrouille (f250), le joueur l'abat (f300-480, salle nettoyée f455) et traverse la porte
// secrète (f500-680, x -586 à f699).
//
// À regarder : `DoorLocked` vrai avant la bombe, faux de f160 à la fin, pendant le verrouillage et après le
// nettoyage ; le joueur franchit l'ancien mur. Sans l'exclusion des portes secrètes dans le verrouillage
// (`to_close`), la porte jumelle ouverte était refermée par le verrouillage de la salle de combat, puis `Locked →
// Cleared` ne la rouvrait pas : mur fermé malgré l'explosion. Témoin : `secret_wall_open_then_fight_sans_bombe`,
// même parcours sans bombe : la porte reste fermée, le joueur s'arrête contre elle.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/salles_secret_combat_vide.ldtk",
    map_seed: 1,
    frames: 700,
    characters: [(character: "dummy", x: "-730.0", y: "-590.0", at_frame: 250)],
    players: [
        (
            bomb: (fuse_frames: 20, radius: "40.0", damage: "0.0", friendly_fire: Never),
            items: ["bomb"],
            inputs: [
                (from: 30, to: 90, buttons: [Right]),
                (from: 90, to: 120, buttons: [Right, Up]),
                (from: 130, to: 131, buttons: [Bomb]),
                (from: 160, to: 200, buttons: [Left, Down]),
                (from: 300, to: 480, buttons: [Fire], pan: (100, 20)),
                (from: 500, to: 680, buttons: [Right, Up]),
            ],
        ),
    ],
    expect: [
        DoorLocked(kind: "secrete", nth: 0, locked: true, at_frame: 100),
        DoorLocked(kind: "secrete", nth: 0, locked: false, at_frame: 200),
        RoomState(kind: "combat", state: Locked, at_frame: 400),
        DoorLocked(kind: "secrete", nth: 0, locked: false, at_frame: 400),
        RoomState(kind: "combat", state: Cleared, at_frame: 520),
        DoorLocked(kind: "secrete", nth: 0, locked: false, at_frame: 520),
        DoorLocked(kind: "secrete", nth: 0, locked: false, at_frame: 699),
        PlayerPosition(handle: 0, x: -586.5, y: -532.8, tolerance: 1.5, at_frame: 699),
    ],
)
