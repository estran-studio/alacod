// X-3 (testbed) : repère « début d'une action ». Le passif `fraction_esquive` ajoute +1 de dégâts à
// la frame exacte qui suit de 5 frames le début du dash en cours (`Timing(DashStart, offset: 5)`,
// fenêtre parfaite de 0 frame) : un instant choisi dans l'action, ici pendant les 8 frames du dash.
// Les inputs agissent 5 frames plus tard (délai GGRS).
//
// À regarder : deux dashs à droite (appuis f35 et f100, dashs f40 et f105). Les dégâts restent à 1
// jusqu'à f45 (lecture en début de frame), passent à 2 à f46 (effet de f45), puis à 3 à f111 ; hors dash ou après la fenêtre, rien.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/arena.ldtk",
    frames: 160,
    players: [
        (items: ["fraction_esquive"], inputs: [
            (from: 35, to: 36, buttons: [Right, Dash]),
            (from: 100, to: 101, buttons: [Right, Dash]),
        ]),
    ],
    expect: [
        Stat(handle: 0, stat: Damage, value: 1.0, at_frame: 38),
        Stat(handle: 0, stat: Damage, value: 1.0, at_frame: 45),
        Stat(handle: 0, stat: Damage, value: 2.0, at_frame: 46),
        Stat(handle: 0, stat: Damage, value: 2.0, at_frame: 60),
        Stat(handle: 0, stat: Damage, value: 2.0, at_frame: 100),
        Stat(handle: 0, stat: Damage, value: 3.0, at_frame: 130),
        Stat(handle: 0, stat: Damage, value: 3.0, at_frame: 159),
    ],
)
