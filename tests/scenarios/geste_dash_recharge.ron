// P-1 (docs/conventions.md §110, testbed) : un dash qui recouvre la fin du rechargement.
// `arme_a_gestes` porte `reload_through_dash` : le rechargement lancé par le coup de f29 (geste de
// tir jusqu'à f47, puis 72 frames) se termine à f119 (vue à la vérification de f120) **même si le
// joueur esquive à ce moment-là** (dash effectif f110, 24 frames : en cours jusqu'à f134). Le même dash
// pendant l'épaulé (`geste_dash_epaule`) annule le coup.
//
// À regarder : un coup vers la droite, le joueur recharge, esquive vers le haut à f110 ; le chargeur
// est plein à f120, pile comme sans esquive.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/arena.ldtk",
    frames: 160,
    players: [
        (weapon: "arme_a_gestes",
         dash: Some((distance: Some("48.0"), duration_frames: Some(24), iframes: Some(12), cooldown_frames: Some(0))),
         inputs: [
            (from: 15, to: 16, buttons: [Fire], pan: (100, 0)),
            (from: 16, to: 105, buttons: [], pan: (100, 0)),
            (from: 105, to: 106, buttons: [Up, Dash], pan: (100, 0)),
            (from: 106, to: 160, buttons: [], pan: (100, 0)),
        ]),
    ],
    expect: [
        Ammo(handle: 0, ammo: 0, at_frame: 109),
        Ammo(handle: 0, ammo: 0, at_frame: 119),
        Ammo(handle: 0, ammo: 1, at_frame: 120),
        PlayerAlive(handle: 0, at_frame: 160),
    ],
)
