// M3-T18 (critère 5 du §8.1, synctest à 4) : quatre bots `explorateur` nus (politique de `games/isaac/assets/bot.ron`, sans armure ni
// modificateur, D93) jouent une partie ordinaire d'`isaac` (séquence par défaut, sans `floors:`, graine 1) jusqu'au second étage. Chacun
// part avec un objet de larmes et un familier (`items`, la seule mise en place : familiers et larmes modifiées des **quatre** joueurs dès
// la frame 1) : joueur 0 `bifurque` + `frere` (suiveur), joueur 1 `lynx` + `orbe` (orbital), joueur 2 `billard` + `cousin` (suiveur),
// joueur 3 `aiguille` + `anneau` (deux orbitaux) ; le joueur 3 achète en plus `cousin` à la boutique (f1479, troisième familier).
//
// À regarder : cinq familiers dès f1 (deux suiveurs, trois orbitaux), larmes qui se divisent, guidées et perforantes (le rebond de
// `billard` n'a pas de signe propre, §82 : ses larmes reviennent des murs) ;
// boutique : trois présentoirs vendus à deux acheteurs (f1455 à f1523) ; `gardien` (phases f2441 et f2484, portail f2525) ; second étage f2822 : les six familiers
// réapparaissent auprès de leurs porteurs ; le joueur 2 tombe à terre (f2923) et un coéquipier le réanime (f3181).
Scenario(
    game: "isaac",
    map_seed: 1,
    frames: 3300,
    explorer: Some((
        shopping: true,
        shop: HeartsThenCheapest(low_health: "0.5"),
        detour: (shells: Some(400)),
        devil: Never,
        bombs: (secret: true, secret_min_neighbours: 2, rocks: true, reserve: 0),
        oscillation: Hysteresis,
        combat_aware: true,
    )),
    players: [
        (bot: explorateur, items: ["bifurque", "frere"]),
        (bot: explorateur, items: ["lynx", "orbe"]),
        (bot: explorateur, items: ["billard", "cousin"]),
        (bot: explorateur, items: ["aiguille", "anneau"]),
    ],
    expect: [
        FamiliarCount(handle: 0, count: 1, at_frame: 10),
        FamiliarCount(handle: 1, count: 1, at_frame: 10),
        FamiliarCount(handle: 2, count: 1, at_frame: 10),
        FamiliarCount(handle: 3, count: 2, at_frame: 10),
        // Chaque joueur tient son objet de larmes dès la première frame (`items` du scénario) : le synctest à quatre
        // fait tirer des larmes modifiées par quatre porteurs. Le rebond de `billard` (joueur 2) n'a pas d'indice
        // `feedback` (§82) : aucune attente ne prouve son effet, seulement sa tenue et ses tirs (voir le rapport).
        HasItem(handle: 0, id: "bifurque", at_frame: 20),
        HasItem(handle: 1, id: "lynx", at_frame: 20),
        HasItem(handle: 2, id: "billard", at_frame: 20),
        HasItem(handle: 3, id: "aiguille", at_frame: 20),
        Event(kind: "feedback", label_contains: Some("(division"), by_frame: 600),
        Event(kind: "feedback", label_contains: Some("(guidée)"), by_frame: 600),
        Event(kind: "feedback", label_contains: Some("(perforante)"), by_frame: 600),
        Event(kind: "shelf", label_contains: Some("cousin (douilles)"), by_frame: 1485),
        FamiliarCount(handle: 3, count: 3, at_frame: 1500),
        Event(kind: "boss_phase", label_contains: Some("phase 1 → 2"), by_frame: 2490),
        Event(kind: "portal", by_frame: 2530),
        FloorIndex(index: 1, at_frame: 2830),
        FamiliarCount(handle: 0, count: 1, at_frame: 2830),
        FamiliarCount(handle: 1, count: 1, at_frame: 2830),
        FamiliarCount(handle: 2, count: 1, at_frame: 2830),
        FamiliarCount(handle: 3, count: 3, at_frame: 2830),
        PlayerDowned(handle: 2, at_frame: 2930),
        PlayerRevived(handle: 2, by_frame: 3185),
        PlayerAlive(handle: 0, at_frame: 3299),
        PlayerAlive(handle: 1, at_frame: 3299),
        PlayerAlive(handle: 2, at_frame: 3299),
        PlayerAlive(handle: 3, at_frame: 3299),
    ],
)
