// X-3 (testbed, revue indépendante P2) : le repère d'une horloge de portée `Floor` vaut le temps
// d'étage **déjà remis à zéro** quand `OnFloorStart` est évalué (`apply_triggered_effects_system`,
// avant `clock_system`). Séquence `deux_niveaux` (comme `portal_next_floor` : le follower meurt,
// le portail s'ouvre f62, traversée f230) avec l'horloge `debut_etage` (événement `debut` à 0,
// sans répétition) et le passif `reveil` : chaque entrée d'étage tombe pile sur `debut`
// (écart 0 : « parfait », +7 de dégâts), jamais « raté » (+70). Avant le correctif, l'entrée de
// l'étage 1 était notée contre le temps de l'étage 0 (230 frames écoulées : « raté », +70).
//
// À regarder : traversée du portail à f230 ; les dégâts passent à 8 (étage 0) puis 15 (étage 1).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    floors: Some("deux_niveaux"),
    clocks: Some(["debut_etage"]),
    frames: 400,
    players: [
        (items: ["reveil"], inputs: [
            (from: 0, to: 200, buttons: [Fire], pan: (-64, 48)),
            (from: 220, to: 226, buttons: [Right, Down], pan: (0, 0)),
        ]),
    ],
    expect: [
        Event(kind: "portal", by_frame: 70),
        FloorIndex(index: 0, at_frame: 220),
        // Entrée de l'étage 0 : +7 (1 → 8), pas +70
        Stat(handle: 0, stat: Damage, value: 8.0, at_frame: 220),
        FloorIndex(index: 1, at_frame: 240),
        // Entrée de l'étage 1 : +7 (8 → 15), toujours pas +70
        Stat(handle: 0, stat: Damage, value: 15.0, at_frame: 300),
        Event(kind: "timing", label_contains: Some("parfait"), by_frame: 400),
        PlayerAlive(handle: 0, at_frame: 400),
    ],
)
