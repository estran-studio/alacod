// M3-T14 (docs/conventions.md §79) : l'`explorateur` ouvre la salle secrète d'`isaac` à la bombe, sans input
// scripté. Graine 8 (séquence `sous_sol_un`, la même que `grid_secret_bomb`) : la salle secrète est la case au
// sud du départ, voisine du départ et d'un combat. Le personnage d'`isaac` n'a pas de bombe de départ avant
// M3-T11d : le scénario lui donne la bombe d'essai des campagnes (`PlayerScript::bomb` et `items`, une bombe).
//
// À regarder : le bot descend au mur secret (premier but : aucun ennemi n'est éveillé), pose sa bombe (f19), s'écarte de
// la mèche (60 frames : sa vie reste pleine alors que la bombe ferait 4 PV de dégâts, tir ami actif), l'explosion
// (f78) ouvre toutes les portes de la salle secrète, il y entre et ouvre son coffre (f168 : un cœur d'âme).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    map_seed: 8,
    floors: Some("sous_sol_un"),
    frames: 600,
    explorer: Some((
        shopping: true,
        shop: HeartsThenCheapest(low_health: "0.5"),
        shells: Some(400),
        devil: Never,
        bombs: (secret: true, secret_min_neighbours: 2, rocks: true, reserve: 0),
        anti_jitter: true,
    )),
    players: [
        (
            bot: explorateur,
            bomb: (fuse_frames: 60, radius: "56.0", damage: "4.0", friendly_fire: Always),
            items: ["bomb"],
        ),
    ],
    expect: [
        RoomLayout(kind: "secrete", touches: ["depart", "combat"], at_frame: 5),
        DoorLocked(kind: "secrete", locked: true, at_frame: 5),
        Consumable(handle: 0, id: "bomb", count: 1, at_frame: 10),
        Consumable(handle: 0, id: "bomb", count: 0, at_frame: 30),
        DoorLocked(kind: "secrete", locked: true, at_frame: 70),
        Event(kind: "explosion", by_frame: 85),
        DoorLocked(kind: "secrete", locked: false, at_frame: 90),
        Health(handle: 0, min: 6.0, max: 6.0, at_frame: 100),
        ExtraHealth(handle: 0, n: 2.0, at_frame: 180),
        PlayerAlive(handle: 0, at_frame: 599),
    ],
)
