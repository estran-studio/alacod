// M3-T14 (docs/conventions.md §79), recalé par M3-T11d1 (§76.4) : l'`explorateur` ouvre la salle secrète d'`isaac` à la bombe, sans input
// scripté et **avec la bombe de départ réelle de `pleureur`** (D81 : `starting_consumables`, `bomb` : mèche 75 frames, rayon 56, 4 PV ; le
// kit d'essai `PlayerScript::bomb` et `items` de T14 n'existe plus ici). Graine 39 (séquence `sous_sol_un`, la même que `grid_secret_bomb`,
// plan des vingt gabarits) : la salle secrète est la case au sud du départ, voisine du départ et d'un combat.
//
// À regarder : le bot descend au mur secret (premier but : aucun ennemi n'est éveillé), pose sa bombe (f51), s'écarte de la mèche (75 frames :
// sa vie reste pleine alors que la bombe ferait 4 PV de dégâts, tir ami actif), l'explosion (f125) ouvre toutes les portes de la salle secrète
// (f126), puis il nettoie les trois salles de combat et ouvre le coffre secret (f2991 : un pool de consommables, `secrete` ; avant les gabarits ×2 : bombe f19, explosion f93, coffre f1412 ; le bot passe aussi à la boutique, f1173 à f1217).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    map_seed: 39,
    floors: Some("sous_sol_un"),
    frames: 3300,
    explorer: Some((
        shopping: true,
        shop: HeartsThenCheapest(low_health: "0.5"),
        detour: (shells: Some(400)),
        devil: Never,
        bombs: (secret: true, secret_min_neighbours: 2, rocks: true, reserve: 0),
        oscillation: Hysteresis,
        combat_aware: true,
    )),
    players: [(bot: explorateur)],
    expect: [
        RoomLayout(kind: "secrete", touches: ["depart", "combat"], at_frame: 5),
        DoorLocked(kind: "secrete", locked: true, at_frame: 5),
        Consumable(handle: 0, id: "bomb", count: 1, at_frame: 10),
        Consumable(handle: 0, id: "bomb", count: 0, at_frame: 60),
        DoorLocked(kind: "secrete", locked: true, at_frame: 110),
        Event(kind: "explosion", by_frame: 130),
        DoorLocked(kind: "secrete", locked: false, at_frame: 135),
        Health(handle: 0, min: 6.0, max: 6.0, at_frame: 140),
        EventAfter(kind: "chest", after_frame: 126, by_frame: 3100),
        PlayerAlive(handle: 0, at_frame: 3299),
    ],
)
