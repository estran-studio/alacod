// T1.4 (testbed, conventions §22) : `coward` = [Flee, Melee("zombie_claws"), Chase],
// `flee_threshold` 0.5, 40 PV, à 79 unités du joueur 0 (carte `testbed/arena_ia_flee.ldtk`,
// ennemi NetId 27). Le joueur tire vers lui de f10 à f30 (`machine_gun`) : sous la moitié de
// sa santé, `Flee` (dès ~f35) l'emporte sur la griffe et la poursuite, il recule par le champ de
// flux inversé — la distance croît (49 → ~200).
//
// À regarder : l'ennemi avance, prend des balles, puis s'enfuit à l'autre bout de la salle.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/arena_ia_flee.ldtk",
    frames: 220,
    players: [
        (inputs: [(from: 10, to: 30, buttons: [Fire], pan: (127, 0))]),
    ],
    expect: [
        EnemyState(entity: NetId(27), behavior: "Chase", at_frame: 20),
        EnemyState(entity: NetId(27), behavior: "Flee", at_frame: 61),
        EnemyDistance(entity: NetId(27), target: Player(0), min: 65.0, max: 82.0, at_frame: 61),
        EnemyState(entity: NetId(27), behavior: "Flee", at_frame: 151),
        EnemyDistance(entity: NetId(27), target: Player(0), min: 140.0, max: 175.0, at_frame: 151),
        EnemyNeverInWall(entity: NetId(27), from: 1, to: 220),
    ],
)
