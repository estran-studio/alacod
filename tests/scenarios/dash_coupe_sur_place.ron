// P-1 (docs/conventions.md §110) : dash sur place sans direction (`in_place_without_direction`) et
// coupe d'un dash par le suivant (`cut_from: 15`). Dash de 24 frames, 48 px, profil linéaire du
// testbed, sans temps de recharge. Les inputs agissent 5 frames plus tard (délai d'input de GGRS).
//
// À regarder : appui effectif f40 sans direction : le joueur reste sur place (424) pendant tout le
// pas. Appui effectif f50 à droite (droite tenue jusqu'à f65), au milieu du pas sur place (10 frames
// jouées) : gardé, il part dès la 15e frame jouée, pas à la fin du pas : premier pas visible à f56
// (sans coupe : f65) ; à f63, 8 pas de 2 px (440) ; à f79, le dash entier (472) ; puis 1,5 px de
// glissade de sortie (décélération du personnage du testbed) : 473,5 à f90.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/arena.ldtk",
    frames: 100,
    players: [
        (
            dash: Some((
                distance: Some("48.0"),
                duration_frames: Some(24),
                iframes: Some(12),
                cooldown_frames: Some(0),
                in_place_without_direction: true,
                cut_from: Some(15),
                chain_window_frames: Some(21),
            )),
            inputs: [
                (from: 35, to: 36, buttons: [Dash]),
                (from: 45, to: 46, buttons: [Right, Dash]),
                (from: 46, to: 60, buttons: [Right]),
            ],
        ),
    ],
    expect: [
        PlayerPosition(handle: 0, x: 424, y: 696, tolerance: 0.1, at_frame: 55),
        // Coupé : déjà en route à f63 (sans coupe, il serait encore à 424 jusqu'à f64)
        PlayerPosition(handle: 0, x: 440, y: 696, tolerance: 0.1, at_frame: 63),
        PlayerPosition(handle: 0, x: 472, y: 696, tolerance: 0.1, at_frame: 79),
        PlayerPosition(handle: 0, x: 473.5, y: 696, tolerance: 0.1, at_frame: 90),
    ],
)
