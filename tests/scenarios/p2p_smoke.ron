// Quatre joueurs dont les inputs changent sans arrêt, à des phases décalées : la source
// d'inputs du smoke p2p de la nuit (`scripts/nightly.sh`, `ALACOD_INPUT=script:` sur chaque
// client). En ligne, chaque changement d'input d'un pair est une prédiction ratée pour les
// autres : la partie rollbacke et resimule en continu, ce qu'un run à inputs neutres ne fait
// jamais. Joué aussi en synctest par la suite, comme tout scénario.
//
// À regarder : les quatre joueurs tournent en carré dans la salle (sens et vitesse différents),
// tirent par salves dans des directions qui changent, dashent et rechargent ; tous vivants à la
// frame 300.
Scenario(
    // Isoler ce scénario des drops aléatoires ; powerup_drop_on_kill teste ce chemin.
    powerup_drop_chance_override: "0.0",
    game: "zombies",
    frames: 600,
    players: [
        // Joueur 0 : carré en 40 frames par côté, tir vers le haut puis la droite.
        (inputs: [
            (from: 0, to: 40, buttons: [Right, Fire], pan: (0, 100)),
            (from: 40, to: 80, buttons: [Down], pan: (100, 0)),
            (from: 80, to: 120, buttons: [Left, Fire], pan: (100, 0)),
            (from: 120, to: 160, buttons: [Up, Dash], pan: (0, 100)),
            (from: 160, to: 200, buttons: [Right, Fire], pan: (0, 100)),
            (from: 200, to: 240, buttons: [Down, Reload], pan: (100, 0)),
            (from: 240, to: 280, buttons: [Left, Fire], pan: (100, 0)),
            (from: 280, to: 320, buttons: [Up], pan: (0, 100)),
            (from: 320, to: 360, buttons: [Right, Fire], pan: (0, 100)),
            (from: 360, to: 400, buttons: [Down, Dash], pan: (100, 0)),
            (from: 400, to: 440, buttons: [Left, Fire], pan: (100, 0)),
            (from: 440, to: 480, buttons: [Up], pan: (0, 100)),
            (from: 480, to: 520, buttons: [Right, Fire], pan: (0, 100)),
            (from: 520, to: 560, buttons: [Down, Reload], pan: (100, 0)),
            (from: 560, to: 600, buttons: [Left, Fire], pan: (100, 0)),
        ]),
        // Joueur 1 : sens inverse, 30 frames par côté, décalé de 15 frames.
        (inputs: [
            (from: 15, to: 45, buttons: [Left, Fire], pan: (-100, 0)),
            (from: 45, to: 75, buttons: [Down, Sprint], pan: (0, -100)),
            (from: 75, to: 105, buttons: [Right, Fire], pan: (100, 0)),
            (from: 105, to: 135, buttons: [Up, Dash], pan: (0, 100)),
            (from: 135, to: 165, buttons: [Left, Fire], pan: (-100, 0)),
            (from: 165, to: 195, buttons: [Down, Sprint], pan: (0, -100)),
            (from: 195, to: 225, buttons: [Right, Fire], pan: (100, 0)),
            (from: 225, to: 255, buttons: [Up, Reload], pan: (0, 100)),
            (from: 255, to: 285, buttons: [Left, Fire], pan: (-100, 0)),
            (from: 285, to: 315, buttons: [Down, Sprint], pan: (0, -100)),
            (from: 315, to: 345, buttons: [Right, Fire], pan: (100, 0)),
            (from: 345, to: 375, buttons: [Up, Dash], pan: (0, 100)),
            (from: 375, to: 405, buttons: [Left, Fire], pan: (-100, 0)),
            (from: 405, to: 435, buttons: [Down, Sprint], pan: (0, -100)),
            (from: 435, to: 465, buttons: [Right, Fire], pan: (100, 0)),
            (from: 465, to: 495, buttons: [Up, Reload], pan: (0, 100)),
            (from: 495, to: 525, buttons: [Left, Fire], pan: (-100, 0)),
            (from: 525, to: 555, buttons: [Down, Sprint], pan: (0, -100)),
            (from: 555, to: 585, buttons: [Right, Fire], pan: (100, 0)),
            (from: 585, to: 600, buttons: [Up], pan: (0, 100)),
        ]),
        // Joueur 2 : salves courtes de tir (20 frames) entre des pas, décalé de 7 frames.
        (inputs: [
            (from: 7, to: 27, buttons: [Fire], pan: (0, -100)),
            (from: 27, to: 52, buttons: [Up], pan: (0, 100)),
            (from: 52, to: 72, buttons: [Fire], pan: (100, -100)),
            (from: 72, to: 97, buttons: [Right], pan: (100, 0)),
            (from: 97, to: 117, buttons: [Fire], pan: (-100, -100)),
            (from: 117, to: 142, buttons: [Down, Dash], pan: (0, -100)),
            (from: 142, to: 162, buttons: [Fire], pan: (-100, 100)),
            (from: 162, to: 187, buttons: [Left], pan: (-100, 0)),
            (from: 187, to: 207, buttons: [Fire, Reload], pan: (0, -100)),
            (from: 207, to: 232, buttons: [Up], pan: (0, 100)),
            (from: 232, to: 252, buttons: [Fire], pan: (100, -100)),
            (from: 252, to: 277, buttons: [Right], pan: (100, 0)),
            (from: 277, to: 297, buttons: [Fire], pan: (-100, -100)),
            (from: 297, to: 322, buttons: [Down, Dash], pan: (0, -100)),
            (from: 322, to: 342, buttons: [Fire], pan: (-100, 100)),
            (from: 342, to: 367, buttons: [Left], pan: (-100, 0)),
            (from: 367, to: 387, buttons: [Fire, Reload], pan: (0, -100)),
            (from: 387, to: 412, buttons: [Up], pan: (0, 100)),
            (from: 412, to: 432, buttons: [Fire], pan: (100, -100)),
            (from: 432, to: 457, buttons: [Right], pan: (100, 0)),
            (from: 457, to: 477, buttons: [Fire], pan: (-100, -100)),
            (from: 477, to: 502, buttons: [Down, Dash], pan: (0, -100)),
            (from: 502, to: 522, buttons: [Fire], pan: (-100, 100)),
            (from: 522, to: 547, buttons: [Left], pan: (-100, 0)),
            (from: 547, to: 567, buttons: [Fire, Reload], pan: (0, -100)),
            (from: 567, to: 600, buttons: [Up], pan: (0, 100)),
        ]),
        // Joueur 3 : mêlée et déplacements courts (25 frames), décalé de 3 frames.
        (inputs: [
            (from: 3, to: 28, buttons: [Up, Melee], pan: (0, 100)),
            (from: 28, to: 53, buttons: [Left, Fire], pan: (-100, 0)),
            (from: 53, to: 78, buttons: [Down, Melee], pan: (0, -100)),
            (from: 78, to: 103, buttons: [Right, Fire], pan: (100, 0)),
            (from: 103, to: 128, buttons: [Up, Sprint], pan: (0, 100)),
            (from: 128, to: 153, buttons: [Left, Fire], pan: (-100, 0)),
            (from: 153, to: 178, buttons: [Down, Dash], pan: (0, -100)),
            (from: 178, to: 203, buttons: [Right, Fire], pan: (100, 0)),
            (from: 203, to: 228, buttons: [Up, Melee], pan: (0, 100)),
            (from: 228, to: 253, buttons: [Left, Fire], pan: (-100, 0)),
            (from: 253, to: 278, buttons: [Down, Reload], pan: (0, -100)),
            (from: 278, to: 303, buttons: [Right, Fire], pan: (100, 0)),
            (from: 303, to: 328, buttons: [Up, Sprint], pan: (0, 100)),
            (from: 328, to: 353, buttons: [Left, Fire], pan: (-100, 0)),
            (from: 353, to: 378, buttons: [Down, Dash], pan: (0, -100)),
            (from: 378, to: 403, buttons: [Right, Fire], pan: (100, 0)),
            (from: 403, to: 428, buttons: [Up, Melee], pan: (0, 100)),
            (from: 428, to: 453, buttons: [Left, Fire], pan: (-100, 0)),
            (from: 453, to: 478, buttons: [Down, Reload], pan: (0, -100)),
            (from: 478, to: 503, buttons: [Right, Fire], pan: (100, 0)),
            (from: 503, to: 528, buttons: [Up, Sprint], pan: (0, 100)),
            (from: 528, to: 553, buttons: [Left, Fire], pan: (-100, 0)),
            (from: 553, to: 578, buttons: [Down, Dash], pan: (0, -100)),
            (from: 578, to: 600, buttons: [Right, Fire], pan: (100, 0)),
        ]),
    ],
    expect: [
        PlayerAlive(handle: 0, at_frame: 300),
        PlayerAlive(handle: 1, at_frame: 300),
        PlayerAlive(handle: 2, at_frame: 300),
        PlayerAlive(handle: 3, at_frame: 300),
    ],
)
