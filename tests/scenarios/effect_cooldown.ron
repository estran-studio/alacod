// M2-T3 (effets v2, docs/conventions.md §42) : cooldown d'un effet. Les `semelles_lentes`
// (+1 de dégâts au dash, au plus une fois par 200 frames) sont posées à f5.
//
// À regarder : dash à f30 (+1 : dégâts 2), dash à f120 refusé (cooldown : toujours 2), dash à
// f300 (+1 : dégâts 3).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/salles.ldtk",
    map_seed: 1,
    frames: 360,
    items: [(id: "semelles_lentes", x: "-904.0", y: "-584.0", at_frame: 5)],
    players: [
        (inputs: [
            (from: 10, to: 13, buttons: [Interaction]),
            (from: 30, to: 33, buttons: [Right, Dash]),
            (from: 120, to: 123, buttons: [Right, Dash]),
            (from: 300, to: 303, buttons: [Right, Dash]),
        ]),
    ],
    expect: [
        Stat(handle: 0, stat: Damage, value: 2.0, at_frame: 80),
        Stat(handle: 0, stat: Damage, value: 2.0, at_frame: 250),
        Stat(handle: 0, stat: Damage, value: 3.0, at_frame: 350),
    ],
)
