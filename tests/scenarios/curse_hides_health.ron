// M3-T9 (docs/conventions.md §74) : la curse « Unknown » cache la santé. `isaac`, séquence
// `sous_sol_maudit`, graine 7 : « unknown ». Le joueur reste immobile dans la salle de départ : la source
// `health` du HUD est **vide** (ni texte ni barre, pas même un préfixe) alors que le joueur est vivant,
// la minicarte reste affichée. Témoin inverse : `curse_blind` (santé « 6/6 »).
//
// À regarder : la barre et le texte de vie en bas à gauche sont absents, la minicarte est là.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "isaac",
    floors: Some("sous_sol_maudit"),
    map_seed: 7,
    frames: 60,
    players: [(inputs: [])],
    expect: [
        Curse(floor: 0, id: Some("unknown"), at_frame: 30),
        HudText(source: "curses", contains: "unknown", at_frame: 30),
        PlayerAlive(handle: 0, at_frame: 30),
        HudText(source: "health", empty: true, at_frame: 30),
        HudText(source: "minimap", contains: "depart · visitée · actuelle", at_frame: 30),
    ],
)
