// X-6d (testbed, conventions §126) : le joueur 0 (pantin) ne fait rien ; l'`agrippeur` accroché se décroche de lui-même au bout de
// `hold` (180 frames), retombe étourdi 90 frames, attend 60 frames, puis rebondit sur le joueur tout proche.
//
// À regarder : accroché, deux morsures d'un point, il tombe assis et sonné, se relève et resaute sur le joueur.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    map: "testbed/arena.ldtk",
    frames: 420,
    characters: [(character: "agrippeur", x: "540.0", y: "696.0", at_frame: 1)],
    players: [(character: "pantin", inputs: [])],
    expect: [
        GrabState(entity: Placed(0), phase: Ride, carrier: Some(0), at_frame: 240),
        Health(handle: 0, min: 98.0, max: 98.0, at_frame: 240),
        GrabState(entity: Placed(0), phase: Dazed, at_frame: 250),
        Clip(who: Entity(Placed(0)), clip: "stunned", once: Some(false), at_frame: 300),
        GrabState(entity: Placed(0), phase: Dazed, at_frame: 330),
        GrabState(entity: Placed(0), phase: Idle, at_frame: 340),
        GrabState(entity: Placed(0), phase: Ride, carrier: Some(0), at_frame: 415),
        Stat(handle: 0, stat: MoveSpeed, value: 62.0, at_frame: 300),
    ],
)
