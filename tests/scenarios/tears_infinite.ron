// M4-T0a (docs/conventions.md §60) : munitions infinies. Le joueur 0 n'a que `larme` (tir
// automatique, `mag: Infinite`, 3 tirs par seconde) et tient la gâchette 300 frames en visant
// `target` : il tire sans jamais recharger, le chargeur reste à 0 (aucune munition consommée) et les
// coups continuent d'arriver jusqu'au bout.
//
// À regarder : un flot régulier de balles de f10 à f300, aucune pause de rechargement ; les coups
// sur la cible montent sans palier.
Scenario(
    game: "testbed",
    map: "testbed/arena.ldtk",
    frames: 310,
    powerup_drop_chance_override: "0",
    players: [
        (
            inputs: [(from: 10, to: 310, buttons: [Fire], pan: (128, 48))],
            weapon: "larme",
        ),
    ],
    expect: [
        ActiveWeapon(handle: 0, weapon: "larme", at_frame: 5),
        Ammo(handle: 0, ammo: 0, at_frame: 5),
        Ammo(handle: 0, ammo: 0, at_frame: 100),
        Ammo(handle: 0, ammo: 0, at_frame: 200),
        Ammo(handle: 0, ammo: 0, at_frame: 309),
        HitsAtLeast(entity: Target, hits: 1, at_frame: 100),
        HitsAtLeast(entity: Target, hits: 2, at_frame: 309),
    ],
)
