// Suivi Q12 (docs/conventions.md §19) : `Charm`. Le joueur 0 (carte `surfaces`, en (-568, 248), arme `status_charm`) tire
// plein est sur un `breacher` (net id 14, placé en (-448, 248)) qui marche vers lui ; deux `target` (immobiles, 5 000 PV) sont
// posées à l'est du `breacher`, sur sa ligne (derrière lui pour le tireur) : la plus proche (net id 16, à 60 unités) et la plus lointaine (net id 17, à 120). Touché, le
// `breacher` est charmé 200 frames : il rejoint la `target` la plus proche et la frappe (5 par coup, un coup toutes les 40 frames environ), sans
// toucher le joueur, qu'il avait pourtant presque atteint ; le charme expiré, il redevient hostile : il laisse la `target`,
// marche vers le joueur et le frappe. Témoin `status_charm_temoin` : sans tir, le `breacher` va droit sur le joueur et
// aucune `target` n'est jamais touchée.
//
// À regarder : le `breacher` teinté de rose fait demi-tour vers les cibles, les frappe, puis se retourne contre le joueur.
Scenario(
    game: "testbed",
    map: "testbed/surfaces.ldtk",
    frames: 480,
    powerup_drop_chance_override: "0",
    characters: [
        (character: "breacher", x: "-448.0", y: "248.0", at_frame: 1),
        (character: "target", x: "-388.0", y: "248.0", at_frame: 1),
        (character: "target", x: "-328.0", y: "248.0", at_frame: 1),
    ],
    players: [
        (
            inputs: [(from: 20, to: 21, buttons: [Fire], pan: (127, 0))],
            weapon: "status_charm",
        ),
    ],
    expect: [
        // La balle (f20, partie f25) touche le `breacher` à f39 : charmé jusqu'à f239 (`statuses/charme.ron`, 200 frames).
        HasStatus(entity: NetId(14), status: "charme", present: false, at_frame: 38),
        HasStatus(entity: NetId(14), status: "charme", at_frame: 40),
        HasStatus(entity: NetId(14), status: "charme", at_frame: 238),
        HasStatus(entity: NetId(14), status: "charme", present: false, at_frame: 240),
        // Il vise la `target` la plus proche (net id 16, 60 unités à l'est), pas la lointaine (17, 120) : à portée de corps à
        // corps (30) dès f150, il la frappe (5 par coup : 4 990 à f140, puis un coup toutes les 40 frames environ).
        EntityHealth(net_id: 16, min: Some(5000.0), max: Some(5000.0), at_frame: 100),
        EntityHealth(net_id: 16, min: Some(4990.0), max: Some(4990.0), at_frame: 140),
        EnemyDistance(entity: NetId(14), target: Entity(NetId(16)), max: Some(31.0), at_frame: 150),
        EnemyDistance(entity: NetId(14), target: Player(0), min: Some(100.0), at_frame: 150),
        EntityHealth(net_id: 16, min: Some(4980.0), max: Some(4980.0), at_frame: 220),
        // Le joueur, qu'il avait presque atteint, n'est jamais touché tant que dure le charme (et après : 100 à f320).
        NoDamageBetween(handle: 0, from_frame: 0, to_frame: 239),
        Health(handle: 0, min: Some(100.0), max: Some(100.0), at_frame: 320),
        // Le charme expiré, il redevient hostile : plus un coup sur la `target` (4 975 de f260 à la fin), il rejoint le joueur
        // et le frappe.
        EntityHealth(net_id: 16, min: Some(4975.0), max: Some(4975.0), at_frame: 260),
        EntityHealth(net_id: 16, min: Some(4975.0), max: Some(4975.0), at_frame: 479),
        EntityHealth(net_id: 17, min: Some(5000.0), max: Some(5000.0), at_frame: 479),
        EnemyDistance(entity: NetId(14), target: Player(0), max: Some(40.0), at_frame: 479),
        Health(handle: 0, min: Some(72.5), max: Some(72.5), at_frame: 479),
    ],
)
