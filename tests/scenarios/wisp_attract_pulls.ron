// M-5 (docs/conventions.md § 113) : un feu follet qui **attire** (`lure: Attract(range: "400.0")`) est une cible comme un joueur
// debout. Même partie que `wisp_plain_ignored` : le suiveur, plus près du feu follet (190 unités) que du joueur 0 (294), va vers le
// feu follet.
//
// À regarder : le suiveur rejoint la lumière du joueur 1 au lieu du joueur 0.
Scenario(
    game: "testbed",
    map: "testbed/arene_vide.ldtk",
    frames: 520,
    powerup_drop_chance_override: "0",
    weapon_overrides: [(weapon: "machine_gun", friendly_fire: Always)],
    characters: [(character: "follower", x: "560.0", y: "520.0", at_frame: 120)],
    players: [
        (
            character: "wisp_plain",
            inputs: [
                (from: 10, to: 110, buttons: [Fire], pan: (100, 0)),
                (from: 110, to: 150, buttons: [Left]),
            ],
        ),
        (character: "wisp_attract"),
    ],
    expect: [
        PlayerDowned(handle: 1, at_frame: 130),
        EnemyDistance(entity: Placed(0), target: Player(1), max: Some(50.0), at_frame: 450),
        EnemyDistance(entity: Placed(0), target: Player(0), min: Some(120.0), at_frame: 450),
    ],
)
