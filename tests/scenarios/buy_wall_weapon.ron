// Le joueur (solde 600, équipé seulement d'un pistolet) marche jusqu'à l'arme murale de la
// salle de départ (WeaponLocation "shotgun", 500, games/zombies/assets/exemples/
// test_map_shop.ldtk) et l'achète.
//
// À regarder : le joueur monte puis se déplace à gauche vers le mur d'armes (f10-115),
// achète le fusil à pompe en interagissant (f115-130) : le fusil devient son arme active, son
// solde tombe à 100.
Scenario(
    game: "zombies",
    map: "exemples/test_map_shop.ldtk",
    frames: 160,
    players: [
        (
            inputs: [
                (from: 10, to: 65, buttons: [Up]),
                (from: 65, to: 115, buttons: [Left]),
                (from: 115, to: 130, buttons: [Interaction]),
            ],
            // Exclusivité T2.10 (voir PlayerScript::weapon) : le joueur n'a PAS déjà le
            // fusil à pompe, sinon l'achat testerait le rachat de munitions plutôt que le
            // premier achat.
            weapon: "pistol",
            currency: 600,
        ),
    ],
    expect: [
        // L'arme murale équipe le joueur une fois achetée.
        ActiveWeapon(handle: 0, weapon: "shotgun", at_frame: 140),
        // 600 - 500 (prix de la WeaponLocation) = 100.
        Currency(handle: 0, min: 100, max: 100, at_frame: 140),
    ],
)
