// D95/D96 (2026-10-17, dette-d95-d96-tirage-butin) : `loot_seed` / `curse_seed` reçoivent `fmix32` et le butin se tire par
// Preuve d'achat : `HasItem(gilet/roulade)` achetés (boutique) est remplacé par `Consumable(blank)` du joueur acheteur (0 avant l'achat,
// 1 après : le blank vendu atteint l'inventaire), la boutique vendant maintenant un blank et une arme.
// course pondérée (graine de carte 10 inchangée : carte et salles identiques, objets autres). Victoire f6091 (avant :
// f6455). Attentes re-mesurées, aucune retirée ; écarts de sens : la clé est ramassée par le **joueur 2** (f2154, plus
// le joueur 1 à f148) et c'est lui qui ouvre le coffre à clé (`double_canon`, f2716) ; l'arène du premier étage vient
// avant l'escouade ; chaque boss tombe peu après sa phase 1 (phase 1 → 2 jamais observée ; mesure de PV : `gungeon_full_run`) :
// `BossPhase` lue en phase 1 et l'événement « phase 1 → 2 » devient « phase 0 → 1 » ; coffre du second étage de
// `joueur 2` à f3554 (rancune), achat de la boutique du second étage f4734.
// m2-full-run (docs/conventions.md §57, « Run complète de M2 ») : la même run que `gungeon_full_run`
// (graine 10, `etages_deux`, hub puis run, profil à trois déblocages, `shopping`) à QUATRE joueurs,
// quatre bots `explorateur`, en synctest. Le gabarit `Depart` n'a que deux `PlayerSpawn` : les joueurs 2
// et 3 prennent ceux de 0 et 1, décalés de 24 unités vers le bas (`map_ldtk::game::local`). Les
// quatre traversent les deux étages et gagnent.
//
// Comme `gungeon_full_run` : ni salle secrète (D81, pas de bombe) ni porte de hub conditionnée par le profil.
//
// À regarder : hub f175 la porte ; run f1 « entrée en run depuis le hub » ; f70-84 les quatre joueurs
// lâchent un blank devant la première salle ; f1203-1953 l'ARÈNE tenue ; f2154 le joueur 2 ramasse une clé ;
// f2202-2279 l'escouade ; f2587-2648 achats en boutique (joueur 3) ; f2716 le joueur 2 ouvre le coffre à clé (sa
// clé est consommée, un `double_canon` tombe) ; f3164 le boss se verrouille, f3208 phase 1 (il tombe à f3209 :
// plus de phase 2), f3210 PORTAIL, f3403 SECOND ÉTAGE ; f3554 un coffre (rancune) ; f3617-4367 la seconde
// arène ; f6047 le second boss, phase 1 f6054, f6091 VICTOIRE des quatre joueurs.
//
// D88 (2026-10-17, dette-d88-tirage-variantes) : le tirage des variantes (champions) a changé pour tous les
// jeux : mêmes attentes, frames re-chronométrées (la run gagne f6455, avant f6876) ;
// les coffres du second étage sont ouverts par d'autres joueurs
// qu'avant). `BossPhase` phase 2 est lue avant le nettoyage de la salle (le boss disparaît à sa mort).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "gungeon",
    map: "maps/etage_1.ldtk",
    floors: Some("etages_deux"),
    map_seed: 10,
    frames: 7000,
    shopping: true,
    profile: true,
    profile_setup: Some((
        profiles: [(handle: 0, unlocks: ["first_run"], essence: 120, stats: {"runs": 1})],
        purchases: [
            (handle: 0, unlock: "tresor_trefle"),
            (handle: 0, unlock: "coffre_riche"),
            (handle: 0, unlock: "etendard_royal"),
        ],
    )),
    hub: Some((stay: false, inputs: [
        [
            // Le marchand (f80, interaction), puis la porte (f170).
            (from: 10, to: 42, buttons: [Right]),
            (from: 42, to: 74, buttons: [Up]),
            (from: 80, to: 82, buttons: [Interaction]),
            (from: 100, to: 138, buttons: [Right]),
            (from: 138, to: 157, buttons: [Down]),
            (from: 170, to: 172, buttons: [Interaction]),
        ],
        [],
        [],
        [],
    ])),
    players: [
        (bot: explorateur),
        (bot: explorateur),
        (bot: explorateur),
        (bot: explorateur),
    ],
    expect: [
        // Escouade (salle verrouillée f2136-f2225) : des membres de `bullet_kins` vivent pendant le verrou, plus aucun après.
        SquadSize(squad: "bullet_kins", min: 2, at_frame: 2210),
        SquadSize(squad: "bullet_kins", max: 0, at_frame: 2300),
        // Hub, entrée en run, déblocages.
        HubVisit(handle: 0, service: "marchand", at_frame: 120),
        HubExit(handle: Some(0), exit_frame: Some(175), at_frame: 177),
        Event(kind: "hub", label_contains: "entrée en run depuis le hub", by_frame: 1),
        Event(kind: "unlock", label_contains: "tresor_trefle", by_frame: 1),
        RunUnlocks(has: ["tresor_trefle", "coffre_riche", "etendard_royal"], at_frame: 5),
        // Quatre joueurs en vie dès la première frame de la run, quatre blanks.
        PlayerAlive(handle: 3, at_frame: 5),
        Event(kind: "blank", label_contains: "joueur 3", by_frame: 72),
        Event(kind: "item_pickup", label_contains: "key", by_frame: 2155),
        Consumable(handle: 2, id: "key", count: 1, at_frame: 2200),
        // Arène tenue, boutique, coffre à clé (la clé du joueur 1 est consommée).
        Event(kind: "arena", label_contains: "tenue (750 frames)", by_frame: 1954),
        Event(kind: "purchase", label_contains: "(shop)", by_frame: 2588),
        Consumable(handle: 3, id: "blank", count: 0, at_frame: 2585),
        Consumable(handle: 3, id: "blank", count: 1, at_frame: 2600),
        Consumable(handle: 2, id: "key", count: 1, at_frame: 2710),
        Event(kind: "chest", label_contains: "joueur 2 ouvre", by_frame: 2717),
        Consumable(handle: 2, id: "key", count: 0, at_frame: 2730),
        // Boss du premier étage (trois phases), portail, second étage.
        Event(kind: "boss_phase", label_contains: "phase 0 → 1", by_frame: 3209),
        BossPhase(entity: NetId(211), phase: 1, at_frame: 3209),
        Event(kind: "portal", by_frame: 3211),
        FloorIndex(index: 0, at_frame: 3300),
        FloorIndex(index: 1, at_frame: 3500),
        // Second étage (événements postérieurs à l'arrivée f3424) : coffre, boutique, arène, boss.
        EventAfter(kind: "chest", label_contains: "joueur 2 ouvre", after_frame: 3450, by_frame: 3555),
        EventAfter(kind: "purchase", label_contains: "(shop)", after_frame: 3450, by_frame: 4735),
        EventAfter(kind: "arena", label_contains: "tenue (750 frames)", after_frame: 3450, by_frame: 4368),
        EventAfter(kind: "boss_phase", label_contains: "phase 0 → 1", after_frame: 3450, by_frame: 6055),
        RoomState(kind: "arene", nth: 0, state: Cleared, at_frame: 4380),
        BossPhase(entity: NetId(788), phase: 1, at_frame: 6060),
        RunState(step: Ended(Victory), at_frame: 6950),
        PlayerAlive(handle: 0, at_frame: 6999),
        PlayerAlive(handle: 1, at_frame: 6999),
        PlayerAlive(handle: 2, at_frame: 6999),
        PlayerAlive(handle: 3, at_frame: 6999),
    ],
)
