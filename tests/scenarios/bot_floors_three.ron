// T1.14 : deux bots `prudent` v1 finissent la séquence `trois_niveaux` du testbed (`floor_a`,
// `floor_d`, `floor_c`) en mode `Floors` : ils tuent les ennemis de chaque niveau (tir, gestion
// d'arme, esquive), puis marchent vers le portail ouvert.
//
// À regarder : passages de portail à f56, f484 et f892 (m1-v3-bots-softlocks : ni recul ni tir
// vers un ennemi caché ; avant, m1-v3-bots-portail : f56, f484, f765) ; les deux bots restent en
// vie.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    floors: Some("trois_niveaux"),
    map_seed: 123456,
    frames: 920,
    players: [
        (bot: prudent),
        (bot: prudent),
    ],
    expect: [
        FloorIndex(index: 0, at_frame: 50),
        FloorIndex(index: 1, at_frame: 60),
        FloorIndex(index: 1, at_frame: 480),
        FloorIndex(index: 2, at_frame: 490),
        FloorIndex(index: 2, at_frame: 885),
        FloorIndex(index: 3, at_frame: 895),
        PlayerAlive(handle: 0, at_frame: 919),
        PlayerAlive(handle: 1, at_frame: 919),
    ],
)
