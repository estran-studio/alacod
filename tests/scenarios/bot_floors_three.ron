// T1.14 : deux bots `prudent` v1 finissent la séquence `trois_niveaux` du testbed (`floor_a`,
// `floor_d`, `floor_c`) en mode `Floors` : ils tuent les ennemis de chaque niveau (tir, gestion
// d'arme, esquive), puis marchent vers le portail ouvert.
//
// À regarder : passages de portail à f135, f388 et f796 (approche freinée du portail) ; les deux
// bots restent en vie (5 points de dégâts encaissés en tout).
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    floors: Some("trois_niveaux"),
    map_seed: 123456,
    frames: 820,
    players: [
        (bot: prudent),
        (bot: prudent),
    ],
    expect: [
        FloorIndex(index: 0, at_frame: 130),
        FloorIndex(index: 1, at_frame: 140),
        FloorIndex(index: 2, at_frame: 400),
        FloorIndex(index: 3, at_frame: 819),
        PlayerAlive(handle: 0, at_frame: 819),
        PlayerAlive(handle: 1, at_frame: 819),
    ],
)
