// T1.14 : deux bots `prudent` v1 finissent la séquence `trois_niveaux` du testbed (`floor_a`,
// `floor_d`, `floor_c`) en mode `Floors` : ils tuent les ennemis de chaque niveau (tir, gestion
// d'arme, esquive), puis marchent vers le portail ouvert.
//
// À regarder : passages de portail à f56, f484 et f765 (approche du portail pilotée en vitesse,
// m1-v3-bots-portail ; avant : f135, f390, f792 par le champ, f135, f388, f796 en ligne droite) ;
// les deux bots restent en vie.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    floors: Some("trois_niveaux"),
    map_seed: 123456,
    frames: 820,
    players: [
        (bot: prudent),
        (bot: prudent),
    ],
    expect: [
        FloorIndex(index: 0, at_frame: 50),
        FloorIndex(index: 1, at_frame: 60),
        FloorIndex(index: 1, at_frame: 480),
        FloorIndex(index: 2, at_frame: 490),
        FloorIndex(index: 2, at_frame: 760),
        FloorIndex(index: 3, at_frame: 770),
        PlayerAlive(handle: 0, at_frame: 819),
        PlayerAlive(handle: 1, at_frame: 819),
    ],
)
