// T1.14 : deux bots `prudent` v1 finissent la séquence `trois_niveaux` du testbed (`floor_a`,
// `floor_d`, `floor_c`) en mode `Floors` : ils tuent les ennemis de chaque niveau (tir, gestion
// d'arme, esquive), puis marchent vers le portail ouvert.
//
// À regarder : passages de portail à f169, f449 et f729 (m1-fusion-revue-m0-suite : course
// nerveuse de movement-feel, les portails s'ouvrent aux mêmes frames — f48, f261, f543 — mais les
// bots y entrent plus tard ; 660 → 800 frames ; avant, m1-v3-bots-armes : f41, f259, f548 ; D51 :
// f34, f195, f638) ; les deux bots restent en vie.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    floors: Some("trois_niveaux"),
    map_seed: 123456,
    frames: 800,
    players: [
        (bot: prudent),
        (bot: prudent),
    ],
    expect: [
        FloorIndex(index: 0, at_frame: 165),
        FloorIndex(index: 1, at_frame: 175),
        FloorIndex(index: 1, at_frame: 445),
        FloorIndex(index: 2, at_frame: 455),
        FloorIndex(index: 2, at_frame: 725),
        FloorIndex(index: 3, at_frame: 735),
        PlayerAlive(handle: 0, at_frame: 659),
        PlayerAlive(handle: 1, at_frame: 659),
    ],
)
