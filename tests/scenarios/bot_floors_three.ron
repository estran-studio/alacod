// T1.14 : deux bots `prudent` v1 finissent la séquence `trois_niveaux` du testbed (`floor_a`,
// `floor_d`, `floor_c`) en mode `Floors` : ils tuent les ennemis de chaque niveau (tir, gestion
// d'arme, esquive), puis marchent vers le portail ouvert.
//
// À regarder : passages de portail à f81, f234 et f444, un quatrième à f654 (m1-bots-apres-
// movement-feel : portails ouverts à f48, f174, f384, f594, franchis 33 à 60 frames plus tard en
// pressant la direction ; 800 → 660 frames ; m1-fusion-revue-m0-suite, pilotage en vitesse :
// f169, f449, f729 ; m1-v3-bots-armes : f41, f259, f548 ; D51 : f34, f195, f638) ; les deux bots
// restent en vie.
Scenario(
    powerup_drop_chance_override: "0.0",
    game: "testbed",
    floors: Some("trois_niveaux"),
    map_seed: 123456,
    frames: 660,
    players: [
        (bot: prudent),
        (bot: prudent),
    ],
    expect: [
        FloorIndex(index: 0, at_frame: 75),
        FloorIndex(index: 1, at_frame: 90),
        FloorIndex(index: 1, at_frame: 228),
        FloorIndex(index: 2, at_frame: 240),
        FloorIndex(index: 2, at_frame: 438),
        FloorIndex(index: 3, at_frame: 450),
        PlayerAlive(handle: 0, at_frame: 659),
        PlayerAlive(handle: 1, at_frame: 659),
    ],
)
