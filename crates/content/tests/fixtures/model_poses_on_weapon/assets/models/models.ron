            height_m: 1.8,
            poses: (
                idle: Some("idle"),
                hit: Some((still: Some("touche"))),
            ),
            weapons: {
                "absente": (
                    shoulder: Some((still: Some("epauler"))),
                    aim: Some((still: Some("viser"))),
                    shoot: Some((still: Some("tir"))),
                    reload: Some((still: Some("rechargement"))),
                ),
            },
        ),
    },
)
