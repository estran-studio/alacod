// Fixture M3-T1 : `Spectral`, `Split` (enfant de la table) sont exécutés ; `Orbit` seul (sans Homing ni Gravity).
({
    "spectre": (
        config: (
            name: "spectre",
            default_firing_mode: "default",
            ammo_type: Balle,
            firing_modes: {
                "default": (
                    firing_rate: "3.0",
                    projectile: (modifiers: [
                        Spectral,
                        Split(count: 3, spread: "0.6", child: Some("eclat")),
                    ]),
                ),
                "orbite": (
                    firing_rate: "3.0",
                    projectile: (modifiers: [Orbit(radius: "40.0", frames_per_turn: 60), Lifetime(120)]),
                ),
            },
            projectiles: {
                "eclat": (damage: "2.0", speed: "200.0", range: "80.0"),
            },
        ),
    ),
})
