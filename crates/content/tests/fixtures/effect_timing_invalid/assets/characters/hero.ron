(
    movement: (
        max_speed: "100.0",
    ),
    asset_name_ref: "hero",
    scale: "1.0",
    base_health: (
        max: "100.0",
    ),
    starting_skin: "1",
    skins: {
        "1": (layers: {}),
    },
    // Erreurs volontaires : perfect_frames > good_frames, événement d'horloge inconnu.
    effects: [
        (on: OnDodge, if: [Timing(reference: DashStart, perfect_frames: 9, good_frames: 4, grade: Perfect)], do: [Heal("5")]),
        (on: OnReload, if: [Timing(reference: Clock("inconnu"), perfect_frames: 1, good_frames: 4, grade: Miss)], do: [Heal("5")]),
    ],
)
