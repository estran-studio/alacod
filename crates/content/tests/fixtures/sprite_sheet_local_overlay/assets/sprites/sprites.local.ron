// Fixture : surcharge locale. `hero` est remplacé ; `ghost` n'a pas d'entrée publique : il est ajouté
// (l'absence d'entrée est son repli).
({
    "hero": (
        animation: "sprites/hero_animation.ron",
        layers: { "body": "sprites/hero_local_sheet.ron" },
    ),
    "ghost": (
        animation: "sprites/hero_animation.ron",
        layers: { "body": "sprites/hero_local_sheet.ron" },
    ),
})
